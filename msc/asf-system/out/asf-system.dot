digraph asf {
rankdir=LR; newrank=true; compound=true; nodesep=0.25; ranksep=0.9;
node [fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica", fontsize=8, color="#555555"];
label="ASF system model, iteration 1 (councils-46, 2026-11-04) against KERNEL draft 2. Regime shown: founding   ρ = 1.00"; labelloc=t; fontsize=14;
subgraph cluster_outside_in { label="Other stores and the world (influx)"; style=filled; color="#bbbbbb"; fillcolor="#f2f2f2"; fontsize=11;
  anchor_outside_in [shape=point, style=invis];
  "ext_source" [shape=folder, penwidth=1, color="black", label="papers, prior art,\nlogos / vivarium / udon,\ntranscripts, readers"];
}
subgraph cluster_influx { label="Influx"; style=filled; color="#bbbbbb"; fillcolor="#e8f1fb"; fontsize=11;
  anchor_influx [shape=point, style=invis];
  "source" [shape=ellipse, penwidth=2.5, color="black", label="source\n[kernel]"];
  "unit" [shape=ellipse, penwidth=2.5, color="black", label="unit\n[kernel]"];
  "st_bring" [shape=box, style="filled,rounded", fillcolor="white", color="#c0392b", label="source.bring\nslot: anyone\ndrainer: ⚠ none"];
  "st_carve" [shape=box, style="filled,rounded", fillcolor="white", color="#c0392b", label="unit.carve\nslot: anyone\ndrainer: ⚠ none"];
  "st_cross" [shape=diamond, style="filled", fillcolor="#fff2b3", color="#c0392b", label="unit.cross\nslot: anyone\ndrainer: ⚠ none"];
  "st_retire_source" [shape=box, style="filled,rounded", fillcolor="#d9d9d9", color="black", label="source.retire\nslot: engine\ndrainer: engine"];
}
subgraph cluster_working { label="Working (computed standing, not a place)"; style=filled; color="#bbbbbb"; fillcolor="#fdf3e1"; fontsize=11;
  anchor_working [shape=point, style=invis];
  "finding" [shape=ellipse, penwidth=1, color="black", label="finding\n(typed: math · scope · restatement ·\nnotation · citation · comprehension)"];
  "question" [shape=ellipse, penwidth=1, color="black", label="question\n(with a closer)"];
  "changeset" [shape=ellipse, penwidth=2.5, color="black", label="changeset\n(intent · invariant · scope)\n[kernel]"];
  "tension" [shape=ellipse, penwidth=1, color="black", label="tension\n(two supported claims)"];
  "demand" [shape=ellipse, penwidth=2.5, color="black", label="demand\n(a refused act)\n[kernel]"];
  "st_integrate" [shape=box, style="filled,rounded", fillcolor="white", color="#c0392b", label="claim.revise\nslot: the original integrator (continuity)\ndrainer: ⚠ none"];
  "st_answer" [shape=diamond, style="filled", fillcolor="#fff2b3", color="#c0392b", label="question.answer\nslot: the question's closer\ndrainer: ⚠ none"];
  "st_open_cs" [shape=box, style="filled,rounded", fillcolor="white", color="#c0392b", label="changeset.open\nslot: anyone\ndrainer: ⚠ none"];
  "st_commit_cs" [shape=diamond, style="filled", fillcolor="#fff2b3", color="#c0392b", label="changeset.commit\nslot: not the owner; importance-gated\ndrainer: ⚠ none"];
  "st_halt_cs" [shape=diamond, style="filled", fillcolor="#fff2b3", color="#c0392b", label="changeset.halt\nslot: breaker (mechanical) → reframing\ndrainer: ⚠ none"];
  "st_hold_tension" [shape=diamond, style="filled", fillcolor="#fff2b3", color="#c0392b", label="tension.resolve\nslot: on bearing evidence only\ndrainer: ⚠ none"];
  "st_admit" [shape=diamond, style="filled", fillcolor="#fff2b3", color="black", label="definition.admit\nslot: steward\ndrainer: steward"];
}
subgraph cluster_canon { label="Canon (citable standing)"; style=filled; color="#bbbbbb"; fillcolor="#e7f5e9"; fontsize=11;
  anchor_canon [shape=point, style=invis];
  "claim" [shape=ellipse, penwidth=1, color="black", label="claim at statement grain\n(definition · scope · postulate · claim ·\nno-go · norm · recognition)"];
  "check" [shape=ellipse, penwidth=1, color="black", label="check\n(on an evidence line, bound to a version)"];
  "claim_record" [shape=ellipse, penwidth=1, color="black", label="claim record\n(describes a claim)"];
  "term" [shape=ellipse, penwidth=1, color="black", label="term and notation"];
  "decision" [shape=ellipse, penwidth=2.5, color="black", label="decision\n(importance · assumptions as edges)\n[kernel]"];
  "purpose" [shape=ellipse, penwidth=1, color="black", label="purpose\n(the working thesis)"];
  "st_secure" [shape=box, style="filled,rounded", fillcolor="white", color="#c0392b", label="check.take\nslot: did not write this version; unprimed\ndrainer: ⚠ none"];
  "st_confirm" [shape=box, style="filled,rounded", fillcolor="white", color="#c0392b", label="check.confirm\nslot: not the reviser\ndrainer: ⚠ none"];
  "st_refute" [shape=box, style="filled,rounded", fillcolor="white", color="#c0392b", label="claim.refute\nslot: evidence, never authority\ndrainer: ⚠ none"];
  "st_decide" [shape=diamond, style="filled", fillcolor="#fff2b3", color="#c0392b", label="decision.decide\nslot: by importance\ndrainer: ⚠ none"];
  "st_revise_purpose" [shape=diamond, style="filled", fillcolor="#fff2b3", color="black", label="purpose.revise\nslot: steward\ndrainer: steward"];
  "st_term_decide" [shape=diamond, style="filled", fillcolor="#fff2b3", color="#c0392b", label="term.decide\nslot: anyone\ndrainer: ⚠ none"];
  "st_check_record" [shape=box, style="filled,rounded", fillcolor="white", color="#c0392b", label="claim_record.take\nslot: did not write the record\ndrainer: ⚠ none"];
  "st_m_render" [shape=box, style="filled,rounded", fillcolor="#d9d9d9", color="black", label="rendering.check\nslot: engine\ndrainer: engine"];
  "st_m_notation" [shape=box, style="filled,rounded", fillcolor="#d9d9d9", color="#c0392b", label="notation.check\nslot: tool\ndrainer: ⚠ none"];
}
subgraph cluster_explanation { label="Explanation and pedagogy"; style=filled; color="#bbbbbb"; fillcolor="#f3eafa"; fontsize=11;
  anchor_explanation [shape=point, style=invis];
  "arrangement" [shape=ellipse, penwidth=1, color="#c0392b", label="arrangement\n(outline order; which atoms a\nsegment holds, in what order)\n[demand on the kernel]"];
  "teaching" [shape=ellipse, penwidth=1, color="black", label="teaching\n(narrates)"];
  "front" [shape=ellipse, penwidth=1, color="black", label="front statement\n(headline, caption; restates)"];
  "pedagogy" [shape=ellipse, penwidth=1, color="black", label="pedagogy\n(reader gold, quiz, reading guides)"];
  "st_arrange" [shape=box, style="filled,rounded", fillcolor="white", color="#c0392b", label="arrangement.arrange\nslot: anyone\ndrainer: ⚠ none"];
  "st_rearrange" [shape=box, style="filled,rounded", fillcolor="white", color="#c0392b", label="arrangement.revise\nslot: anyone\ndrainer: ⚠ none"];
  "st_restate" [shape=box, style="filled,rounded", fillcolor="white", color="#c0392b", label="front.rebind\nslot: not the claim's reviser\ndrainer: ⚠ none"];
  "st_teach" [shape=box, style="filled,rounded", fillcolor="white", color="#c0392b", label="teaching.rebind\nslot: anyone\ndrainer: ⚠ none"];
  "st_read_test" [shape=box, style="filled,rounded", fillcolor="white", color="#c0392b", label="pedagogy.read\nslot: a cold reader\ndrainer: ⚠ none"];
  "st_m_bindings" [shape=box, style="filled,rounded", fillcolor="#d9d9d9", color="#c0392b", label="front.check\nslot: tool\ndrainer: ⚠ none"];
}
subgraph cluster_application { label="Application (the edge to reality)"; style=filled; color="#bbbbbb"; fillcolor="#fbe9ec"; fontsize=11;
  anchor_application [shape=point, style=invis];
  "application" [shape=ellipse, penwidth=1, color="black", label="application\n(a model or measurement\non an agent the theory did not build)"];
  "run" [shape=ellipse, penwidth=1, color="black", label="run\n(era-keyed)"];
  "st_apply" [shape=box, style="filled,rounded", fillcolor="white", color="#c0392b", label="application.apply\nslot: anyone\ndrainer: ⚠ none"];
  "st_run" [shape=box, style="filled,rounded", fillcolor="#d9d9d9", color="#c0392b", label="run.run\nslot: pre-registered prediction\ndrainer: ⚠ none"];
}
subgraph cluster_outside_out { label="Set aside to other stores"; style=filled; color="#bbbbbb"; fillcolor="#f2f2f2"; fontsize=11;
  anchor_outside_out [shape=point, style=invis];
  "ext_out" [shape=folder, penwidth=1, color="black", label="logos · vivarium ·\npedagogy store · udon"];
}
subgraph cluster_sinks { label="Sinks"; style=filled; color="#bbbbbb"; fillcolor="#e6e6e6"; fontsize=11;
  anchor_sinks [shape=point, style=invis];
  "sink_already-present" [shape=doublecircle, style=filled, fillcolor="#333333", fontcolor=white, fontsize=8, label="already-present"];
  "sink_duplicate" [shape=doublecircle, style=filled, fillcolor="#333333", fontcolor=white, fontsize=8, label="duplicate"];
  "sink_superseded" [shape=doublecircle, style=filled, fillcolor="#333333", fontcolor=white, fontsize=8, label="superseded"];
  "sink_stale" [shape=doublecircle, style=filled, fillcolor="#333333", fontcolor=white, fontsize=8, label="stale"];
  "sink_not-work" [shape=doublecircle, style=filled, fillcolor="#333333", fontcolor=white, fontsize=8, label="not-work"];
  "sink_rejected" [shape=doublecircle, style=filled, fillcolor="#333333", fontcolor=white, fontsize=8, label="rejected"];
}
anchor_outside_in -> anchor_influx [style=invis, weight=50];
anchor_influx -> anchor_working [style=invis, weight=50];
anchor_working -> anchor_canon [style=invis, weight=50];
anchor_canon -> anchor_explanation [style=invis, weight=50];
anchor_explanation -> anchor_application [style=invis, weight=50];
anchor_application -> anchor_outside_out [style=invis, weight=50];
anchor_outside_out -> anchor_sinks [style=invis, weight=50];
"ext_source" -> "st_bring";
"st_bring" -> "source";
"source" -> "st_carve";
"st_carve" -> "unit";
"unit" -> "st_cross";
"st_cross" -> "finding";
"st_cross" -> "question";
"st_cross" -> "claim";
"st_cross" -> "changeset";
"st_cross" -> "claim_record";
"st_cross" -> "term";
"st_cross" -> "teaching";
"st_cross" -> "front";
"st_cross" -> "pedagogy";
"st_cross" -> "application";
"st_cross" -> "run";
"st_cross" -> "sink_already-present" [color="#888888", arrowsize=0.6];
"st_cross" -> "sink_duplicate" [color="#888888", arrowsize=0.6];
"st_cross" -> "sink_superseded" [color="#888888", arrowsize=0.6];
"st_cross" -> "sink_stale" [color="#888888", arrowsize=0.6];
"st_cross" -> "sink_not-work" [color="#888888", arrowsize=0.6];
"st_cross" -> "sink_rejected" [color="#888888", arrowsize=0.6];
"st_cross" -> "ext_out" [label="set aside", color="#888888"];
"source" -> "st_retire_source";
"finding" -> "st_integrate";
"st_integrate" -> "claim";
"st_integrate" -> "changeset";
"st_integrate" -> "sink_rejected" [color="#888888", arrowsize=0.6];
"question" -> "st_answer";
"st_answer" -> "claim";
"st_answer" -> "finding";
"st_answer" -> "decision";
"changeset" -> "st_open_cs";
"st_open_cs" -> "claim";
"st_open_cs" -> "unit" [style=dashed, color="#c0392b", constraint=false];
"changeset" -> "st_commit_cs";
"st_commit_cs" -> "claim";
"st_commit_cs" -> "decision";
"changeset" -> "st_halt_cs";
"st_halt_cs" -> "question";
"st_halt_cs" -> "tension";
"tension" -> "st_hold_tension";
"st_hold_tension" -> "claim";
"st_hold_tension" -> "decision";
"demand" -> "st_admit";
"st_admit" -> "decision";
"claim" -> "st_secure";
"st_secure" -> "check";
"check" -> "st_confirm";
"st_confirm" -> "finding" [style=dashed, color="#c0392b", constraint=false];
"check" -> "st_refute";
"st_refute" -> "finding" [style=dashed, color="#c0392b", constraint=false];
"st_refute" -> "tension" [style=dashed, color="#c0392b", constraint=false];
"decision" -> "st_decide";
"st_decide" -> "question" [style=dashed, color="#c0392b", constraint=false];
"purpose" -> "st_revise_purpose";
"st_revise_purpose" -> "question" [style=dashed, color="#c0392b", constraint=false];
"term" -> "st_term_decide";
"st_term_decide" -> "finding" [style=dashed, color="#c0392b", constraint=false];
"claim" -> "st_arrange";
"st_arrange" -> "arrangement";
"claim_record" -> "st_check_record";
"st_check_record" -> "check";
"st_check_record" -> "finding" [style=dashed, color="#c0392b", constraint=false];
"arrangement" -> "st_rearrange";
"st_rearrange" -> "finding" [style=dashed, color="#c0392b", constraint=false];
"front" -> "st_restate";
"st_restate" -> "finding" [style=dashed, color="#c0392b", constraint=false];
"teaching" -> "st_teach";
"st_teach" -> "finding" [style=dashed, color="#c0392b", constraint=false];
"pedagogy" -> "st_read_test";
"st_read_test" -> "finding" [style=dashed, color="#c0392b", constraint=false];
"application" -> "st_apply";
"st_apply" -> "check" [style=dashed, color="#c0392b", constraint=false];
"st_apply" -> "finding" [style=dashed, color="#c0392b", constraint=false];
"st_apply" -> "source" [style=dashed, color="#c0392b", constraint=false];
"run" -> "st_run";
"st_run" -> "check" [style=dashed, color="#c0392b", constraint=false];
"st_run" -> "finding" [style=dashed, color="#c0392b", constraint=false];
"claim" -> "st_m_render";
"st_m_render" -> "demand" [style=dashed, color="#c0392b", constraint=false];
"term" -> "st_m_notation";
"st_m_notation" -> "finding" [style=dashed, color="#c0392b", constraint=false];
"front" -> "st_m_bindings";
"st_m_bindings" -> "finding" [style=dashed, color="#c0392b", constraint=false];
legend [shape=note, fontsize=9, label="ellipse: a kind of atom (Petri place); bold border: kernel kind; red border: a demand on the kernel\lbox: a judgment station · yellow diamond: a decision point · grey: mechanical (deterministic)\lred station border: no drainer (the drain condition fails) · red dashed edge: feedback upstream\lload: items processed per source of influx, from x = (I − Aᵀ)⁻¹ f, no wall time\l"];
}