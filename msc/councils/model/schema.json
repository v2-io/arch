{
  "model": "ronr-12-unified",
  "file": "schema",
  "desc": "The typed state schema: the context object every expression evaluates against. Types use a compact notation: ? = nullable, [] = list of, {} = record, enum values inline or referenced to vocabulary.json. Fields marked input:true are world-facts the engine cannot derive — they arrive with events (like vote tallies) and are listed in gaps.json as judgment/world inputs.",

  "types": {
    "Frame": {
      "id": "string",
      "question_ref": "question/<uuid>",
      "motion_id": "motion id (registry.json)",
      "class": "enum M|S|P|I|B|M/B",
      "applied_to": "?frame-id — the frame this motion operates on [6:6(1)]; null for privileged motions [6:11]",
      "adheres_to": "?frame-id — adherence per [10:35]; diverges from applied_to for non-adhering incidentals and privileged frames",
      "effective_rank": "number — position in precedence.json rank_order, positionally modified per engine.json effective_rank",
      "orders_in_force": "[order-id]"
    },
    "PendingStack": {
      "frames": "[Frame] bottom-first; top = immediately pending question [5:7]"
    },
    "Question": {
      "id": "question/<uuid>",
      "motion_id": "motion id",
      "text": "string (exact wording as stated; definitive [4:34])",
      "maker": "?member-id",
      "seconder": "?member-id",
      "on_behalf_of_committee": "boolean [4:11]",
      "original_main": "boolean — original main motion vs incidental main [10:3-7]",
      "purpose_class": {"type": "?enum priority-of-business|other", "input": true, "desc": "content classification recorded at making (e.g. a suspend-rules touching priority of business [18:4(1)])"},
      "r1_state": "enum lifecycle.json states",
      "r1_history": "[state transitions with times]",
      "disposition_vote": "?Vote",
      "effect": "?Effect (adopted questions)",
      "reconsider_hold": "?{made_by, seconded_by, made_at, called_up: boolean, enter_minutes: boolean}",
      "timers": "[TimerInstance]",
      "suppression_origin": "?enum postponed-indefinitely|objection-sustained (retained on merge into suppressed-for-session)"
    },
    "Effect": {
      "in_force": "boolean",
      "fully_executed": {"type": "boolean", "input": true},
      "partly_executed": {"type": "boolean", "input": true},
      "undoable": {"type": "boolean", "input": true},
      "contract_with_notified_party": {"type": "boolean", "input": true},
      "person_notified": {"type": "boolean", "input": true, "desc": "resignation/election/expulsion cases [35:6]"}
    },
    "Vote": {
      "question_ref": "question id",
      "method": "enum voice|rising|counted-rising|ballot|roll-call|unanimous-consent",
      "threshold": "threshold id (vocabulary.json)",
      "tally": "?{yes, no, abstain-known}",
      "result": "enum adopted|rejected",
      "announced_at": "time",
      "prevailing_members": {"type": "?[member-id]", "input": true, "desc": "recorded only for roll-call; otherwise established by member assertion via adjudication (prevailing-side-claim)"}
    },
    "Order": {
      "id": "order/<id>",
      "kind": "enum previous-question|close-debate-at-hour|limit-total-time|per-speech-limit|extend-limits",
      "covers": "[frame-id] — the consecutive series covered [16:5(2), 15:5(2)]",
      "created_by": "question id (the adopted limit/PQ motion)",
      "exhausted": "boolean — maintained per timer/order-exhaustion [15:18, 16:11]"
    },
    "Bundle": {
      "kind": "enum tabled|postponed|committed|reconsider-held",
      "frames": "[Frame] bottom-first, adherence links intact",
      "orders_in_force": "[order-id]",
      "created": "event record",
      "expiry_ref": "?timer instance"
    },
    "ScheduledItem": {
      "id": "string",
      "kind": "enum general-order|special-order|the-special-order-for-meeting|scheduled-recess|scheduled-adjournment",
      "subject": "question id | Bundle | agenda item",
      "hour": "?time (null = unset hour)",
      "made_at": "time — earlier-made outranks earlier-hour [41:50-51, 41:53-54]",
      "queue": "queue id"
    },
    "Member": {
      "id": "member-id",
      "roles": "[role id] — chair/secretary global; maker/seconder/reporting-member bound per-question (protocol.json roles NOTE)",
      "present": "boolean",
      "in_good_standing": {"type": "boolean", "input": true, "desc": "basic rights removable only by discipline [25:11, 61]"},
      "speech_counters": "{(question-id, day) -> {speeches, minutes_used}}",
      "has_floor": "boolean"
    },
    "TimerInstance": {
      "timer_id": "timer id (lifecycle.json timers)",
      "question_ref": "question id",
      "started_at": "time/event",
      "open": "boolean — evaluated from the timer definition's expires expression"
    },
    "AdjudicationInstance": {
      "predicate": "predicate id (adjudication.json)",
      "subject": "subject reference (frame/question/member/act)",
      "state": "enum raised|declared|submitted|appeal-window|appealed|final",
      "value": "?boolean — the declared/decided judgment content (input event)",
      "declared_by": "?enum chair|assembly",
      "final_for_session": "boolean"
    },
    "EventRecord": {
      "event": "event id (vocabulary.json)",
      "actor": "?member-id",
      "subject": "?question/frame reference",
      "at": "time",
      "meeting": "meeting id",
      "session": "session id"
    }
  },

  "context": {
    "assembly": {
      "body_kind": "enum assembly|committee|committee-of-the-whole|quasi-committee|convention|mass-meeting",
      "members": "[Member]",
      "present_count": "number",
      "membership_total": "number",
      "quorum": "number [40:1-3]"
    },
    "clock": {
      "now": "time",
      "current_day": "date",
      "current_meeting": "meeting id",
      "current_session": "session id",
      "session_of_meeting": "meeting -> session map [8:1-2]",
      "next_regular_session": "?date",
      "adjourned_meeting_set": "boolean [9:19, 21:7(a)]",
      "term_boundary_before_next_session": {"type": "boolean", "input": true, "desc": "a specified portion of membership ends its term before the next regular session [21:7(b-c)]"},
      "last_business_day_of_session": "boolean [37:47]"
    },
    "floor": {
      "holder": "?member-id",
      "interrupted_holder": "?member-id — retains floor through interruption [42:20]",
      "claims": "[{member, rose_at, purpose}]"
    },
    "contexts": "[PendingStack] — the context stack (engine.json context_stack); last = active; frozen whole by recess/adjournment [8:7, 21:7(a)]",
    "questions": "{question-id -> Question}",
    "bundles": "[Bundle] — serialized-out bundles (tabled, postponed, committed, reconsider-held)",
    "orders": "[Order] — debate-limiting orders in force; owned by rules state, read by guard/no-order-precluding, expired by timer/order-exhaustion (lifecycle)",
    "queues": {
      "special-orders-unfinished": "[ScheduledItem] FIFO by time made [41:18]",
      "special-orders-current": "[ScheduledItem] FIFO by time made [41:18]",
      "unfinished-business": "[ScheduledItem] in the three-part order of [41:21-23]",
      "general-orders-current": "[ScheduledItem] in made-order [41:23, 41:52]"
    },
    "rules_state": {
      "adopted_rules": "{class id -> [rule records]} (rules.json classes)",
      "suspensions_in_force": "[{rule/purpose, scope, adopted_at}] [25:4-5]",
      "precedents": "[{ruling, reasons, appealed, outcome}] — persuasive only [23:10-11]"
    },
    "vote_in_progress": "?Vote — guard/voting-in-progress reads non-null and polls open [45:6]",
    "last_announced_vote": "?Vote — window per timer/vote-challenge-window [45:9]",
    "adjudications": "[AdjudicationInstance]",
    "history": {
      "events": "[EventRecord] — supports [\"event-occurred\", ...] scoped by question/series/session/day",
      "business_transacted_since": "{marker -> boolean} — e.g. since a tabling, for take-from-table's precondition [34:2(2)]"
    }
  }
}
