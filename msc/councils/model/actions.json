{
  "model": "ronr-12-unified",
  "file": "actions",
  "desc": "The root table: the action space available_actions(member, role, state) enumerates. Each action kind carries the roles that can take it and an admissibility expression; the function returns, for every member, every action whose expression is true, with justification = the satisfied conjuncts (each carrying its citation). Recomputed on every event. Bindings: member = the acting member; m/t/q as noted per action.",

  "function": {
    "signature": "available_actions(member, role, state) -> [(action, justification)]",
    "justification": "by construction: the admissibility expression's satisfied conjuncts with their cite annotations; for blocked actions (when asked why-not), the true out-of-order disjunct with its cite",
    "recompute_on": "every event in vocabulary.json events"
  },

  "actions": [
    {"id": "move", "roles": ["member"], "params": ["m (motion id)", "t (target frame or null)"],
     "desc": "make a motion; instantiated once per motion id currently admissible",
     "expr": ["and",
       ["attr", ["param", "member"], "in_good_standing"],
       ["or", ["=", ["ctx", "floor", "holder"], ["param", "member"]],
              ["guard", "in-order-when-other-has-floor"],
              ["and", ["guard", "floor-open"], ["=", ["reg", ["param", "m"], "second"], false]]],
       ["rank-admissible", ["param", "m"], ["param", "t"]],
       ["applicable", ["param", "m"], ["param", "t"]],
       ["guard", "no-order-precluding"],
       ["guard", "act-in-order-under-governing-rules"],
       ["not", ["guard", "dilatory"]],
       ["or", ["guard", "quorum-present"],
              ["in", ["param", "m"], ["list", "fix-time-to-which-to-adjourn", "adjourn", "recess"]]]],
     "cite": "5:8-9, 7:2, 16:2, 10:26, 39:1-4, 40:6-7",
     "note": "demanding-class motions (division-of-assembly, call-for-orders-of-the-day) and requests are included: their registry second=false plus interrupt attributes make them available without the floor"},

    {"id": "second", "roles": ["member"], "params": ["q (question in state moved)"],
     "expr": ["and",
       ["=", ["state", ["param", "q"]], "moved"],
       ["=", ["reg", ["attr", ["param", "q"], "motion_id"], "second"], true],
       ["not", ["attr", ["param", "q"], "on_behalf_of_committee"]],
       ["!=", ["param", "member"], ["attr", ["param", "q"], "maker"]]],
     "cite": "4:9-14"},

    {"id": "claim-floor", "roles": ["member"],
     "desc": "rise and address the chair to seek recognition",
     "expr": ["and", ["guard", "floor-open"], ["not", ["guard", "voting-in-progress"]]],
     "cite": "3:30-32, 42:2",
     "note": "who WINS recognition is protocol.json preference_in_recognition, applied by the chair among timely claims (guard/preference-claim-timely)"},

    {"id": "speak-in-debate", "roles": ["member"], "params": ["f (immediately pending frame)"],
     "expr": ["and",
       ["=", ["ctx", "floor", "holder"], ["param", "member"]],
       ["!=", ["top"], null],
       ["debatable", ["top"]],
       ["event-occurred", "stated", ["question", ["top"]]],
       ["<", ["attr", ["param", "member"], "speech_counters", ["question", ["top"]], "speeches"], 2],
       ["not", ["and", ["=", ["attr", ["param", "member"], "speech_counters", ["question", ["top"]], "speeches"], 1],
                        ["exists", "c", ["ctx", "floor", "claims"],
                          ["=", ["attr", ["attr", "c", "member"], "speech_counters", ["question", ["top"]], "speeches"], 0]]]],
       ["not", ["adjudged", "decorum-breach", ["param", "member"]]]],
     "cite": "43:8, 43:12-13, 4:28, 43:20-25",
     "note": "counter limits modifiable by special rules or orders (protocol.json speech_counters); appeal's one-speech rule and the chair's two speeches are the per-motion exceptions [24:3(5)]"},

    {"id": "vote", "roles": ["member"],
     "expr": ["guard", "voting-in-progress"],
     "cite": "45:1-6"},

    {"id": "change-vote", "roles": ["member"],
     "expr": ["or", ["guard", "voting-in-progress"],
                    ["and", ["guard", "result-window-open"], ["=", "unanimous-consent", "unanimous-consent"]]],
     "cite": "45:8",
     "note": "after announcement only by unanimous consent, requested immediately — the second disjunct routes through the consent exchange (request-consent action)"},

    {"id": "demand-division", "roles": ["member"],
     "expr": ["and", ["or", ["guard", "voting-in-progress"], ["guard", "result-window-open"]],
                     ["not", ["adjudged", "dilatory", "division-of-assembly"]]],
     "cite": "29:4(1), 45:9, 29:7"},

    {"id": "object-to-unanimous-consent", "roles": ["member"],
     "expr": ["event-occurred", "consent-requested", "pending-consent"],
     "cite": "4:58-59",
     "note": "timely even immediately after the chair's announcement of the consent action"},

    {"id": "request", "roles": ["member"], "params": ["kind (requests-and-inquiries member)"],
     "expr": ["or", ["guard", "floor-open"],
                    ["and", ["guard", "another-has-floor"], ["adjudged", "interruption-urgency", ["param", "kind"]]]],
     "cite": "33:2-22, 42:18(e)"},

    {"id": "withdraw-own-motion", "roles": ["maker"], "params": ["q"],
     "expr": ["or",
       ["in", ["state", ["param", "q"]], ["list", "moved", "seconded"]],
       ["and", ["=", ["state", ["param", "q"]], "pending"], ["not", ["guard", "voting-in-progress"]]]],
     "cite": "4:19, 33:11-18",
     "note": "before stating: unilateral; after: becomes a consent/vote exchange (protocol.json requests)"},

    {"id": "call-up-reconsider", "roles": ["member"], "params": ["q (question with reconsider_hold)"],
     "expr": ["and",
       ["!=", ["attr", ["param", "q"], "reconsider_hold"], null],
       ["timer-open", "reconsider-callup-window", ["param", "q"]],
       ["or", ["not", ["attr", ["attr", ["param", "q"], "reconsider_hold"], "enter_minutes"]],
              ["not", ["same-day", ["now"], ["attr", ["attr", ["param", "q"], "reconsider_hold"], "made_at"]]],
              ["ctx", "clock", "last_business_day_of_session"]],
       ["guard", "no-question-pending"]],
     "cite": "37:15, 37:46-47",
     "note": "any member may call up (no second) [37:9(4)]; if the target would be in order mid-series it slots per precedence.json reconsider_split_rank"},

    {"id": "give-previous-notice", "roles": ["member"],
     "expr": ["or", ["guard", "floor-open"], ["event-occurred", "recognized", "just-assigned-before-speech"]],
     "cite": "10:44-51, 42:19(a)"},

    {"id": "raise-point-of-order", "roles": ["member"], "params": ["breach"],
     "expr": ["or", ["guard", "result-window-open"],
                    ["event-occurred", "breach-just-occurred", "now"],
                    ["guard", "continuing-breach"]],
     "cite": "23:1-6",
     "note": "the adjudication entry point (adjudication.json machine, raise)"},

    {"id": "appeal", "roles": ["member"],
     "expr": ["and", ["event-occurred", "chair-ruling", "just-now"],
                     ["not", ["event-occurred", "business-intervened", "since-ruling"]]],
     "cite": "24:2-3, 24:3(3)",
     "note": "needs a second (two members together); debatability and yields per adjudication.json and table/appeal-yield-matrix"},

    {"id": "state-question", "roles": ["chair"], "params": ["q"],
     "expr": ["and", ["=", ["state", ["param", "q"]], "seconded"],
                     ["not", ["adjudged", "dilatory", ["attr", ["param", "q"], "motion_id"]]]],
     "cite": "4:15-18",
     "note": "the chair's alternative — rule out of order — is the same decision point's other branch"},

    {"id": "rule-out-of-order", "roles": ["chair"], "params": ["q | act"],
     "expr": ["or", ["=", ["state", ["param", "q"]], "seconded"], ["event-occurred", "breach-just-occurred", "now"]],
     "cite": "4:16-17, 23:2(7), 39:2"},

    {"id": "put-question", "roles": ["chair"],
     "expr": ["and", ["!=", ["top"], null],
                     ["or", ["not", ["debatable", ["top"]]],
                            ["event-occurred", "debate-exhausted", ["question", ["top"]]],
                            ["guard", "pq-order-unexhausted"]]],
     "cite": "4:34-40, 16:9, 43:8",
     "note": "debate-exhausted: no member seeking the floor for debate and counters allow no more, or the PQ/limit order closes debate"},

    {"id": "announce-result", "roles": ["chair"],
     "expr": ["and", ["!=", ["ctx", "vote_in_progress"], null], ["attr", ["ctx", "vote_in_progress"], "polls-closed"]],
     "cite": "4:41-49"},

    {"id": "recognize", "roles": ["chair"], "params": ["claimant"],
     "expr": ["and", ["guard", "floor-open"],
                     ["exists", "c", ["ctx", "floor", "claims"], ["=", ["attr", "c", "member"], ["param", "claimant"]]]],
     "cite": "3:30, 42:2",
     "note": "which claimant is ENTITLED is protocol.json preference_in_recognition; recognizing another is a breach remediable by point of order [42:15]"},

    {"id": "announce-scheduled-item", "roles": ["chair"], "params": ["item"],
     "expr": ["guard", "order-of-day-due"],
     "cite": "41:24, 14:17, 41:53",
     "note": "preemption of a pending question additionally requires guard/may-preempt (scheduler.json)"},

    {"id": "declare-recess-or-adjournment", "roles": ["chair"],
     "expr": ["or", ["event-occurred", "adopted", "recess-or-adjourn-just-voted"],
                    ["exists", "i", ["ctx", "queues", "special-orders-current"],
                      ["and", ["in", ["attr", "i", "kind"], ["list", "scheduled-recess", "scheduled-adjournment"]],
                              ["not", ["before", ["now"], ["attr", "i", "hour"]]]]]],
     "cite": "21:14, 20:6-7, 41:66"},

    {"id": "respond-to-inquiry", "roles": ["chair"],
     "expr": ["event-occurred", "consent-requested", "inquiry-pending"],
     "cite": "33:3-10"},

    {"id": "read-paper", "roles": ["secretary"],
     "expr": ["event-occurred", "reading-directed", "now"],
     "cite": "3:6, 47:32-33, 42:21"},

    {"id": "report", "roles": ["reporting-member"], "params": ["q (committed question)"],
     "expr": ["and", ["=", ["state", ["param", "q"]], "committed"],
                     ["guard", "order-of-day-due"]],
     "cite": "51:8-11, 51:36-44",
     "note": "motions on behalf of the committee need no second [4:11]"}
  ],

  "chair_duty_note": "Chair actions are duties as much as options: where exactly one chair action is admissible (announce the known next item [41:24], state a seconded in-order motion promptly [4:16]), the list is also the obligation. The model exposes admissibility; duty sequencing is stage-5 policy over the same expressions."
}
