digraph decisionline {
rankdir=LR; ranksep=0.6; nodesep=0.35; fontsize=20; labelloc=t;
label="The decision line (Backing) -- grounds / consult / authority as its securing lines; ratified is guard-gated on the other two; reopen fires on named-assumption invalidation and carries what-changed";
node [fontname="Helvetica" fontsize=11]; edge [fontname="Helvetica" fontsize=9 color="#555555"];
"forks.decision-inflection" [shape=ellipse style=filled fillcolor="#dbe7f5" label="forks.decision-inflection"];
"decision-questions" [shape=ellipse style=filled fillcolor="#dbe7f5" label="decision-questions"];
"options" [shape=ellipse style=filled fillcolor="#eeeeee" label="options"];
"line.grounds" [shape=ellipse style=filled fillcolor="#e8f4f8" label="line.grounds\nassumed-implicit > assumptions-explicit > revisit-triggers-declared"];
"line.consult" [shape=ellipse style=filled fillcolor="#e8f4f8" label="line.consult\nunannounced > announced-to-affected > feedback-collected"];
"line.authority" [shape=ellipse style=filled fillcolor="#e8f4f8" label="line.authority\nproposed > supported > ratified > ruled"];
"ledger.DECISIONS" [shape=ellipse style=filled fillcolor="#eadff0" label="ledger.DECISIONS\n(append-or-expressly-overturn;\nauthority cell is a projection)"];
"superseded.pointed" [shape=ellipse style=filled fillcolor="#f5c6c6" label="superseded.pointed"];
"accounts.Fidelity" [shape=ellipse style=filled fillcolor="#f2e6d0" label="accounts.Fidelity"];
"evidence.arrivals" [shape=ellipse style=filled fillcolor="#dfeedd" label="evidence.arrivals"];
"signals.out" [shape=ellipse style=filled fillcolor="#f9e0e0" label="signals.out"];
"T.pose" [shape=box style=filled fillcolor="#cfcfcf" label="T.pose"];
"T.draft-options" [shape=box style=filled fillcolor="#cfcfcf" label="T.draft-options"];
"T.open.grounds" [shape=box style=filled fillcolor="#cfcfcf" label="T.open.grounds"];
"T.open.consult" [shape=box style=filled fillcolor="#cfcfcf" label="T.open.consult"];
"T.open.authority" [shape=box style=filled fillcolor="#cfcfcf" label="T.open.authority"];
"T.secure*.grounds" [shape=box style=filled fillcolor="#d7d7ee" label="T.secure*.grounds\nname-explicit-assumptions (pre-call = auditable; post-hoc = rationalization)\nsurface-implicit-assumptions + declare revisit-triggers"];
"T.secure*.consult" [shape=box style=filled fillcolor="#d7d7ee" label="T.secure*.consult\nannounce (who-knows established)\ncollect feedback / votes"];
"T.secure*.authority" [shape=box style=filled fillcolor="#d7d7ee" label="T.secure*.authority\nno-objection-at-the-time (supported)\nreal-read + stands-behind (ratified; REQUIRES grounds-explicit + announced)\nreserved-fiat (ruled; unstated reasons allowed, honestly)"];
"T.land" [shape=box style=filled fillcolor="#cfcfcf" label="T.land\n[GUARD: revisit-declared\n+ announced]"];
"T.license" [shape=box style=filled fillcolor="#cfcfcf" label="T.license"];
"T.revisit-trigger" [shape=box style=filled fillcolor="#f5d5a0" label="T.revisit-trigger"];
"T.supersede" [shape=box style=filled fillcolor="#f5d5a0" label="T.supersede"];
"forks.decision-inflection" -> "T.pose" [style=solid];
"T.pose" -> "decision-questions";
"decision-questions" -> "T.draft-options" [style=dashed, label="?"];
"T.draft-options" -> "options";
"options" -> "T.open.grounds" [style=dashed, label="?"];
"T.open.grounds" -> "line.grounds";
"options" -> "T.open.consult" [style=dashed, label="?"];
"T.open.consult" -> "line.consult";
"options" -> "T.open.authority" [style=dashed, label="?"];
"T.open.authority" -> "line.authority";
"line.grounds" -> "T.secure*.grounds" [style=solid];
"T.secure*.grounds" -> "line.grounds";
"T.secure*.grounds" -> "accounts.Fidelity";
"line.consult" -> "T.secure*.consult" [style=solid];
"T.secure*.consult" -> "line.consult";
"T.secure*.consult" -> "accounts.Fidelity";
"line.authority" -> "T.secure*.authority" [style=solid];
"T.secure*.authority" -> "line.authority";
"T.secure*.authority" -> "accounts.Fidelity";
"line.grounds" -> "T.land" [style=solid];
"line.consult" -> "T.land" [style=solid];
"line.authority" -> "T.land" [style=solid];
"T.land" -> "ledger.DECISIONS";
"T.land" -> "accounts.Fidelity";
"ledger.DECISIONS" -> "T.license" [style=dashed, label="?"];
"T.license" -> "signals.out";
"evidence.arrivals" -> "T.revisit-trigger" [style=solid];
"ledger.DECISIONS" -> "T.revisit-trigger" [style=solid];
"T.revisit-trigger" -> "ledger.DECISIONS";
"T.revisit-trigger" -> "signals.out";
"T.revisit-trigger" -> "accounts.Fidelity";
"ledger.DECISIONS" -> "T.supersede" [style=solid];
"T.supersede" -> "superseded.pointed";
"T.supersede" -> "ledger.DECISIONS";
}