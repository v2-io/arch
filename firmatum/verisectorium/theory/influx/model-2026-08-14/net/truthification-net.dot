digraph truthification {
rankdir=LR; ranksep=0.7; nodesep=0.35; fontsize=22; labelloc=t;
label="Truthification cycle v2 - ladders as guard vocabularies (colored Petri net; ?-arcs consult without consuming)";
node [fontname="Helvetica" fontsize=11]; edge [fontname="Helvetica" fontsize=9 color="#555555"];
subgraph cluster_0 { label="observe"; style=rounded; color="#999999"; fontsize=14;
"observations.Fidelity" [shape=ellipse style=filled fillcolor="#f2e6d0" label="observations.Fidelity"];
"questions.Disposition" [shape=ellipse style=filled fillcolor="#dbe7f5" label="questions.Disposition"];
"counterfactuals" [shape=ellipse style=filled fillcolor="#eeeeee" label="counterfactuals"];
}
subgraph cluster_1 { label="ideate"; style=rounded; color="#999999"; fontsize=14;
"T.ideate" [shape=box style=filled fillcolor="#cfcfcf" label="T.ideate"];
"claims.Evidence" [shape=ellipse style=filled fillcolor="#dfeedd" label="claims.Evidence"];
}
subgraph cluster_2 { label="truth-paths (concurrent lines; [*] = ladder)"; style=rounded; color="#999999"; fontsize=14;
"T.launch.math" [shape=box style=filled fillcolor="#cfcfcf" label="T.launch.math"];
"line.math" [shape=ellipse style=filled fillcolor="#e8f4f8" label="line.math\nfamily: derivation\nsketch > drafted > deps-verified > re-derived"];
"T.secure*.math" [shape=box style=filled fillcolor="#d7d7ee" label="T.secure*.math\nchannels:\nformal-expression-written\npremises-named-and-checked\nindependent-re-derivation"];
"T.launch.sim" [shape=box style=filled fillcolor="#cfcfcf" label="T.launch.sim"];
"line.sim" [shape=ellipse style=filled fillcolor="#e8f4f8" label="line.sim\nfamily: in-vivo-measurement\npre-registered > run-once > swept > independently-reproduced"];
"T.secure*.sim" [shape=box style=filled fillcolor="#d7d7ee" label="T.secure*.sim\nchannels:\nfirst-run (era-keyed)\nseed/level/footprint-sweep\nindependent-re-run"];
"T.launch.lit" [shape=box style=filled fillcolor="#cfcfcf" label="T.launch.lit"];
"line.lit" [shape=ellipse style=filled fillcolor="#e8f4f8" label="line.lit\nfamily: transmission:empirical-wild\nnamed-not-read > recalled > search-corroborated > verified-via-secondary > primary-verified"];
"T.secure*.lit" [shape=box style=filled fillcolor="#d7d7ee" label="T.secure*.lit\nchannels:\nrecall-marked-as-recall\nconvergent-secondaries\nfaithful-secondary-fetched\nprimary-fetched"];
"T.launch.testimony" [shape=box style=filled fillcolor="#cfcfcf" label="T.launch.testimony"];
"line.testimony" [shape=ellipse style=filled fillcolor="#e8f4f8" label="line.testimony\nfamily: testimony\ncaptured > corroborated > cross-kind-corroborated"];
"T.secure*.testimony" [shape=box style=filled fillcolor="#d7d7ee" label="T.secure*.testimony\nchannels:\nindependent-account-located\nindependent-kind-agrees"];
"T.launch.analog" [shape=box style=filled fillcolor="#cfcfcf" label="T.launch.analog"];
"line.analog" [shape=ellipse style=filled fillcolor="#e8f4f8" label="line.analog\nfamily: analogy\nhunch > articulated > perturbation-tested"];
"T.secure*.analog" [shape=box style=filled fillcolor="#d7d7ee" label="T.secure*.analog\nchannels:\nanalogy-articulated\nperturbation-test-passed"];
"T.lit-informs-design" [shape=box style=filled fillcolor="#e9dcc9" label="T.lit-informs-design"];
"T.lit-scope-influence" [shape=box style=filled fillcolor="#e9dcc9" label="T.lit-scope-influence"];
}
subgraph cluster_3 { label="truth-results"; style=rounded; color="#999999"; fontsize=14;
"T.conclude.math" [shape=box style=filled fillcolor="#cfcfcf" label="T.conclude.math"];
"T.conclude.sim" [shape=box style=filled fillcolor="#cfcfcf" label="T.conclude.sim"];
"T.conclude.lit" [shape=box style=filled fillcolor="#cfcfcf" label="T.conclude.lit"];
"T.conclude.testimony" [shape=box style=filled fillcolor="#cfcfcf" label="T.conclude.testimony"];
"T.feed-ideation.analog" [shape=box style=filled fillcolor="#cfcfcf" label="T.feed-ideation.analog"];
"results" [shape=ellipse style=filled fillcolor="#eeeeee" label="results"];
}
subgraph cluster_4 { label="standing surface"; style=rounded; color="#999999"; fontsize=14;
"T.pay-in" [shape=box style=filled fillcolor="#cfcfcf" label="T.pay-in"];
"ledger.standing-surface" [shape=ellipse style=filled fillcolor="#ffd9b3" peripheries=2 label="ledger.standing-surface\n(standing surface; max / floor /\nconvergent-lock are QUERIES here)"];
"T.era-bump.k1-to-k2" [shape=box style=filled fillcolor="#f5d5a0" label="T.era-bump.k1-to-k2"];
"T.reverify.lit-primary-fetched" [shape=box style=filled fillcolor="#f5d5a0" label="T.reverify.lit-primary-fetched"];
"expired.certificates" [shape=ellipse style=filled fillcolor="#f5c6c6" label="expired.certificates"];
}
subgraph cluster_5 { label="downstream"; style=rounded; color="#999999"; fontsize=14;
"T.decide" [shape=box style=filled fillcolor="#cfcfcf" label="T.decide"];
"decisions.Backing" [shape=ellipse style=filled fillcolor="#eadff0" label="decisions.Backing"];
"T.teach" [shape=box style=filled fillcolor="#cfcfcf" label="T.teach"];
"pedagogy.Comprehension" [shape=ellipse style=filled fillcolor="#fdf3c8" label="pedagogy.Comprehension"];
"T.apply" [shape=box style=filled fillcolor="#cfcfcf" label="T.apply"];
}
"accounts.Fidelity" [shape=ellipse style=filled fillcolor="#f2e6d0" label="accounts.Fidelity\n(side-output of every securing act)"];
"observations.Fidelity" -> "T.ideate" [style=dashed, label="?"];
"questions.Disposition" -> "T.ideate" [style=dashed, label="?"];
"counterfactuals" -> "T.ideate" [style=dashed, label="?"];
"T.ideate" -> "claims.Evidence";
"T.ideate" -> "ledger.standing-surface";
"T.ideate" -> "accounts.Fidelity";
"claims.Evidence" -> "T.launch.math" [style=dashed, label="?"];
"T.launch.math" -> "line.math";
"claims.Evidence" -> "T.launch.sim" [style=dashed, label="?"];
"T.launch.sim" -> "line.sim";
"claims.Evidence" -> "T.launch.lit" [style=dashed, label="?"];
"T.launch.lit" -> "line.lit";
"claims.Evidence" -> "T.launch.testimony" [style=dashed, label="?"];
"T.launch.testimony" -> "line.testimony";
"claims.Evidence" -> "T.launch.analog" [style=dashed, label="?"];
"T.launch.analog" -> "line.analog";
"line.math" -> "T.secure*.math" [style=solid];
"T.secure*.math" -> "line.math";
"T.secure*.math" -> "accounts.Fidelity";
"line.sim" -> "T.secure*.sim" [style=solid];
"T.secure*.sim" -> "line.sim";
"T.secure*.sim" -> "accounts.Fidelity";
"line.lit" -> "T.secure*.lit" [style=solid];
"T.secure*.lit" -> "line.lit";
"T.secure*.lit" -> "accounts.Fidelity";
"line.testimony" -> "T.secure*.testimony" [style=solid];
"T.secure*.testimony" -> "line.testimony";
"T.secure*.testimony" -> "accounts.Fidelity";
"line.analog" -> "T.secure*.analog" [style=solid];
"T.secure*.analog" -> "line.analog";
"T.secure*.analog" -> "accounts.Fidelity";
"line.math" -> "T.conclude.math" [style=solid];
"T.conclude.math" -> "results";
"T.conclude.math" -> "questions.Disposition";
"line.sim" -> "T.conclude.sim" [style=solid];
"T.conclude.sim" -> "results";
"line.lit" -> "T.conclude.lit" [style=solid];
"T.conclude.lit" -> "results";
"line.testimony" -> "T.conclude.testimony" [style=solid];
"T.conclude.testimony" -> "results";
"line.analog" -> "T.feed-ideation.analog" [style=solid];
"T.feed-ideation.analog" -> "counterfactuals";
"T.feed-ideation.analog" -> "accounts.Fidelity";
"line.lit" -> "T.lit-informs-design" [style=dashed, label="?"];
"T.lit-informs-design" -> "counterfactuals";
"line.lit" -> "T.lit-scope-influence" [style=dashed, label="?"];
"T.lit-scope-influence" -> "questions.Disposition";
"results" -> "T.pay-in" [style=solid];
"ledger.standing-surface" -> "T.pay-in" [style=solid];
"T.pay-in" -> "ledger.standing-surface";
"ledger.standing-surface" -> "T.era-bump.k1-to-k2" [style=solid];
"T.era-bump.k1-to-k2" -> "ledger.standing-surface";
"T.era-bump.k1-to-k2" -> "expired.certificates";
"T.era-bump.k1-to-k2" -> "questions.Disposition";
"ledger.standing-surface" -> "T.reverify.lit-primary-fetched" [style=solid];
"T.reverify.lit-primary-fetched" -> "ledger.standing-surface";
"T.reverify.lit-primary-fetched" -> "accounts.Fidelity";
"ledger.standing-surface" -> "T.decide" [style=dashed, label="?"];
"T.decide" -> "decisions.Backing";
"ledger.standing-surface" -> "T.teach" [style=dashed, label="?"];
"T.teach" -> "pedagogy.Comprehension";
"decisions.Backing" -> "T.apply" [style=dashed, label="?"];
"T.apply" -> "observations.Fidelity";
}