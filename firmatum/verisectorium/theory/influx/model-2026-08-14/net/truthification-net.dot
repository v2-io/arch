digraph v3 {
rankdir=LR; ranksep=0.65; nodesep=0.32; fontsize=22; labelloc=t;
label="Truthification cycle v3 -- principled: mismatch-typed origination, analogy demoted to ideation, fan-out derived from declared foundation rungs, signed ladders, landing stage, structural return edges";
node [fontname="Helvetica" fontsize=11]; edge [fontname="Helvetica" fontsize=9 color="#555555"];
subgraph cluster_0 { label="ORIGINATE (two poles: corrective + generative pregenerators)"; style=rounded; color="#999999"; fontsize=14;
"signals.typed" [shape=ellipse style=filled fillcolor="#f9e0e0" label="signals.typed"];
"T.pose-question" [shape=box style=filled fillcolor="#cfcfcf" label="T.pose-question"];
"questions.Disposition" [shape=ellipse style=filled fillcolor="#dbe7f5" label="questions.Disposition"];
}
subgraph cluster_1 { label="IDEATE (generators + minting gate)"; style=rounded; color="#999999"; fontsize=14;
"T.analogize" [shape=box style=filled fillcolor="#e9dcc9" label="T.analogize"];
"T.counterfactualize" [shape=box style=filled fillcolor="#e9dcc9" label="T.counterfactualize"];
"frames.candidate" [shape=ellipse style=filled fillcolor="#eeeeee" label="frames.candidate"];
"T.mint" [shape=box style=filled fillcolor="#cfcfcf" label="T.mint\n[epistemic triage;\nrungs declared here]"];
"claims.Evidence" [shape=ellipse style=filled fillcolor="#dfeedd" label="claims.Evidence"];
}
subgraph cluster_2 { label="SECURE (lines derived from declared rungs; signed ladders)"; style=rounded; color="#999999"; fontsize=14;
"T.launch.derivation" [shape=box style=filled fillcolor="#cfcfcf" label="T.launch.derivation"];
"line.derivation" [shape=ellipse style=filled fillcolor="#e8f4f8" label="line.derivation\nfamily: derivation\nsketch > drafted > deps-verified > re-derived"];
"T.secure*.derivation" [shape=box style=filled fillcolor="#d7d7ee" label="T.secure*.derivation\nformal-expression-written\npremises-named-and-checked\nindependent-re-derivation"];
"T.launch.authored-world" [shape=box style=filled fillcolor="#cfcfcf" label="T.launch.authored-world"];
"line.authored-world" [shape=ellipse style=filled fillcolor="#e8f4f8" label="line.authored-world\nfamily: in-vivo-measurement\npre-registered > run-once > swept > independently-reproduced"];
"T.secure*.authored-world" [shape=box style=filled fillcolor="#d7d7ee" label="T.secure*.authored-world\nfirst-run (era-keyed)\nseed/level/footprint-sweep\nindependent-re-run"];
"T.launch.wild-empirical" [shape=box style=filled fillcolor="#cfcfcf" label="T.launch.wild-empirical"];
"line.wild-empirical" [shape=ellipse style=filled fillcolor="#e8f4f8" label="line.wild-empirical\nfamily: wild-measurement\nanecdotal > measured-once > population-robust > calibrated"];
"T.secure*.wild-empirical" [shape=box style=filled fillcolor="#d7d7ee" label="T.secure*.wild-empirical\nfirst-measurement\npopulation-sweep\ncalibration-events"];
"T.launch.instance-check" [shape=box style=filled fillcolor="#cfcfcf" label="T.launch.instance-check"];
"line.instance-check" [shape=ellipse style=filled fillcolor="#e8f4f8" label="line.instance-check\nfamily: model-instance\ncandidate-mapping > correspondence-verified > instance-prediction-checked"];
"T.secure*.instance-check" [shape=box style=filled fillcolor="#d7d7ee" label="T.secure*.instance-check\nmap-claim-onto-model\nverify-correspondence-by-perturbation"];
"T.launch.testimonial" [shape=box style=filled fillcolor="#cfcfcf" label="T.launch.testimonial"];
"line.testimonial" [shape=ellipse style=filled fillcolor="#e8f4f8" label="line.testimonial\nfamily: testimony\ncaptured > corroborated > cross-kind-corroborated"];
"T.secure*.testimonial" [shape=box style=filled fillcolor="#d7d7ee" label="T.secure*.testimonial\nindependent-account-located\nindependent-kind-agrees"];
"T.launch.transmission" [shape=box style=filled fillcolor="#cfcfcf" label="T.launch.transmission"];
"line.transmission" [shape=ellipse style=filled fillcolor="#e8f4f8" label="line.transmission\nfamily: transmission:wild-measurement\nnamed-not-read > recalled > search-corroborated > verified-via-secondary > primary-verified"];
"T.secure*.transmission" [shape=box style=filled fillcolor="#d7d7ee" label="T.secure*.transmission\nrecall-marked-as-recall\nconvergent-secondaries\nfaithful-secondary-fetched\nprimary-fetched"];
"T.refute.instance-check" [shape=box style=filled fillcolor="#f0c8c8" label="T.refute.instance-check\n[SIGNED channel]"];
"T.prior-art-informs" [shape=box style=filled fillcolor="#e9dcc9" label="T.prior-art-informs"];
"T.scope-influence" [shape=box style=filled fillcolor="#e9dcc9" label="T.scope-influence"];
}
