def decimal_digit_sets(by_cp: dict[int, dict]) -> list[dict]:
    """Nd 0–9 consecutive runs with lo < U+3000. Same definition Unicode uses for decimal digits."""
    zeros = []
    for cp in range(0x3000):
        ch = chr(cp)
        if unicodedata.category(ch) != "Nd":
            continue
        if unicodedata.decimal(ch, None) != 0:
            continue
        ok = all(
            unicodedata.category(chr(cp + i)) == "Nd" and unicodedata.decimal(chr(cp + i), None) == i
            for i in range(10)
        )
        if ok:
            zeros.append(cp)
    out = []
    for z in zeros:
        cps = list(range(z, z + 10))
        mem = [by_cp[c] for c in cps if c in by_cp]
        if len(mem) < 10:
            continue
        # order is digit value = cp - z
        dens = [m["_dens"] for m in mem]
        nums = list(range(len(mem)))
        name = unicodedata.name(chr(z), "").replace(" DIGIT ZERO", "").replace(" ", "-").lower() or f"nd-{z:04X}"
        out.append(
            {
                "id": f"digits-{name}",
                "kind": "number-system",
                "form": "positional-decimal",
                "rho_cp_density": rho_of([m["_cp"] for m in mem], dens),
                "rho_num_density": rho_of(nums, dens),
                "rho_order_density": rho_of(nums, dens),
                "n": len(mem),
                "lo": mem[0]["_cp"],
                "hi": mem[-1]["_cp"],
                "members": mem,
                "note": "positional decimal 0–9 (UCD Nd). LLM magnitude is the digit, not the ink.",
            }
        )
    return out


def fraction_sequence(by_cp: dict[int, dict]) -> list[dict]:
    mem = []
    for cp, row in by_cp.items():
        v = numeric_of(cp)
        if v is None or not (0 < v < 1):
            continue
        r = dict(row)
        r["_num"] = v
        mem.append(r)
    if len(mem) < 10:
        return []
    mem.sort(key=lambda r: (r["_num"], r["_cp"]))
    dens = [m["_dens"] for m in mem]
    nums = [m["_num"] for m in mem]
    return [
        {
            "id": "vulgar-fractions-by-value",
            "kind": "number-system",
            "form": "fraction",
            "rho_cp_density": rho_of([m["_cp"] for m in mem], dens),
            "rho_num_density": rho_of(nums, dens),
            "n": len(mem),
            "lo": mem[0]["_cp"],
            "hi": mem[-1]["_cp"],
            "members": mem,
            "note": "all UCD fractions in (0,1) on the keep-set, ordered by numeric value.",
        }
    ]


def ethiopic_sequence(by_cp: dict[int, dict]) -> list[dict]:
    cps = list(range(0x1369, 0x137D))
    mem = []
    for c in cps:
        if c not in by_cp:
            continue
        r = dict(by_cp[c])
        r["_num"] = numeric_of(c)
        mem.append(r)
    if len(mem) < 10:
        return []
    mem.sort(key=lambda r: (r["_num"] is None, r["_num"] or 0, r["_cp"]))
    dens = [m["_dens"] for m in mem]
    nums = [m["_num"] if m["_num"] is not None else 0 for m in mem]
    return [
        {
            "id": "ethiopic-numerals",
            "kind": "number-system",
            "form": "hybrid-myriad",
            "rho_cp_density": rho_of([m["_cp"] for m in mem], dens),
            "rho_num_density": rho_of(nums, dens),
            "n": len(mem),
            "lo": mem[0]["_cp"],
            "hi": mem[-1]["_cp"],
            "members": mem,
            "note": "Ethiopic 1–10 then 20–10000. LLM magnitude is the numeric value.",
        }
    ]


