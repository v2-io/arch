def dump_json(path: Path, sequences: list[dict], clusters: list[dict]) -> None:
    def slim(m):
        return {
            "cp": m["_cp"],
            "hex": m["hex"],
            "char": m.get("char") or "",
            "density": round(m["_dens"], 4),
            "bbox": round(float(m.get("_rel") or 0), 4),
            "family": m.get("_fam"),
            "sub": m.get("_sub"),
        }

    seq_j = []
    for s in sequences:
        rec = {k: v for k, v in s.items() if k not in {"members", "A_rows", "mag_rows"}}
        rec["members"] = [slim(m) for m in s["members"]]
        seq_j.append(rec)
    cl_j = []
    for cl in clusters:
        cl_j.append(
            {
                "id": cl["id"],
                "n": len(cl["members"]),
                "members": [slim(m) for m in cl["members"]],
            }
        )
    path.write_text(
        json.dumps({"sequences": seq_j, "clusters": cl_j}, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
    )


