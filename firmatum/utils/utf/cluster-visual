def is_counting(s: dict) -> bool:
    if s.get("kind") == "number-system":
        return True
    if s.get("form") in {"positional-decimal", "presentation", "additive", "fraction", "hybrid-myriad"}:
        return True
    sid = s.get("id") or ""
    if any(
        k in sid
        for k in (
            "circled",
            "parenthesized",
            "full-stop",
            "digit",
            "roman",
            "hex-",
            "ascii-digits",
            "subscript",
            "superscript",
            "zodiac",
            "ethiopic",
            "fraction",
            "dingbat",
        )
    ):
        return True
    mem = s.get("members") or []
    if not mem:
        return False
    n_num = sum(1 for m in mem if numeric_of(m["_cp"]) is not None)
    if n_num >= max(8, int(0.6 * len(mem))):
        return True
    # Enclosed Alphanumerics is an intrinsic series even when auto-windowed as cp-*
    if all(0x2460 <= m["_cp"] <= 0x24FF for m in mem):
        return True
    if all((m.get("block") or "") == "Enclosed Alphanumerics" for m in mem):
        return True
    return False


def lis_length(seq: list[int]) -> int:
    tails: list[int] = []
    for x in seq:
        i = bisect.bisect_left(tails, x)
        if i == len(tails):
            tails.append(x)
        else:
            tails[i] = x
    return len(tails)


def lcs_len(order_a: list[int], order_b: list[int]) -> int:
    pos = {cp: i for i, cp in enumerate(order_a)}
    return lis_length([pos[cp] for cp in order_b])


def linear_fit(y: list[float]) -> dict:
    n = len(y)
    if n < 2:
        return {"slope": 0.0, "r2": 0.0, "norm_slope": 0.0, "span": 0.0, "score": 0.0}
    yv = np.asarray(y, dtype=float)
    x = np.arange(n, dtype=float)
    xm, ym = float(x.mean()), float(yv.mean())
    varx = float(((x - xm) ** 2).sum())
    if varx < 1e-15:
        return {"slope": 0.0, "r2": 0.0, "norm_slope": 0.0, "span": 0.0, "score": 0.0}
    slope = float(((x - xm) * (yv - ym)).sum() / varx)
    yhat = ym + slope * (x - xm)
    ss_res = float(((yv - yhat) ** 2).sum())
    ss_tot = float(((yv - ym) ** 2).sum())
    r2 = 1.0 - ss_res / ss_tot if ss_tot > 1e-15 else 0.0
    span = float(yv.max() - yv.min())
    norm_slope = abs(slope) * (n - 1) / (span + 1e-15)
    return {
        "slope": slope,
        "r2": max(r2, 0.0),
        "norm_slope": norm_slope,
        "span": span,
        "score": span * max(r2, 0.0),
    }


def _cps_list(rows: list[dict]) -> list[int]:
    return [m["_cp"] for m in rows]


def analyze_rankings(s: dict) -> dict:
    """A=cp, B=intrinsic, C=density, D=area, E=√(C·D). B wins if present; else max score(C,D,E)."""
    mem = s["members"]
    n = len(mem)
    A = sorted(mem, key=lambda r: r["_cp"])
    A_cps = _cps_list(A)
    for m in mem:
        if "_e" not in m:
            m["_e"] = math.sqrt(max(m["_dens"], 0.0) * max(float(m.get("_rel") or 0), 0.0))

    b_exists = is_counting(s) or s.get("id") == "braille-by-popcount"
    if s.get("id") == "braille-by-popcount":
        B = sorted(mem, key=lambda r: (bin(r["_cp"] - 0x2800).count("1"), r["_cp"]))
        b_label = "B intrinsic popcount"
    elif b_exists:
        keyed = []
        for m in mem:
            v = m.get("_num")
            if v is None:
                v = numeric_of(m["_cp"])
            keyed.append((v is None, v if v is not None else 0.0, m["_cp"], m))
        keyed.sort()
        B = [m for _miss, _v, _cp, m in keyed]
        b_label = "B intrinsic numeric"
    else:
        B = None
        b_label = None

    C = sorted(mem, key=lambda r: (r["_dens"], r["_cp"]))
    D = sorted(mem, key=lambda r: (float(r.get("_rel") or 0), r["_cp"]))
    E = sorted(mem, key=lambda r: (r["_e"], r["_cp"]))

    def vs_A(rows: list[dict]) -> tuple[int, int]:
        fwd = lcs_len(A_cps, _cps_list(rows))
        rev = lcs_len(A_cps, list(reversed(_cps_list(rows))))
        return fwd, rev

    fit_C = linear_fit([m["_dens"] for m in C])
    fit_D = linear_fit([float(m.get("_rel") or 0) for m in D])
    fit_E = linear_fit([m["_e"] for m in E])
    lcs_CD_fwd = lcs_len(_cps_list(C), _cps_list(D))
    lcs_CD_rev = lcs_len(_cps_list(C), list(reversed(_cps_list(D))))

    if B is not None:
        choice, mag_rows, mag_label = "B", B, b_label
    else:
        scored = [("C", fit_C, C, "C density"), ("D", fit_D, D, "D area"), ("E", fit_E, E, "E √(C·D)")]
        choice, fit, mag_rows, mag_label = max(scored, key=lambda t: t[1]["score"])

    fwd, rev = vs_A(mag_rows)
    best_lcs = max(fwd, rev)
    moves = n - best_lcs
    moves_norm = moves / n if n else 0.0
    toward = "A" if fwd >= rev else "−A"
    collapsed = None
    if fwd == n:
        collapsed = "same"
    elif rev == n:
        collapsed = "reversed"

    lcs_A = {k: vs_A(rows) for k, rows in (("B", B or []), ("C", C), ("D", D), ("E", E))}
    if B is None:
        lcs_A["B"] = (0, 0)

    s["rank"] = {
        "n": n,
        "choice": choice,
        "mag_label": mag_label,
        "collapsed": collapsed,
        "lcs_A_mag": fwd,
        "lcs_A_mag_rev": rev,
        "best_lcs": best_lcs,
        "moves": moves,
        "moves_norm": moves_norm,
        "toward": toward,
        "lcs_A": {k: {"fwd": a, "rev": b} for k, (a, b) in lcs_A.items()},
        "lcs_CD": {"fwd": lcs_CD_fwd, "rev": lcs_CD_rev},
        "fit": {"C": fit_C, "D": fit_D, "E": fit_E},
        "b_exists": B is not None,
    }
    s["A_rows"] = A
    s["mag_rows"] = mag_rows
    s["mag"] = [choice]
    return s


def mag_pills(s: dict) -> str:
    r = s.get("rank") or {}
    ch = r.get("choice") or ""
    label = {"B": "intrinsic", "C": "density", "D": "size", "E": "√(C·D)"}.get(ch, ch)
    klass = {"B": "intrinsic", "C": "density", "D": "size", "E": "both"}.get(ch, "")
    bits = [f"<span class='pill {klass}'>{esc(label)}</span>"]
    if r.get("collapsed") == "same":
        bits.append("<span class='pill'>= A</span>")
    elif r.get("collapsed") == "reversed":
        bits.append("<span class='pill'>= reverse A</span>")
    return "".join(bits)


