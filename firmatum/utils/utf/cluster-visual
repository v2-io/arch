        "Subclusters are k-means inside the family — a slice, not the whole circle-like set.</p>"
    )
    fam_order = ["circle", "dot", "square", "bar", "fill", "multi-dot", "other", "empty"]
    by_fam_idx: dict[str, list] = defaultdict(list)
    by_cp_all: dict[int, dict] = {}
    for cl in clusters:
        fam = cl.get("family") or cl["id"].rsplit("-", 1)[0]
        by_fam_idx[fam].extend(cl["members"])
        for m in cl["members"]:
            by_cp_all[m["_cp"]] = m
    _write_pure_circles_page(out, by_cp_all)
    for fam in fam_order:
        members = by_fam_idx.get(fam) or []
        if not members:
            continue
        _write_family_page(out, fam, members)
        thumbs = sorted(members, key=lambda r: r["_dens"])
        step = max(1, len(thumbs) // 16)
        preview = thumbs[::step][:16]
        parts.append("<div class='index-row'>")
        parts.append(
            f"<div class='lab'><a href='family-{esc(fam)}.html'>all {esc(fam)}</a><br>"
            f"<span class='pill'>{len(members)}</span></div>"
        )
        parts.append("<div class='preview'>" + "".join(glyph_card(r) for r in preview) + "</div></div>")
    parts.append("<h3>k-means slices inside each family</h3>")
    for cl in clusters:
        thumbs = sorted(cl["members"], key=lambda r: r["_dens"])
        step = max(1, len(thumbs) // 12)
        preview = thumbs[::step][:12]
        rho = rho_of([m["_cp"] for m in thumbs], [m["_dens"] for m in thumbs])
        href = f"cluster-{cl['id']}.html"
        parts.append("<div class='index-row'>")
        parts.append(
            f"<div class='lab'><a href='{esc(href)}'>{esc(cl['id'])}</a><br>"
            f"<span class='pill'>{len(thumbs)}</span> {rho_span(rho)}</div>"
        )
        parts.append("<div class='preview'>" + "".join(glyph_card(r) for r in preview) + "</div></div>")
        _write_cluster_page(out, cl, rho)
    parts.append("</section></body></html>")
    (out / "index.html").write_text("".join(parts), encoding="utf-8")


def _cps(rows: list[dict]) -> tuple:
    return tuple(r["_cp"] for r in rows)


def _strip(rows: list[dict], limit: int | None, show_name: bool = False) -> str:
    shown = rows if limit is None else rows[:limit]
    html_s = "".join(glyph_card(r, show_name=show_name) for r in shown)
    extra = ""
    if limit is not None and len(rows) > limit:
        extra = f"<div class='g'><div class='k'>+{len(rows)-limit}</div></div>"
    return f"<div class='strip'>{html_s}{extra}</div>"


def _same_or_reversed(a: list[dict], b: list[dict]) -> str | None:
    ta, tb = _cps(a), _cps(b)
    if ta == tb:
        return "same"
    if ta == tuple(reversed(tb)):
        return "reversed"
    return None


def _orderings_for_seq(s: dict) -> list[tuple[str, list[dict]]]:
    """A on the left. Magnitude on the right only if it is not A and not reverse-A."""
    A = s.get("A_rows") or sorted(s["members"], key=lambda r: r["_cp"])
    mag = s.get("mag_rows")
    r = s.get("rank") or {}
    mag_label = r.get("mag_label") or "magnitude"
    if mag is None or r.get("collapsed") == "same":
        return [("A code point", A)]
    if r.get("collapsed") == "reversed":
        return [(f"A code point = reverse of {mag_label}", A)]
    return [("A code point", A), (mag_label, mag)]


def _raw_a(mem: list[dict]) -> str:
    A = sorted(mem, key=lambda r: r["_cp"])
    return "".join((r.get("char") or "") for r in A)


def _seq_block(s: dict, limit: int | None) -> str:
    mem = s["members"]
    rnk = s.get("rank") or {}
    norm = rnk.get("moves_norm")
    move_bit = f" <span class='n'>{norm:.2f}</span>" if norm is not None else ""
    bits = [
        f"<p class='raw-a'>{esc(_raw_a(s.get('A_rows') or mem))}</p>",
        f"<h3 id='{esc(s['id'])}'>{esc(s['id'])} <span class='pill'>{s['n']}</span> "
        f"{mag_pills(s)}<span class='pill'>{esc(s['kind'])}</span>{move_bit}</h3>"
    ]
    if s.get("note"):
        bits.append(f"<p class='meta'>{esc(s['note'])}</p>")
    orders = _orderings_for_seq(s)
    if len(orders) == 1:
        bits.append(_strip(orders[0][1], limit))
    else:
        bits.append("<div class='orders'>")
        for i, (label, rows) in enumerate(orders):
            if i == 1 and rnk and rnk.get("moves_norm") is not None:
                head = esc(rnk.get("mag_label") or "magnitude")
                bits.append(
                    f"<div><h4>{head} <span class='n'>{rnk['moves_norm']:.2f}</span></h4>{_strip(rows, limit)}</div>"
                )
            else:
                bits.append(f"<div><h4>{esc(label)}</h4>{_strip(rows, limit)}</div>")
        bits.append("</div>")
    if rnk:
        n = rnk["n"]
        fit = rnk["fit"]
        la = rnk["lcs_A"]
        cd = rnk["lcs_CD"]
        bits.append(
            "<p class='scores'>"
            f"LCS A {rnk['lcs_A_mag']}/{n} · −A {rnk['lcs_A_mag_rev']}/{n}"
            f" · B {la['B']['fwd']}/{n}"
            f" · C {la['C']['fwd']}/{n}"
            f" · D {la['D']['fwd']}/{n}"
            f" · E {la['E']['fwd']}/{n}"
            f" · C↔D {cd['fwd']}/{n}"
            f" · score C {fit['C']['score']:.3f} D {fit['D']['score']:.3f} E {fit['E']['score']:.3f}"
            f" · {rnk.get('moves', 0)}/{n} repositions"
            f" · chose {esc(rnk['choice'])}"
            "</p>"
        )
    return "".join(bits)


def _moves_vs_A(A: list[dict], rows: list[dict]) -> tuple[int, float]:
    n = len(A)
    if n == 0:
        return 0, 0.0
    A_cps = _cps_list(A)
    fwd = lcs_len(A_cps, _cps_list(rows))
    rev = lcs_len(A_cps, list(reversed(_cps_list(rows))))
    moves = n - max(fwd, rev)
    return moves, moves / n


def _sorted_strips(mem: list[dict], show_name: bool = True) -> str:
    """A, then D size, C density, E √(C·D). Score on D/C/E is repositions/n vs A or −A."""
    for m in mem:
        if "_e" not in m:
            m["_e"] = math.sqrt(max(m["_dens"], 0.0) * max(float(m.get("_rel") or 0), 0.0))
    A = sorted(mem, key=lambda r: r["_cp"])
    D = sorted(mem, key=lambda r: (float(r.get("_rel") or 0), r["_cp"]))
    C = sorted(mem, key=lambda r: (r["_dens"], r["_cp"]))
    E = sorted(mem, key=lambda r: (r["_e"], r["_cp"]))
    bits = [f"<p class='raw-a'>{esc(_raw_a(A))}</p>"]
    channels = [
        ("a", "A code point", A, False),
        ("d", "D size", D, True),
        ("c", "C density", C, True),
        ("e", "E √(C·D)", E, True),
    ]
    bits.append('<nav class="sorts">')
    for sid, label, rows, scored in channels:
        if scored:
            _mv, norm = _moves_vs_A(A, rows)
            bits.append(f"<a href='#{sid}'>{esc(label)} {norm:.2f}</a>")
        else:
            bits.append(f"<a href='#{sid}'>{esc(label)}</a>")
    bits.append("</nav>")
    for sid, label, rows, scored in channels:
        if scored:
            _mv, norm = _moves_vs_A(A, rows)
            bits.append(f"<h2 id='{sid}'>{esc(label)} <span class='n'>{norm:.2f}</span></h2>")
        else:
            bits.append(f"<h2 id='{sid}'>{esc(label)}</h2>")
        bits.append(_strip(rows, None, show_name=show_name))
    return "".join(bits)


def _write_cluster_page(out: Path, cl: dict, rho: float | None) -> None:
    mem = cl["members"]
    parts = [
        "<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'>",
