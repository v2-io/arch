def curated_sequences(by_cp: dict[int, dict]) -> list[dict]:
    out = []
    for sid, cps in CURATED:
        mem = [by_cp[c] for c in cps if c in by_cp]
        if len(mem) < 3:
            continue
        rho = rho_of([m["_cp"] for m in mem], [m["_dens"] for m in mem])
        dens = [m["_dens"] for m in mem]
        # designed order (the list order) vs density
        rho_ord = rho_of(list(range(len(mem))), dens)
        extra = {}
        if sid == "braille-by-cp":
            pop = [bin(m["_cp"] - 0x2800).count("1") for m in mem]
            extra["rho_popcount_density"] = rho_of(pop, dens)
            # popcount-sorted copy as a sibling sequence
        out.append(
            {
                "id": sid,
                "kind": "curated",
                "rho_cp_density": rho,
                "rho_order_density": rho_ord,
                "n": len(mem),
                "lo": mem[0]["_cp"],
                "hi": mem[-1]["_cp"],
                "members": mem,
                **extra,
            }
        )
        if sid == "braille-by-cp":
            ordered = sorted(mem, key=lambda m: (bin(m["_cp"] - 0x2800).count("1"), m["_cp"]))
            pop = [bin(m["_cp"] - 0x2800).count("1") for m in ordered]
            dens_o = [m["_dens"] for m in ordered]
            out.append(
                {
                    "id": "braille-by-popcount",
                    "kind": "curated-reorder",
                    "rho_cp_density": rho_of([m["_cp"] for m in ordered], dens_o),
                    "rho_popcount_density": rho_of(pop, dens_o),
                    "n": len(ordered),
                    "lo": ordered[0]["_cp"],
                    "hi": ordered[-1]["_cp"],
                    "members": ordered,
                    "note": "same 256, sorted by set-bit count then cp — the density gradient braille actually is",
                }
            )
    return out


