CP_HI = 0x3000
SKIP_RANGES = (
    (0x1100, 0x11FF),  # Hangul Jamo
    (0x2E80, 0x2FFF),  # CJK radicals / Kangxi / IDC
)

INK_T = 15.0 / 255.0
GRID = 8
N_ANG = 12
N_RAD = 6


def ang_uniformity(ang: np.ndarray) -> float:
    s = float(np.sum(ang))
    if s <= 0:
        return 0.0
    p = np.asarray(ang, dtype=np.float64) / s
    p = p[p > 0]
    ent = -float((p * np.log(p + 1e-12)).sum())
    return ent / math.log(max(len(ang), 2))


def cell_metrics():
    from AppKit import NSFont, NSAttributedString, NSFontAttributeName
    import CoreText

    font = NSFont.fontWithName_size_("VictorMono NFM SemiBold", 17.0 * 4)
    descent = CoreText.CTFontGetDescent(font)
    ascent = CoreText.CTFontGetAscent(font)
    leading = CoreText.CTFontGetLeading(font)
    face_h = ascent + descent + leading
    face_w = 0.0
    for i in range(32, 127):
        attr = NSAttributedString.alloc().initWithString_attributes_(
            chr(i), {NSFontAttributeName: font}
        )
        w = CoreText.CTLineGetTypographicBounds(
            CoreText.CTLineCreateWithAttributedString(attr), None, None, None
        )[0]
        if w > face_w:
            face_w = float(w)
    return int(round(face_w)), int(round(face_h))


def guide_red(rgb: np.ndarray) -> np.ndarray:
    return (
        (rgb[:, :, 0] > 180)
        & (rgb[:, :, 1] < 220)
        & (rgb[:, :, 2] < 220)
        & (rgb[:, :, 0] > rgb[:, :, 1] + 15)
    )


def coverage(arr: np.ndarray) -> np.ndarray:
    rgb = arr[:, :, :3]
    cov = (255.0 - rgb.min(axis=2).astype(np.float64)) / 255.0
    cov[guide_red(rgb)] = 0.0
    return cov


def origin_rect(cell_w: int, cell_h: int, px_w: int, px_h: int):
    ox = (px_w - 2 * cell_w) // 2
    oy = (px_h - cell_h) // 2
    x0 = ox
    x1 = ox + cell_w
    top = px_h - (oy + cell_h)
    bot = px_h - oy
    return x0, x1, top, bot


def skipped(cp: int) -> bool:
    if cp >= CP_HI:
        return True
    for a, b in SKIP_RANGES:
        if a <= cp <= b:
            return True
    return False


def load_keep(tsv: Path) -> list[dict]:
    rows = []
    with tsv.open(encoding="utf-8") as f:
        hdr = f.readline().rstrip("\n").split("\t")
        for line in f:
            cols = line.rstrip("\n").split("\t")
            r = dict(zip(hdr, cols))
            if r.get("packed_class") == "missing":
                continue
            cp = int(r["cp"])
            if skipped(cp):
                continue
            r["_cp"] = cp
            try:
                r["_dens"] = float(r["packed_density"])
            except (KeyError, ValueError):
                r["_dens"] = 0.0
            rows.append(r)
    return rows


def _safe_hu(ink: np.ndarray) -> np.ndarray:
    m = cv2.moments(ink.astype(np.uint8))
    hu = cv2.HuMoments(m).flatten()
    out = np.zeros(7, dtype=np.float64)
    for i, v in enumerate(hu):
        if v == 0 or not np.isfinite(v):
            out[i] = 0.0
        else:
            out[i] = math.copysign(math.log10(abs(v)), v)
    return out


def extract_one(path: Path, cell_w: int, cell_h: int) -> dict | None:
    if not path.is_file():
        return None
    im = np.array(Image.open(path).convert("RGBA"))
    h, w = im.shape[:2]
    cov = coverage(im)
    x0, x1, top, bot = origin_rect(cell_w, cell_h, w, h)
    x0, x1 = max(0, x0), min(w, x1)
    top, bot = max(0, top), min(h, bot)
    # Shape from all ink (overflow included). Size relative to origin cell.
    ink = cov > INK_T
    if not ink.any():
        grid = np.zeros((GRID, GRID), dtype=np.float32)
        return {
            "empty": True,
            "rel_size": 0.0,
            "bbox_w": 0.0,
            "bbox_h": 0.0,
            "aspect": 1.0,
            "circ": 0.0,
            "ecc": 0.0,
            "solidity": 0.0,
            "extent": 0.0,
            "n_cc": 0,
            "n_holes": 0,
            "max_cc_frac": 0.0,
            "cx": 0.5,
            "cy": 0.5,
            "ang": np.zeros(N_ANG, dtype=np.float32),
            "rad": np.zeros(N_RAD, dtype=np.float32),
            "ang_u": 0.0,
            "hu": np.zeros(7, dtype=np.float64),
            "grid": grid,
            "fill_cell": 0.0,
        }

    ys, xs = np.where(ink)
    bw = int(xs.max() - xs.min() + 1)
    bh = int(ys.max() - ys.min() + 1)
    cell_area = max(cell_w * cell_h, 1)
    rel_size = float(bw * bh) / cell_area
    bbox_w = float(bw) / max(cell_w, 1)
    bbox_h = float(bh) / max(cell_h, 1)
    aspect = float(bw) / max(bh, 1)
    cx = float(xs.mean()) / max(w, 1)
    cy = float(ys.mean()) / max(h, 1)

    labeled, n_cc = ndi.label(ink)
    sizes = ndi.sum(ink, labeled, index=range(1, n_cc + 1)) if n_cc else np.array([])
    ink_n = int(ink.sum())
    max_cc_frac = float(np.max(sizes) / ink_n) if ink_n and sizes.size else 0.0
    filled = ndi.binary_fill_holes(ink)
    hole_mask = filled & ~ink
    n_holes = int(ndi.label(hole_mask)[1]) if hole_mask.any() else 0

    pts = np.column_stack((xs, ys)).astype(np.float32)
    circ = 0.0
    solidity = 0.0
    extent = float(ink_n) / max(bw * bh, 1)
    ecc = 0.0
    if len(pts) >= 5:
        hull = cv2.convexHull(pts)
        perim = cv2.arcLength(hull, True)
        harea = cv2.contourArea(hull)
        if perim > 1e-6 and harea > 0:
            circ = float(4.0 * math.pi * harea / (perim * perim))
            circ = min(circ, 1.2)
            solidity = float(ink_n / harea) if harea else 0.0
        if len(pts) >= 5:
            try:
                (_c, _ax, _ang) = cv2.minAreaRect(pts)
                aa, bb = sorted(_ax)
                if bb > 1e-6:
                    ecc = float(math.sqrt(max(0.0, 1.0 - (aa / bb) ** 2)))
            except cv2.error:
                pass
    elif len(pts) >= 1:
        circ = 1.0
        solidity = 1.0

    # bbox-normalized occupancy
    y0, y1 = int(ys.min()), int(ys.max()) + 1
    x0b, x1b = int(xs.min()), int(xs.max()) + 1
    patch = cov[y0:y1, x0b:x1b].astype(np.float32)
    grid = cv2.resize(patch, (GRID, GRID), interpolation=cv2.INTER_AREA)

    # angular / radial around ink centroid, in bbox coords
    yy, xx = np.mgrid[0:patch.shape[0], 0:patch.shape[1]]
    cy_l = float((ys - y0).mean())
    cx_l = float((xs - x0b).mean())
    dx = xx - cx_l
    dy = yy - cy_l
    ang = (np.arctan2(dy, dx) + math.pi) / (2 * math.pi)  # 0..1
    dist = np.sqrt(dx * dx + dy * dy)
    dmax = dist[patch > INK_T].max() if (patch > INK_T).any() else 1.0
    dmax = max(float(dmax), 1e-6)
    weights = patch.clip(0, 1)
    ang_hist = np.zeros(N_ANG, dtype=np.float64)
    rad_hist = np.zeros(N_RAD, dtype=np.float64)
    ai = np.clip((ang * N_ANG).astype(int), 0, N_ANG - 1)
    ri = np.clip((dist / dmax * N_RAD).astype(int), 0, N_RAD - 1)
    for a in range(N_ANG):
        ang_hist[a] = float(weights[ai == a].sum())
    for r in range(N_RAD):
        rad_hist[r] = float(weights[ri == r].sum())
    if ang_hist.sum() > 0:
        ang_hist /= ang_hist.sum()
    if rad_hist.sum() > 0:
        rad_hist /= rad_hist.sum()
    ang_u = ang_uniformity(ang_hist)

    fill_cell = 0.0
    if x1 > x0 and bot > top:
        fill_cell = float(cov[top:bot, x0:x1].mean())

    return {
        "empty": False,
        "rel_size": rel_size,
        "bbox_w": bbox_w,
        "bbox_h": bbox_h,
        "aspect": aspect,
        "circ": circ,
        "ecc": ecc,
        "solidity": min(solidity, 2.0),
        "extent": extent,
        "n_cc": int(n_cc),
        "n_holes": int(n_holes),
        "max_cc_frac": max_cc_frac,
        "cx": cx,
        "cy": cy,
        "ang": ang_hist.astype(np.float32),
        "rad": rad_hist.astype(np.float32),
        "ang_u": ang_u,
        "hu": _safe_hu(ink),
        "grid": grid.astype(np.float32),
        "fill_cell": fill_cell,
    }


def family_of(f: dict) -> str:
    """Visual family from measurements. Order matters; first match wins."""
    if f["empty"] or f["rel_size"] < 1e-5:
        return "empty"
    circ = f["circ"]
    aspect = f["aspect"]
    tall = 1.0 / max(aspect, 1e-6)
    n_cc = f["n_cc"]
    n_holes = f["n_holes"]
    rel = f["rel_size"]
    uni = f.get("ang_u", 0.0)
    # cell-filling stipple / blocks (░▒▓█). Must beat "bar" because a terminal
    # cell is tall, so a full block is a rectangle. rel_size is *bbox* / cell —
    # letters often have a large bbox; require the bbox to actually reach the
    # cell edges, which shades and full blocks do and O / W do not.
    if rel >= 0.70 and f.get("fill_cell", 0.0) >= 0.15:
        return "fill"
    # single / double specks
    if rel < 0.045 and n_cc <= 2 and circ >= 0.65:
        return "dot"
    # scattered dots (braille, diaeresis, many-mark) — not one silhouette
    if n_cc >= 4 and f["max_cc_frac"] < 0.55:
        return "multi-dot"
    if n_cc >= 3 and rel < 0.18 and f["max_cc_frac"] < 0.5:
        return "multi-dot"
    # circle-like outer hull, including enclosed digits (hull is the ring).
    # A slightly squashed or hint-fitted circle in a cell often lands at
    # circ 0.80–0.91 — previously stolen by the square band (π/4 ≈ 0.785).
    if circ >= 0.83 and 0.55 <= aspect <= 1.85:
        return "circle"
    if n_holes >= 1 and circ >= 0.77 and 0.50 <= aspect <= 2.0:
        return "circle"
    if circ >= 0.80 and uni >= 0.85 and 0.60 <= aspect <= 1.70:
        return "circle"
    # square-ish hull (square circularity ≈ 0.785). Only after circles.
    if 0.70 <= circ < 0.83 and 0.75 <= aspect <= 1.35:
        return "square"
    # bars / rules
    if aspect >= 2.4 or tall >= 2.4:
        return "bar"
    if circ >= 0.50 and (aspect >= 1.85 or tall >= 1.85):
        return "bar"
    return "other"


def feat_vec(f: dict) -> np.ndarray:
    log_size = math.log10(f["rel_size"] + 1e-6)
    log_cc = math.log10(f["n_cc"] + 1.0)
    core = np.array(
        [
            log_size,
            math.log10(f["aspect"] + 1e-6),
            f["circ"],
            f["ecc"],
            f["solidity"],
            f["extent"],
            log_cc,
            min(f["n_holes"], 6) / 6.0,
            f["max_cc_frac"],
            f["cx"],
            f["cy"],
        ],
        dtype=np.float64,
    )
    return np.concatenate(
        [core, f["ang"].astype(np.float64), f["rad"].astype(np.float64), f["hu"], f["grid"].flatten().astype(np.float64)]
    )


def subcluster(members: list[dict], k_cap: int = 14) -> None:
    n = len(members)
    if n < 18:
        for m in members:
            m["_sub"] = 0
        return
    k = min(k_cap, max(2, n // 45))
    X = np.vstack([m["_vec"] for m in members])
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    Xs = StandardScaler().fit_transform(X)
    km = MiniBatchKMeans(n_clusters=k, random_state=0, batch_size=min(2048, n), n_init=8)
    labels = km.fit_predict(Xs)
    for m, lab in zip(members, labels):
        m["_sub"] = int(lab)


def numeric_of(cp: int) -> float | None:
    try:
        return float(unicodedata.numeric(chr(cp)))
    except (ValueError, TypeError):
        return None


def rho_of(xs, ys) -> float | None:
    if len(xs) < 4:
        return None
    if len(set(xs)) < 2 or len(set(ys)) < 2:
        return None
    rho, _p = spearmanr(xs, ys)
    if rho is None or (isinstance(rho, float) and math.isnan(rho)):
        return None
    return float(rho)


def contiguous_segments(rows: list[dict], max_gap: int = 1) -> list[list[dict]]:
    if not rows:
        return []
    rows = sorted(rows, key=lambda r: r["_cp"])
    segs = []
    cur = [rows[0]]
    for prev, nxt in zip(rows, rows[1:]):
        if nxt["_cp"] - prev["_cp"] <= max_gap:
            cur.append(nxt)
        else:
            segs.append(cur)
            cur = [nxt]
    segs.append(cur)
    return segs


def windows_monotonic(seg: list[dict], min_n: int = 10, min_abs_rho: float = 0.80) -> list[dict]:
    """Longest subarrays of a contiguous cp run with |ρ| high. Prefers 10/12/16+ over n=6."""
    n = len(seg)
    if n < min_n:
        return []
    found: list[tuple[int, int, float]] = []
    # Discrete arities (10/12/16/20…) plus the full run. Every length is too slow
    # and prefers the short windows Joseph already has enough of.
    lengths = [L for L in (10, 12, 16, 20, 24, 32, 40, 48, 64, n) if min_n <= L <= n]
    lengths = sorted(set(lengths), reverse=True)
    for length in lengths:
        local = []
        for i in range(0, n - length + 1):
            sl = seg[i : i + length]
            rho = rho_of([r["_cp"] for r in sl], [r["_dens"] for r in sl])
            if rho is None or abs(rho) < min_abs_rho:
                continue
            local.append((i, i + length, rho))
        if not local:
            continue
        local.sort(key=lambda t: -abs(t[2]))
        used = np.zeros(n, dtype=bool)
        for a, b, rho in found:
            used[a:b] = True
        for a, b, rho in local:
            if used[a:b].any():
                continue
            found.append((a, b, rho))
            used[a:b] = True
    out = []
    for a, b, rho in sorted(found, key=lambda t: t[0]):
        sl = seg[a:b]
        out.append(
            {
                "id": f"cp-{sl[0]['_cp']:04X}-{sl[-1]['_cp']:04X}",
                "kind": "cp-monotonic",
                "rho_cp_density": rho,
                "n": len(sl),
                "lo": sl[0]["_cp"],
                "hi": sl[-1]["_cp"],
                "members": sl,
            }
        )
    return out


def dens_span(members: list[dict]) -> float:
    ds = [m["_dens"] for m in members]
    return max(ds) - min(ds) if ds else 0.0


def numeric_sequences(family: str, members: list[dict], min_n: int = 4) -> list[dict]:
    scored = []
    for m in members:
        v = numeric_of(m["_cp"])
        if v is None:
            continue
        m = dict(m)
        m["_num"] = v
        scored.append(m)
    if len(scored) < min_n:
        return []
    # group by roughly-same visual subcluster so ① and Ⅶ don't mix
    by_sub = defaultdict(list)
    for m in scored:
        by_sub[m.get("_sub", 0)].append(m)
    seqs = []
    # also one family-wide numeric sequence if values look like a counting run
    for key, group in [("*", scored), *by_sub.items()]:
        if len(group) < min_n:
            continue
        group = sorted(group, key=lambda r: (r["_num"], r["_cp"]))
        vals = [g["_num"] for g in group]
        # drop huge-sparse cultural numerals (CJK-style 10000) — keep if many small ints
        small = [g for g in group if 0 <= g["_num"] <= 50 and g["_num"] == int(g["_num"])]
        if len(small) >= min_n:
            group = sorted(small, key=lambda r: (r["_num"], r["_cp"]))
            vals = [g["_num"] for g in group]
        rho_n = rho_of(vals, [g["_dens"] for g in group])
        rho_c = rho_of([g["_cp"] for g in group], [g["_dens"] for g in group])
        uniq = len(set(vals))
        if uniq < min_n:
            continue
        # family-wide dumps mix every numeral that happens to look circular.
        # Keep a subcluster series only if it is small and actually a count, or
        # if numeric value tracks density.
        if key == "*":
            continue
        if dens_span(group) < 0.02:
            continue
        if not (uniq <= 40 and (rho_n is not None and abs(rho_n) >= 0.45 or uniq <= 20)):
            if not (rho_c is not None and abs(rho_c) >= 0.75):
                continue
        sid = f"num-{family}-{key}"
        seqs.append(
            {
                "id": sid,
                "kind": "numeric-in-family",
                "family": family,
                "rho_num_density": rho_n,
                "rho_cp_density": rho_c,
                "n": len(group),
                "lo": group[0]["_cp"],
                "hi": group[-1]["_cp"],
                "members": group,
            }
        )
    return seqs


