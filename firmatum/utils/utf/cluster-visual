def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--tsv", type=Path, default=TSV)
    ap.add_argument("--out", type=Path, default=HERE / "gallery")
    args = ap.parse_args()

    if not PACKED.is_dir():
        sys.exit(f"no packed rasters at {PACKED}")
    rows = load_keep(args.tsv)
    print(f"keep {len(rows)} glyphs (cp < U+3000, no Hangul Jamo / CJK radicals)", file=sys.stderr)
    cell_w, cell_h = cell_metrics()
    print(f"cell {cell_w}×{cell_h}", file=sys.stderr)

    feats_ok = 0
    for i, r in enumerate(rows):
        rel = raster_rel(r)
        p = HERE / rel
        f = extract_one(p, cell_w, cell_h)
        if f is None:
            f = extract_one(PACKED / f"{r['_cp']:04x}"[:2] / f"{r['_cp']:04x}.png", cell_w, cell_h)
        if f is None:
            r["_fam"] = "empty"
            r["_vec"] = np.zeros(11 + N_ANG + N_RAD + 7 + GRID * GRID)
            r["_feat"] = {"empty": True, "rel_size": 0, "bbox_w": 0, "bbox_h": 0, "circ": 0, "aspect": 1, "n_cc": 0, "n_holes": 0, "max_cc_frac": 0}
            r["_rel"] = r["_bw"] = r["_bh"] = r["_e"] = 0.0
            continue
        r["_feat"] = f
        r["_fam"] = family_of(f)
        r["_vec"] = feat_vec(f)
        r["_rel"] = float(f.get("rel_size") or 0)
        r["_bw"] = float(f.get("bbox_w") or 0)
        r["_bh"] = float(f.get("bbox_h") or 0)
        r["_e"] = math.sqrt(max(r["_dens"], 0.0) * max(r["_rel"], 0.0))
        feats_ok += 1
        if (i + 1) % 1000 == 0:
            print(f"  features {i+1}/{len(rows)}", file=sys.stderr)
    print(f"featured {feats_ok}/{len(rows)}", file=sys.stderr)

    by_fam: dict[str, list[dict]] = defaultdict(list)
    for r in rows:
        by_fam[r["_fam"]].append(r)
    print("families:", {k: len(v) for k, v in sorted(by_fam.items(), key=lambda kv: -len(kv[1]))}, file=sys.stderr)

    clusters = []
    for fam, members in sorted(by_fam.items(), key=lambda kv: (kv[0] != "circle", -len(kv[1]))):
        subcluster(members)
        by_sub = defaultdict(list)
        for m in members:
            by_sub[m["_sub"]].append(m)
        for sub, group in sorted(by_sub.items(), key=lambda kv: -len(kv[1])):
            cid = f"{fam}-{sub}"
            clusters.append({"id": cid, "family": fam, "sub": sub, "members": group})

    print(f"{len(clusters)} subclusters", file=sys.stderr)
    print("probe (hex → family-sub, circ, rel_size, n_cc, n_holes):", file=sys.stderr)
    by_cp = {r["_cp"]: r for r in rows}
    for cp, label in PROBE.items():
        r = by_cp.get(cp)
        if not r:
            print(f"  missing {label} U+{cp:04X}", file=sys.stderr)
            continue
        f = r["_feat"]
        print(
            f"  U+{cp:04X} {label:28s}  {r['_fam']}-{r.get('_sub',0)}  "
            f"circ={f.get('circ',0):.3f} rel={f.get('rel_size',0):.3f} "
            f"cc={f.get('n_cc',0)} holes={f.get('n_holes',0)} dens={r['_dens']:.3f}",
            file=sys.stderr,
        )

    sequences: list[dict] = []
    sequences.extend(curated_sequences(by_cp))
    sequences.extend(decimal_digit_sets(by_cp))
    sequences.extend(fraction_sequence(by_cp))
    sequences.extend(ethiopic_sequence(by_cp))
    sequences.extend(roman_full_sequence(by_cp))
    symbolish = [r for r in rows if is_symbolish(r)]
    for fam, members in by_fam.items():
        sequences.extend(numeric_sequences(fam, members))
        fam_sym = [m for m in members if is_symbolish(m)]
        for seg in contiguous_segments(fam_sym, max_gap=1):
            for w in windows_monotonic(seg, min_n=10, min_abs_rho=0.80):
                if dens_span(w["members"]) < 0.04:
                    continue
                sequences.append(w)
    for seg in contiguous_segments(symbolish, max_gap=1):
        for w in windows_monotonic(seg, min_n=10, min_abs_rho=0.88):
            if dens_span(w["members"]) < 0.05:
                continue
            w["id"] = "all-" + w["id"]
            w["kind"] = "cp-monotonic-global"
            sequences.append(w)

    # de-dup sequences with identical member cps
    seen = set()
    uniq = []
    for s in sequences:
        key = tuple(m["_cp"] for m in s["members"])
        if key in seen:
            continue
        seen.add(key)
        uniq.append(s)
    sequences = uniq
    n_bonus = sum(1 for s in sequences if s.get("rho_cp_density") is not None and abs(s["rho_cp_density"]) >= 0.75)
    print(f"{len(sequences)} sequences, {n_bonus} with |ρ(cp,dens)|≥0.75", file=sys.stderr)

    args.out.mkdir(parents=True, exist_ok=True)
    (args.out / "data").mkdir(exist_ok=True)
    for s in sequences:
        analyze_rankings(s)
    dump_json(args.out / "data" / "gallery.json", sequences, clusters)
    write_html(args.out, by_fam, clusters, sequences)
    print(f"wrote {args.out / 'index.html'}", file=sys.stderr)


if __name__ == "__main__":
    main()
