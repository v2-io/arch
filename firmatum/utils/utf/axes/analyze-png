#!/usr/bin/env python3
"""Ink-grid features from the *other track's* packed Ghostty rasters.

Does not re-paint. Reads `.rasters/4x/packed/HH/HHHH.png` written by
`measure-ghostty`. Zeros the red cell guides (same test as recount-density),
crops the origin cell, downsamples to 16×16 occupancy, difference-hashes, and
MiniBatchKMeans-clusters (visual-only). Known Unicode structure is applied in
`enrich-shape` (braille bits, designed fill, Ghostty packed_density, name tags).

Join key: hex (U+HHHH). Cluster labels are majority Unicode-block of members,
not invented names — disagreement with block/number-system is the signal.

Writes:
  data/png-features.tsv
  data/png-clusters.json
"""

from __future__ import annotations

import json
import sys
import unicodedata
from collections import Counter, defaultdict
from pathlib import Path

import numpy as np
from PIL import Image
from sklearn.cluster import MiniBatchKMeans

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
OUT = HERE / "data"
PACKED = ROOT / ".rasters" / "4x" / "packed"

N_CLUSTERS = 64
GRID = 16


def cell_metrics():
    from AppKit import NSFont, NSAttributedString, NSFontAttributeName
    import CoreText

    font = NSFont.fontWithName_size_("VictorMono NFM SemiBold", 17.0 * 4)
    descent = CoreText.CTFontGetDescent(font)
    ascent = CoreText.CTFontGetAscent(font)
    leading = CoreText.CTFontGetLeading(font)
    face_h = ascent + descent + leading
    face_w = 0.0
    for i in range(32, 127):
        attr = NSAttributedString.alloc().initWithString_attributes_(
            chr(i), {NSFontAttributeName: font}
        )
        w = CoreText.CTLineGetTypographicBounds(
            CoreText.CTLineCreateWithAttributedString(attr), None, None, None
        )[0]
        if w > face_w:
            face_w = float(w)
    return int(round(face_w)), int(round(face_h))


def guide_red(rgb: np.ndarray) -> np.ndarray:
    return (
        (rgb[:, :, 0] > 180)
        & (rgb[:, :, 1] < 220)
        & (rgb[:, :, 2] < 220)
        & (rgb[:, :, 0] > rgb[:, :, 1] + 15)
    )


def coverage(arr: np.ndarray) -> np.ndarray:
    rgb = arr[:, :, :3]
    cov = (255.0 - rgb.min(axis=2).astype(np.float64)) / 255.0
    cov[guide_red(rgb)] = 0.0
    return cov


def origin_rect(cell_w: int, cell_h: int, px_w: int, px_h: int):
    ox = (px_w - 2 * cell_w) // 2
    oy = (px_h - cell_h) // 2
    x0 = ox
    x1 = ox + cell_w
    top = px_h - (oy + cell_h)
    bot = px_h - oy
    return x0, x1, top, bot


def dhash64(grid: np.ndarray) -> str:
    """8×8 difference hash from a 16×16 occupancy, as 16 hex chars."""
    small = grid.reshape(8, 2, 8, 2).mean(axis=(1, 3))
    bits = (small[:, 1:] > small[:, :-1]).flatten()  # 8*7 = 56
    # pad to 64 with vertical diffs of first column
    vbits = (small[1:, 0] > small[:-1, 0])  # 7
    extra = np.array([small.mean() > 0.05], dtype=bool)
    bits = np.concatenate([bits, vbits, extra])[:64]
    n = 0
    for b in bits:
        n = (n << 1) | int(b)
    return f"{n:016x}"


def grid_hex(grid: np.ndarray) -> str:
    bits = (grid > 0.08).flatten()
    n = 0
    # 256 bits → 64 hex chars
    for b in bits:
        n = (n << 1) | int(b)
    return f"{n:064x}"


def main() -> None:
    OUT.mkdir(parents=True, exist_ok=True)
    if not PACKED.is_dir():
        sys.exit(f"no packed rasters at {PACKED}")

    cell_w, cell_h = cell_metrics()
    print(f"cell {cell_w}×{cell_h}", file=sys.stderr)

    paths = sorted(PACKED.glob("*/*.png"))
    print(f"{len(paths)} packed PNGs", file=sys.stderr)

    recs = []
    grids = []
    for i, p in enumerate(paths):
        try:
            cp = int(p.stem, 16)
        except ValueError:
            continue
        im = np.array(Image.open(p).convert("RGBA"))
        h, w = im.shape[:2]
        x0, x1, top, bot = origin_rect(cell_w, cell_h, w, h)
        x0, x1 = max(0, x0), min(w, x1)
        top, bot = max(0, top), min(h, bot)
        cov = coverage(im)
        cell = cov[top:bot, x0:x1]
        if cell.size == 0:
            continue
        # 16×16 mean occupancy
        ys = np.linspace(0, cell.shape[0], GRID + 1, dtype=int)
        xs = np.linspace(0, cell.shape[1], GRID + 1, dtype=int)
        g = np.zeros((GRID, GRID), dtype=np.float32)
        for yi in range(GRID):
            for xi in range(GRID):
                patch = cell[ys[yi] : ys[yi + 1], xs[xi] : xs[xi + 1]]
                g[yi, xi] = float(patch.mean()) if patch.size else 0.0
        ink = cell > 15.0 / 255.0
        if ink.any():
            ys_i, xs_i = np.where(ink)
            cx = float(xs_i.mean()) / max(cell.shape[1], 1)
            cy = float(ys_i.mean()) / max(cell.shape[0], 1)
            bw = float(xs_i.max() - xs_i.min() + 1) / max(cell.shape[1], 1)
            bh = float(ys_i.max() - ys_i.min() + 1) / max(cell.shape[0], 1)
            fill = float(ink.mean())
        else:
            cx = cy = bw = bh = fill = 0.0
        recs.append(
            {
                "cp": cp,
                "hex": f"U+{cp:04X}",
                "fill": fill,
                "cx": cx,
                "cy": cy,
                "bbox_w": bw,
                "bbox_h": bh,
                "aspect": (bw / bh) if bh > 1e-6 else 0.0,
                "dhash": dhash64(g),
                "grid16": grid_hex(g),
            }
        )
        grids.append(g.flatten())
        if (i + 1) % 4000 == 0:
            print(f"  {i+1}/{len(paths)}", file=sys.stderr)

    if not recs:
        sys.exit("no features")

    X = np.vstack(grids)
    k = min(N_CLUSTERS, len(recs))
    print(f"k-means k={k} on {X.shape}", file=sys.stderr)
    km = MiniBatchKMeans(n_clusters=k, random_state=0, batch_size=2048, n_init=3)
    labels = km.fit_predict(X)

    # majority block per cluster (from unicodedata name / our axes if present)
    axes = {}
    axes_path = OUT / "unicode-axes.tsv"
    if axes_path.is_file():
        with axes_path.open(encoding="utf-8") as f:
            hdr = f.readline().rstrip("\n").split("\t")
            hi = hdr.index("hex")
            bi = hdr.index("block")
            si = hdr.index("number_system") if "number_system" in hdr else None
            gi = hdr.index("gradient_family") if "gradient_family" in hdr else None
            n = len(hdr)
            for line in f:
                cols = line.rstrip("\n").split("\t")
                if len(cols) < n:
                    continue
                axes[cols[hi]] = {
                    "block": cols[bi],
                    "number_system": cols[si] if si is not None else "",
                    "gradient_family": cols[gi] if gi is not None else "",
                }

    members: dict[int, list[int]] = defaultdict(list)
    for rec, lab in zip(recs, labels):
        rec["cluster"] = int(lab)
        members[int(lab)].append(rec["cp"])

    clusters = []
    for lab in range(k):
        cps = members.get(lab, [])
        if not cps:
            continue
        blocks = Counter()
        systems = Counter()
        grads = Counter()
        for cp in cps:
            hx = f"U+{cp:04X}"
            info = axes.get(hx, {})
            if info.get("block"):
                blocks[info["block"]] += 1
            else:
                # fallback: unicode name prefix
                try:
                    blocks[unicodedata.name(chr(cp)).split()[0]] += 1
                except ValueError:
                    pass
            if info.get("number_system"):
                systems[info["number_system"]] += 1
            if info.get("gradient_family"):
                grads[info["gradient_family"]] += 1
        maj_block, maj_n = blocks.most_common(1)[0] if blocks else ("", 0)
        # representative: closest to centroid
        idxs = [i for i, rec in enumerate(recs) if rec["cluster"] == lab]
        sub = X[idxs]
        d = ((sub - km.cluster_centers_[lab]) ** 2).sum(axis=1)
        rep_i = idxs[int(d.argmin())]
        clusters.append(
            {
                "cluster": lab,
                "n": len(cps),
                "majority_block": maj_block,
                "majority_block_frac": round(maj_n / len(cps), 3) if cps else 0,
                "number_systems": systems.most_common(5),
                "gradients": grads.most_common(5),
                "representative": recs[rep_i]["hex"],
                "sample": [f"U+{cp:04X}" for cp in cps[:24]],
            }
        )

    feat_tsv = OUT / "png-features.tsv"
    cols = [
        "cp",
        "hex",
        "cluster",
        "fill",
        "cx",
        "cy",
        "bbox_w",
        "bbox_h",
        "aspect",
        "dhash",
        "grid16",
    ]
    with feat_tsv.open("w", encoding="utf-8") as f:
        f.write("\t".join(cols) + "\n")
        for rec in recs:
            f.write(
                "\t".join(
                    [
                        str(rec["cp"]),
                        rec["hex"],
                        str(rec["cluster"]),
                        f"{rec['fill']:.4f}",
                        f"{rec['cx']:.4f}",
                        f"{rec['cy']:.4f}",
                        f"{rec['bbox_w']:.4f}",
                        f"{rec['bbox_h']:.4f}",
                        f"{rec['aspect']:.4f}",
                        rec["dhash"],
                        rec["grid16"],
                    ]
                )
                + "\n"
            )

    (OUT / "png-clusters.json").write_text(
        json.dumps(
            {
                "k": k,
                "n": len(recs),
                "grid": GRID,
                "note": (
                    "Clusters are k-means on 16×16 origin-cell occupancy of "
                    "Ghostty packed rasters. majority_block is a description of "
                    "the members, not a claim that the cluster *is* that block. "
                    "Low majority_block_frac is the interesting case."
                ),
                "clusters": clusters,
            },
            ensure_ascii=False,
            indent=2,
        )
        + "\n",
        encoding="utf-8",
    )
    print(f"wrote {feat_tsv} ({len(recs)} rows)")
    print(f"wrote {OUT / 'png-clusters.json'} ({k} clusters)")


if __name__ == "__main__":
    main()
