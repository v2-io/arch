def presentation_from_name(name: str) -> str:
    n = name.upper()
    if n.startswith("NEGATIVE CIRCLED") or "NEGATIVE CIRCLED" in n:
        return "negative-circled"
    if "DOUBLE CIRCLED" in n:
        return "double-circled"
    if n.startswith("CIRCLED") or " CIRCLED " in n:
        return "circled"
    if "PARENTHESIZED" in n:
        return "parenthesized"
    if "FULL STOP" in n and ("DIGIT" in n or "NUMBER" in n):
        return "dotted"
    if n.startswith("SUPERSCRIPT") or "SUPERSCRIPT " in n:
        return "superscript"
    if n.startswith("SUBSCRIPT") or "SUBSCRIPT " in n:
        return "subscript"
    if "FULLWIDTH" in n:
        return "fullwidth"
    if "DINGBAT" in n and "CIRCLED" in n:
        return "dingbat-circled"
    if "SANS-SERIF" in n and "CIRCLED" in n:
        return "circled-sans"
    if "IDEOGRAPH" in n and "CIRCLED" in n:
        return "circled"
    return ""


