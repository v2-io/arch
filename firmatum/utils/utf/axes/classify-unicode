#!/usr/bin/env python3
"""Classify BMP code points into number-system and gradient axes.

Unicode 14.0.0 (this machine's unicodedata). Auto-detects positional-decimal
Nd 0–9 runs from UCD; overlays curated systems (Roman, CJK, Suzhou, Ethiopic,
presentation series, cultural ciphered alphabets that UCD does not mark
numeric). Gradients: block-fill (specific), shade, braille (derived density),
quadrants, stars.

Writes:
  data/unicode-axes.tsv
  data/number-systems.json
  data/gradients.json

Does not touch parent-directory paint metrics.
"""

from __future__ import annotations

import json
import re
import unicodedata
from collections import defaultdict
from pathlib import Path

HERE = Path(__file__).resolve().parent
UCD = HERE / "ucd"
