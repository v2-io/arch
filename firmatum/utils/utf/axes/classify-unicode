# ---------------------------------------------------------------------------
# UCD loaders
# ---------------------------------------------------------------------------


def parse_blocks(path: Path) -> list[tuple[int, int, str]]:
    blocks = []
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.split("#", 1)[0].strip()
        if not line or ".." not in line:
            continue
        rng, name = line.split(";", 1)
        a, b = rng.split("..")
        blocks.append((int(a, 16), int(b, 16), name.strip()))
    return blocks


def parse_scripts(path: Path) -> list[tuple[int, int, str]]:
    scripts = []
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.split("#", 1)[0].strip()
        if not line or ";" not in line:
            continue
        rng, name = line.split(";", 1)
        name = name.strip()
        if ".." in rng:
            a, b = rng.split("..")
            lo, hi = int(a, 16), int(b, 16)
        else:
            lo = hi = int(rng.strip(), 16)
        scripts.append((lo, hi, name))
    scripts.sort()
    return scripts


def lookup_range(table: list[tuple[int, int, str]], cp: int, default: str) -> str:
    # linear is fine at 200 blocks; scripts is ~hundreds of ranges
    for lo, hi, name in table:
        if lo <= cp <= hi:
            return name
        if lo > cp:
            break
    return default


# ---------------------------------------------------------------------------
# Numeric type from Python UCD (Unicode 14)
# ---------------------------------------------------------------------------


def numeric_type(ch: str) -> str:
    if unicodedata.decimal(ch, None) is not None:
        return "decimal"
    if unicodedata.digit(ch, None) is not None:
        return "digit"
    try:
        unicodedata.numeric(ch)
        return "numeric"
    except ValueError:
        return "none"


def numeric_value(ch: str) -> str:
    try:
        v = unicodedata.numeric(ch)
    except ValueError:
        return ""
    if v == int(v):
        return str(int(v))
    return repr(v)


# ---------------------------------------------------------------------------
# Auto positional-decimal digit sets (Unicode's own definition)
# ---------------------------------------------------------------------------


def discover_decimal_sets() -> list[dict]:
    """Runs of 10 consecutive Nd with decimal values 0..9."""
    zeros = []
    for cp in range(0x10000):
        ch = chr(cp)
        if unicodedata.category(ch) != "Nd":
            continue
        if unicodedata.decimal(ch, None) != 0:
            continue
        ok = True
        for i in range(10):
            c2 = chr(cp + i)
            if unicodedata.category(c2) != "Nd" or unicodedata.decimal(c2, None) != i:
                ok = False
                break
        if ok:
            zeros.append(cp)
    sets = []
    for z in zeros:
        name0 = unicodedata.name(chr(z))
        prefix = re.sub(r" DIGIT ZERO$", "", name0)
        slug = re.sub(r"[^a-z0-9]+", "-", prefix.lower()).strip("-") or "decimal"
        if slug in {"digit", "digit-zero"} or name0 == "DIGIT ZERO":
            slug = "ascii-decimal"
            prefix = "ASCII"
        elif slug in {"fullwidth", "fullwidth-digit"}:
            slug = "fullwidth-decimal"
        form = "positional-decimal"
        presentation = ""
        if "fullwidth" in slug:
            form = "positional-decimal"
            presentation = "fullwidth"
        sets.append(
            {
                "id": slug,
                "form": form,
                "role": "digit",
                "presentation": presentation,
                "ucd_numeric": True,
                "lo": z,
                "hi": z + 9,
                "zero": z,
                "label": prefix,
                "notes": (
                    "UCD Numeric_Type=Decimal; 10 consecutive digits 0–9. "
                    "Place-value radix-10 repertoire."
                    + (
                        " Compatibility fullwidth presentation of ASCII decimal."
                        if presentation == "fullwidth"
                        else ""
                    )
                ),
            }
        )
    return sets


