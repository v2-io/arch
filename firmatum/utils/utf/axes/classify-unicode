# Quadrants: 4 bits, UL=1 UR=2 LL=4 LR=8 matching Unicode names.
# 2596 LOWER LEFT, 2597 LOWER RIGHT, 2598 UPPER LEFT, 2599 UL+LL+LR,
# 259A UL+LR, 259B UL+UR+LL, 259C UR+LL+LR, 259D UPPER RIGHT,
# 259E UR+LL, 259F UR+LL+LR wait — encode from names at runtime.


def quadrant_bits(name: str) -> int | None:
    if "QUADRANT" not in name:
        return None
    bits = 0
    # Unicode names list which quadrants are present.
    # "QUADRANT UPPER LEFT AND LOWER LEFT AND LOWER RIGHT"
    rest = name.split("QUADRANT", 1)[1]
    if "UPPER LEFT" in rest:
        bits |= 1
    if "UPPER RIGHT" in rest:
        bits |= 2
    if "LOWER LEFT" in rest:
        bits |= 4
    if "LOWER RIGHT" in rest:
        bits |= 8
    return bits


# Braille dots 1–8: bit0=dot1 … bit7=dot8. Pattern = cp - 0x2800.


def braille_param(cp: int) -> dict:
    bits = cp - 0x2800
    dots = [i + 1 for i in range(8) if bits & (1 << i)]
    return {
        "bits": bits,
        "dots": dots,
        "popcount": len(dots),
        "density": round(len(dots) / 8, 4),
    }


# ---------------------------------------------------------------------------
# Classification of one CP
# ---------------------------------------------------------------------------


def classify_one(
    cp: int,
    blocks,
    scripts,
    decimal_sets: list[dict],
    decimal_index: dict[int, dict],
) -> dict:
    ch = chr(cp)
    cat = unicodedata.category(ch)
    try:
        name = unicodedata.name(ch)
    except ValueError:
        name = ""
    block = lookup_range(blocks, cp, "")
    script = lookup_range(scripts, cp, "Unknown")
    nt = numeric_type(ch)
    nv = numeric_value(ch)

    rec = {
        "cp": str(cp),
        "hex": f"U+{cp:04X}",
        "char": "" if cat in {"Cc", "Cf", "Zl", "Zp"} else ch,
        "name": name,
        "category": cat,
        "block": block,
        "script": script,
        "numeric_type": nt,
        "numeric_value": nv,
        "number_system": "",
        "number_form": "",
        "number_role": "",
        "presentation": "",
        "ucd_numeric": "yes" if nt != "none" else "no",
        "gradient_family": "",
        "gradient_kind": "",
        "gradient_axis": "",
        "gradient_value": "",
        "gradient_param": "",
        "structured_family": "",
    }

    # --- number systems ---
    if cp in decimal_index:
        s = decimal_index[cp]
        rec["number_system"] = s["id"]
        rec["number_form"] = s["form"]
        rec["number_role"] = "digit"
        rec["presentation"] = s.get("presentation") or rec["presentation"]

    pres = presentation_from_name(name) if name else ""
    if pres and nt != "none":
        rec["presentation"] = rec["presentation"] or pres
        if not rec["number_form"]:
            rec["number_form"] = "presentation"
            rec["number_role"] = "presentation"
        if not rec["number_system"]:
            rec["number_system"] = f"presentation-{pres}"

    # Fractions
    if name.startswith("VULGAR FRACTION") or "FRACTION" in name and nt == "numeric":
        rec["number_form"] = "fraction"
        rec["number_role"] = "fraction"
        rec["number_system"] = rec["number_system"] or "vulgar-fraction"

    # Roman
    if "ROMAN NUMERAL" in name:
        rec["number_system"] = "roman"
        rec["number_form"] = "additive"
        rec["number_role"] = "numeral"

    # Ethiopic
    if name.startswith("ETHIOPIC DIGIT") or name.startswith("ETHIOPIC NUMBER"):
        rec["number_system"] = "ethiopic"
        rec["number_form"] = "hybrid-myriad"
        rec["number_role"] = "digit" if name.startswith("ETHIOPIC DIGIT") else "numeral"

    # Tamil / Malayalam named units
    if name.startswith("TAMIL NUMBER") or name.startswith("MALAYALAM NUMBER"):
        rec["number_system"] = "tamil-malayalam-unit"
        rec["number_form"] = "unit-named"
        rec["number_role"] = "numeral"

    # Suzhou / Hangzhou (positional in use, not Nd)
    if 0x3021 <= cp <= 0x3029 or 0x3038 <= cp <= 0x303A:
        rec["number_system"] = "suzhou"
        rec["number_form"] = "positional-decimal-not-Nd"
        rec["number_role"] = "digit"
        rec["notes_system"] = "Hangzhou-named; Suzhou numerals; positional decimal in commerce."

    if cp == 0x3007:  # IDEOGRAPHIC NUMBER ZERO
        rec["number_system"] = "cjk-ideographic"
        rec["number_form"] = "hybrid-myriad"
        rec["number_role"] = "digit"

    # CJK ideographs with numeric values
    if script == "Han" and nt != "none" and cat in {"Lo", "Nl"}:
        rec["number_system"] = rec["number_system"] or "cjk-ideographic"
        rec["number_form"] = rec["number_form"] or "hybrid-myriad"
        rec["number_role"] = rec["number_role"] or "numeral"
        if "COMPATIBILITY" in name:
            rec["number_system"] = "cjk-compat"

    # Runic golden numbers
    if name.startswith("RUNIC") and nt != "none":
        rec["number_system"] = "runic-golden"
        rec["number_form"] = "unit-named"
        rec["number_role"] = "numeral"

    # Bamum letter-numbers (Nl with 0-9)
    if 0xA6E6 <= cp <= 0xA6EF:
        rec["number_system"] = "bamum-letter-numbers"
        rec["number_form"] = "ciphered-ucd"
        rec["number_role"] = "numeral"

    # Coptic epact / numbers
    if "COPTIC" in name and nt != "none":
        rec["number_system"] = "coptic"
        rec["number_form"] = rec["number_form"] or "ciphered-ucd"
        rec["number_role"] = rec["number_role"] or "numeral"

    # Turned digits (duodecimal, Number Forms)
    if cp in (0x218A, 0x218B):
        rec["number_system"] = "duodecimal-turned"
        rec["number_form"] = "positional-other-radix"
        rec["number_role"] = "digit"

    # Cultural ciphered (overlay; does not invent UCD numeric_type)
    if cp in HEBREW_GEMATRIA:
        rec["number_system"] = "hebrew-gematria"
        rec["number_form"] = "ciphered-cultural"
        rec["number_role"] = "numeral"
        rec["numeric_value"] = rec["numeric_value"] or str(HEBREW_GEMATRIA[cp])
    if cp in GREEK_MILESIAN:
        rec["number_system"] = rec["number_system"] or "greek-milesian"
        rec["number_form"] = rec["number_form"] or "ciphered-cultural"
        rec["number_role"] = rec["number_role"] or "numeral"
        if not rec["numeric_value"]:
            rec["numeric_value"] = str(GREEK_MILESIAN[cp])
    if cp in ARMENIAN:
        rec["number_system"] = rec["number_system"] or "armenian-alphabetic"
        rec["number_form"] = rec["number_form"] or "ciphered-cultural"
        rec["number_role"] = rec["number_role"] or "numeral"
        if not rec["numeric_value"]:
            rec["numeric_value"] = str(ARMENIAN[cp])
    if cp in GEORGIAN:
        rec["number_system"] = rec["number_system"] or "georgian-alphabetic"
        rec["number_form"] = rec["number_form"] or "ciphered-cultural"
        rec["number_role"] = rec["number_role"] or "numeral"
        if not rec["numeric_value"]:
            rec["numeric_value"] = str(GEORGIAN[cp])

    # Script-local extra numeric (Bengali currency numerators, Oriya fractions,
    # Telugu fraction digits, North Indic fractions, Khmer divination, …)
    if nt == "numeric" and not rec["number_form"]:
        rec["number_form"] = "numeric-other"
        rec["number_role"] = "numeral"
        rec["number_system"] = rec["number_system"] or f"ucd-numeric-{script.lower()}"

    # --- gradients / structured families ---
    if cp in BLOCK_FILL:
        fam, kind, axis, val, region = BLOCK_FILL[cp]
        rec["gradient_family"] = fam
        rec["gradient_kind"] = kind
        rec["gradient_axis"] = axis
        rec["gradient_value"] = f"{val:.4f}".rstrip("0").rstrip(".")
        rec["gradient_param"] = json.dumps({"region": region}, separators=(",", ":"))
        rec["structured_family"] = "block-elements"
    if cp in SHADE:
        fam, kind, axis, val, region = SHADE[cp]
        rec["gradient_family"] = fam
        rec["gradient_kind"] = kind
        rec["gradient_axis"] = axis
        rec["gradient_value"] = f"{val:.2f}"
        rec["gradient_param"] = json.dumps({"shade": region}, separators=(",", ":"))
        rec["structured_family"] = "block-elements"

    if 0x2580 <= cp <= 0x259F:
        rec["structured_family"] = "block-elements"
        qb = quadrant_bits(name)
        if qb is not None:
            rec["gradient_family"] = "quadrant"
            rec["gradient_kind"] = "derived"
            rec["gradient_axis"] = "cell-quadrants"
            rec["gradient_value"] = str(bin(qb).count("1") / 4)
            rec["gradient_param"] = json.dumps(
                {"bits": qb, "density": bin(qb).count("1") / 4},
                separators=(",", ":"),
            )

    if 0x2800 <= cp <= 0x28FF:
        p = braille_param(cp)
        rec["gradient_family"] = "braille"
        rec["gradient_kind"] = "derived"
        rec["gradient_axis"] = "dot-density"
        rec["gradient_value"] = str(p["density"])
        rec["gradient_param"] = json.dumps(p, separators=(",", ":"))
        rec["structured_family"] = "braille"

    if 0x2500 <= cp <= 0x257F:
        rec["structured_family"] = "box-drawing"

    if 0x25A0 <= cp <= 0x25FF:
        rec["structured_family"] = rec["structured_family"] or "geometric-shapes"
        # size / fill series by name
        if any(w in name for w in ("BLACK", "WHITE", "SMALL", "MEDIUM", "LARGE")):
            fill = "black" if "BLACK" in name else "white" if "WHITE" in name else ""
            size = (
                "small"
                if "SMALL" in name
                else "medium"
                if "MEDIUM" in name
                else "large"
                if "LARGE" in name
                else ""
            )
            if fill or size:
                rec["gradient_family"] = rec["gradient_family"] or "geometric-fill-size"
                rec["gradient_kind"] = rec["gradient_kind"] or "specific"
                rec["gradient_axis"] = rec["gradient_axis"] or "fill-size"
                rec["gradient_param"] = rec["gradient_param"] or json.dumps(
                    {"fill": fill, "size": size}, separators=(",", ":")
                )

    if "STAR" in name and cat in {"So", "Po"}:
        rec["structured_family"] = rec["structured_family"] or "star"
        rec["gradient_family"] = rec["gradient_family"] or "stars-fill"
        rec["gradient_kind"] = rec["gradient_kind"] or "specific"
        rec["gradient_axis"] = rec["gradient_axis"] or "fill"
        fill = (
            "black"
            if "BLACK" in name
            else "white"
            if "WHITE" in name
            else "outlined"
            if "OUTLINED" in name
            else ""
        )
        rec["gradient_param"] = rec["gradient_param"] or json.dumps(
            {"fill": fill, "name": name}, separators=(",", ":")
        )

    # Nerd Font battery / progress (common PUA). Not complete; tagged when name
    # isn't available (PUA has no Unicode name). Leave for coverage/PNG.
    if 0xE000 <= cp <= 0xF8FF:
        rec["structured_family"] = rec["structured_family"] or "pua-nerd"

    if 0x2190 <= cp <= 0x21FF:
        rec["structured_family"] = rec["structured_family"] or "arrows"

    return rec


AXES_COLS = [
    "cp",
    "hex",
    "char",
    "name",
    "category",
    "block",
    "script",
    "numeric_type",
    "numeric_value",
    "number_system",
    "number_form",
    "number_role",
    "presentation",
    "ucd_numeric",
    "gradient_family",
    "gradient_kind",
    "gradient_axis",
    "gradient_value",
    "gradient_param",
    "structured_family",
]


def main() -> None:
    OUT.mkdir(parents=True, exist_ok=True)
    blocks = parse_blocks(UCD / "Blocks.txt")
    scripts = parse_scripts(UCD / "Scripts.txt")
    decimal_sets = discover_decimal_sets()
    decimal_index: dict[int, dict] = {}
    for s in decimal_sets:
        for cp in range(s["lo"], s["hi"] + 1):
            decimal_index[cp] = s

    rows = []
    for cp in range(0x10000):
        ch = chr(cp)
        cat = unicodedata.category(ch)
        if cat in {"Cn", "Cs"}:  # unassigned or surrogates (not utf-8-encodable)
            continue
        rows.append(classify_one(cp, blocks, scripts, decimal_sets, decimal_index))

    tsv = OUT / "unicode-axes.tsv"
    with tsv.open("w", encoding="utf-8") as f:
        f.write("\t".join(AXES_COLS) + "\n")
        for r in rows:
            f.write("\t".join(r.get(c, "") for c in AXES_COLS) + "\n")

    # number-systems.json: auto decimal + curated summaries from the rows
    by_sys = defaultdict(list)
    for r in rows:
        if r["number_system"]:
            by_sys[r["number_system"]].append(r)

    systems = []
    for s in decimal_sets:
        recs = by_sys.get(s["id"], [])
        systems.append(
            {
                **{k: s[k] for k in s if k != "zero"},
                "n": len(recs),
                "example": [r["hex"] + " " + r["char"] for r in recs[:10]],
            }
        )
    seen = {s["id"] for s in decimal_sets}
    for sid, recs in sorted(by_sys.items(), key=lambda kv: -len(kv[1])):
        if sid in seen:
            continue
        forms = sorted({r["number_form"] for r in recs if r["number_form"]})
        roles = sorted({r["number_role"] for r in recs if r["number_role"]})
        ucd = sorted({r["ucd_numeric"] for r in recs})
        systems.append(
            {
                "id": sid,
                "form": forms[0] if len(forms) == 1 else forms,
                "role": roles[0] if len(roles) == 1 else roles,
                "ucd_numeric": ucd == ["yes"],
                "n": len(recs),
                "lo": recs[0]["hex"],
                "hi": recs[-1]["hex"],
                "example": [r["hex"] + " " + r["char"] for r in recs[:12]],
            }
        )

    (OUT / "number-systems.json").write_text(
        json.dumps(
            {
                "unicode": unicodedata.unidata_version,
                "note": (
                    "positional-decimal sets are auto-detected Nd 0–9 runs. "
                    "ciphered-cultural systems (hebrew-gematria, greek-milesian, "
                    "armenian-alphabetic, georgian-alphabetic) are overlays: "
                    "UCD Numeric_Type is none for those letters."
                ),
                "systems": systems,
            },
            ensure_ascii=False,
            indent=2,
        )
        + "\n",
        encoding="utf-8",
    )

    by_grad = defaultdict(list)
    for r in rows:
        if r["gradient_family"]:
            by_grad[r["gradient_family"]].append(r)
    grads = []
    for gid, recs in sorted(by_grad.items(), key=lambda kv: -len(kv[1])):
        kinds = sorted({r["gradient_kind"] for r in recs if r["gradient_kind"]})
        axes = sorted({r["gradient_axis"] for r in recs if r["gradient_axis"]})
        grads.append(
            {
                "id": gid,
                "kind": kinds[0] if len(kinds) == 1 else kinds,
                "axis": axes[0] if len(axes) == 1 else axes,
                "n": len(recs),
                "lo": recs[0]["hex"],
                "hi": recs[-1]["hex"],
                "example": [
                    {
                        "hex": r["hex"],
                        "char": r["char"],
                        "value": r["gradient_value"],
                    }
                    for r in recs[:16]
                ],
            }
        )
    (OUT / "gradients.json").write_text(
        json.dumps(
            {
                "unicode": unicodedata.unidata_version,
                "note": (
                    "block-fill-* are designed fractions (specific). "
                    "braille density is popcount/8 of the 8-dot pattern (derived). "
                    "shade values 0.25/0.50/0.75 are the conventional design, "
                    "matching Ghostty sprite alpha8; optical density is in the paint TSV."
                ),
                "gradients": grads,
            },
            ensure_ascii=False,
            indent=2,
        )
        + "\n",
        encoding="utf-8",
    )

    n_num = sum(1 for r in rows if r["number_system"])
    n_grad = sum(1 for r in rows if r["gradient_family"])
    print(
        f"assigned BMP {len(rows)}; number-tagged {n_num}; "
        f"gradient-tagged {n_grad}; decimal sets {len(decimal_sets)}"
    )
    print(f"wrote {tsv}")
    print(f"wrote {OUT / 'number-systems.json'} ({len(systems)} systems)")
    print(f"wrote {OUT / 'gradients.json'} ({len(grads)} families)")


if __name__ == "__main__":
    main()
