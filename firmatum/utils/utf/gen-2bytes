#!/usr/bin/env python3
"""Markdown glyph chart of every 1- and 2-byte UTF-8 code point (U+0000–U+07FF).

Prints to stdout. Combining / control / format / other special-function
codepoints are marked `x`; unassigned cells are left empty; everything
else is the glyph wrapped in [] so its width is visible.
"""

from __future__ import annotations

import unicodedata
from typing import Iterable

# Last 2-byte UTF-8 scalar is U+07FF; NKo is the last block in that range.
RANGE_END = 0x0800

BLOCKS: list[tuple[int, int, str]] = [
    (0x0000, 0x007F, "Basic Latin"),
    (0x0080, 0x00FF, "Latin-1 Supplement"),
    (0x0100, 0x017F, "Latin Extended-A"),
    (0x0180, 0x024F, "Latin Extended-B"),
    (0x0250, 0x02AF, "IPA Extensions"),
    (0x02B0, 0x02FF, "Spacing Modifier Letters"),
    (0x0300, 0x036F, "Combining Diacritical Marks"),
    (0x0370, 0x03FF, "Greek and Coptic"),
    (0x0400, 0x04FF, "Cyrillic"),
    (0x0500, 0x052F, "Cyrillic Supplement"),
    (0x0530, 0x058F, "Armenian"),
    (0x0590, 0x05FF, "Hebrew"),
    (0x0600, 0x06FF, "Arabic"),
    (0x0700, 0x074F, "Syriac"),
    (0x0750, 0x077F, "Arabic Supplement"),
    (0x0780, 0x07BF, "Thaana"),
    (0x07C0, 0x07FF, "NKo"),
]

# Combining, controls, format, and the other "not a standalone glyph" cats.
SPECIAL = frozenset({"Mn", "Mc", "Me", "Cc", "Cf", "Zl", "Zp", "Cs", "Co"})

def cell(cp: int) -> str:
    ch = chr(cp)
    cat = unicodedata.category(ch)
    if cat == "Cn":
        return ""
    if cat in SPECIAL:
        return "x"
    shown = ch.replace("\\", "\\\\")
    for spec in "|*_":
        shown = shown.replace(spec, "\\" + spec)
    return f"[{shown}]"


def rows_for(start: int, end: int) -> Iterable[int]:
    row0 = start & ~0xF
    row1 = end & ~0xF
    return range(row0, row1 + 1, 16)


def emit_table(start: int, end: int) -> list[str]:
    header = "|        | " + " | ".join("0123456789ABCDEF") + " |"
    sep = "|:-------|" + "|".join([":---:"] * 16) + "|"
    lines = [header, sep]
    for row in rows_for(start, end):
        cells = []
        for nibble in range(16):
            cp = row + nibble
            if start <= cp <= end:
                cells.append(cell(cp))
            else:
                cells.append("")
        label = f"U+{row:04X}"[:-1] + "x"
        lines.append(f"| {label} | " + " | ".join(cells) + " |")
    return lines


def main() -> None:
    out: list[str] = [
        "# UTF-8 1- and 2-byte glyphs (U+0000–U+07FF)",
        "",
        f"Generated by `gen-2bytes`. Unicode {unicodedata.unidata_version}.",
        "",
        "- `[…]` — assigned printable character (brackets show the glyph’s own width)",
        "- `x` — combining, control, format, or other special-function code point",
        "- empty — unassigned (`Cn`)",
        "",
    ]
    for start, end, name in BLOCKS:
        out.append(f"## {name} (U+{start:04X}–U+{end:04X})")
        out.append("")
        out.extend(emit_table(start, end))
        out.append("")
    print("\n".join(out))


if __name__ == "__main__":
    main()
