#!/usr/bin/env python3
"""Paint Ghostty *sprite* codepoints (no font) onto the same 4× canvas.

Mimics the sprite face at ~/src-ext/ghostty @ 600a86dc
  src/font/sprite/Face.zig          ranges from draw* names
  src/font/sprite/draw/box.zig      U+2500–257F
  src/font/sprite/draw/block.zig    U+2580–259F
  src/font/sprite/draw/braille.zig  U+2800–28FF
  src/font/sprite/draw/geometric_shapes.zig  subset
  src/font/sprite/draw/powerline.zig
  src/font/sprite/draw/branch.zig   U+F5D0–F60D (simplified nodes/lines)

Packed and roomy PNGs are identical (sprites ignore neighbor cells).
Appends rows to bmp-metrics-ghostty.tsv.
"""

from __future__ import annotations

import argparse
import math
import sys
import unicodedata
from pathlib import Path

import numpy as np
from PIL import Image, ImageDraw

SCALE = 4


def cell_metrics():
    from AppKit import NSFont, NSAttributedString, NSFontAttributeName
    import CoreText

    font = NSFont.fontWithName_size_("VictorMono NFM SemiBold", 17.0 * SCALE)
    descent = CoreText.CTFontGetDescent(font)
    ascent = CoreText.CTFontGetAscent(font)
    leading = CoreText.CTFontGetLeading(font)
    face_h = ascent + descent + leading
    face_w = 0.0
    for i in range(32, 127):
        attr = NSAttributedString.alloc().initWithString_attributes_(
            chr(i), {NSFontAttributeName: font}
        )
        w = CoreText.CTLineGetTypographicBounds(
            CoreText.CTLineCreateWithAttributedString(attr), None, None, None
        )[0]
        if w > face_w:
            face_w = float(w)
    return float(int(round(face_w))), float(int(round(face_h)))


class Cell:
    """PNG canvas matching measure-ghostty: 3×2 cells, origin in the middle."""

    def __init__(self, cw: float, ch: float):
        self.cw = cw
        self.ch = ch
        self.pw = int(round(cw * 3))
        self.ph = int(round(ch * 2))
        self.ox = int(round(0.5 * cw))  # origin-cell left
        self.oy = int(round(0.5 * ch))  # origin-cell top (PNG)
        self.iw = max(1, int(round(cw)))
        self.ih = max(1, int(round(ch)))
        self.thick = max(1, int(round(cw / 9)))
        self.arr = np.full((self.ph, self.pw, 4), 255, np.uint8)

    def ink(self, x: int, y: int, x2: int, y2: int, v: int = 0) -> None:
        """Fill [x,x2)×[y,y2) in *cell* coords (y down from origin-cell top)."""
        x0, x1 = sorted((x, x2))
        y0, y1 = sorted((y, y2))
        px0 = max(0, self.ox + x0)
        px1 = min(self.pw, self.ox + x1)
        py0 = max(0, self.oy + y0)
        py1 = min(self.ph, self.oy + y1)
        if px1 > px0 and py1 > py0:
            self.arr[py0:py1, px0:px1, :3] = v

    def shade(self, x, y, x2, y2, level: int) -> None:
        """level 0..255, 255=black."""
        self.ink(x, y, x2, y2, 255 - level)

    def add_grid(self) -> None:
        # Same light-red 1px guides as measure-ghostty (PNG top-origin).
        xs = [
            int(round(0.5 * self.cw)),
            int(round(1.5 * self.cw)),
            int(round(2.5 * self.cw)),
        ]
        ys = [
            int(round(0.5 * self.ch)),
            int(round(1.5 * self.ch)),
        ]
        r, g, b = 255, 184, 184
        for x in xs:
            if 0 <= x < self.pw:
                self.arr[ys[0] : ys[1] + 1, x, 0] = r
                self.arr[ys[0] : ys[1] + 1, x, 1] = g
                self.arr[ys[0] : ys[1] + 1, x, 2] = b
        for y in ys:
            if 0 <= y < self.ph:
                self.arr[y, xs[0] : xs[2] + 1, 0] = r
                self.arr[y, xs[0] : xs[2] + 1, 1] = g
                self.arr[y, xs[0] : xs[2] + 1, 2] = b

    def save(self, path: Path) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        Image.fromarray(self.arr, "RGBA").save(path)


def light_px(c: Cell) -> int:
    return c.thick


def heavy_px(c: Cell) -> int:
    return c.thick * 2


def lines_char(c: Cell, up: int, right: int, down: int, left: int) -> None:
    """Style 0 none, 1 light, 2 heavy, 3 double. Port of box.zig linesChar."""
    w, h = c.iw, c.ih
    lp, hp = light_px(c), heavy_px(c)
    h_lt = (h - lp) // 2
    h_lb = h_lt + lp
    h_ht = (h - hp) // 2
    h_hb = h_ht + hp
    h_dt = h_lt - lp
    h_db = h_lb + lp
    v_ll = (w - lp) // 2
    v_lr = v_ll + lp
    v_hl = (w - hp) // 2
    v_hr = v_hl + hp
    v_dl = v_ll - lp
    v_dr = v_lr + lp

    def saturating_sub(a, b):
        return max(0, a - b)

    h_lt = saturating_sub(h, lp) // 2
    h_lb = h_lt + lp
    h_ht = saturating_sub(h, hp) // 2
    h_hb = h_ht + hp
    h_dt = saturating_sub(h_lt, lp)
    h_db = h_lb + lp
    v_ll = saturating_sub(w, lp) // 2
    v_lr = v_ll + lp
    v_hl = saturating_sub(w, hp) // 2
    v_hr = v_hl + hp
    v_dl = saturating_sub(v_ll, lp)
    v_dr = v_lr + lp

    if left == 2 or right == 2:
        up_bottom = h_hb
    elif left != right or down == up:
        up_bottom = h_db if (left == 3 or right == 3) else h_lb
    elif left == 0 and right == 0:
        up_bottom = h_lb
    else:
        up_bottom = h_lt

    if left == 2 or right == 2:
        down_top = h_ht
    elif left != right or up == down:
        down_top = h_dt if (left == 3 or right == 3) else h_lt
    elif left == 0 and right == 0:
        down_top = h_lt
    else:
        down_top = h_lb

    if up == 2 or down == 2:
        left_right = v_hr
    elif up != down or left == right:
        left_right = v_dr if (up == 3 or down == 3) else v_lr
    elif up == 0 and down == 0:
        left_right = v_lr
    else:
        left_right = v_ll

    if up == 2 or down == 2:
        right_left = v_hl
    elif up != down or right == left:
        right_left = v_dl if (up == 3 or down == 3) else v_ll
    elif up == 0 and down == 0:
        right_left = v_ll
    else:
        right_left = v_lr

    if up == 1:
        c.ink(v_ll, 0, v_lr, up_bottom)
    elif up == 2:
        c.ink(v_hl, 0, v_hr, up_bottom)
    elif up == 3:
        lb = h_lt if left == 3 else up_bottom
        rb = h_lt if right == 3 else up_bottom
        c.ink(v_dl, 0, v_ll, lb)
        c.ink(v_lr, 0, v_dr, rb)

    if right == 1:
        c.ink(right_left, h_lt, w, h_lb)
    elif right == 2:
        c.ink(right_left, h_ht, w, h_hb)
    elif right == 3:
        tl = v_lr if up == 3 else right_left
        bl = v_lr if down == 3 else right_left
        c.ink(tl, h_dt, w, h_lt)
        c.ink(bl, h_lb, w, h_db)

    if down == 1:
        c.ink(v_ll, down_top, v_lr, h)
    elif down == 2:
        c.ink(v_hl, down_top, v_hr, h)
    elif down == 3:
        lt = v_ll if left == 3 else v_ll  # noqa
        # mirror zig: left_top / right_top
        left_top = h_lb if left == 3 else down_top
        right_top = h_lb if right == 3 else down_top
        # actually zig uses down double with left_top based on left==double -> h_light_bottom
        lt_y = h_lb if left == 3 else down_top
        rt_y = h_lb if right == 3 else down_top
        c.ink(v_dl, lt_y, v_ll, h)
        c.ink(v_lr, rt_y, v_dr, h)

    if left == 1:
        c.ink(0, h_lt, left_right, h_lb)
    elif left == 2:
        c.ink(0, h_ht, left_right, h_hb)
    elif left == 3:
        tr = v_ll if up == 3 else left_right
        br = v_ll if down == 3 else left_right
        c.ink(0, h_dt, tr, h_lt)
        c.ink(0, h_lb, br, h_db)


