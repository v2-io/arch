def dash_h(c: Cell, n: int, thick: int) -> None:
    w, h = c.iw, c.ih
    y = (h - thick) // 2
    gap = max(1, thick)
    total = n * 2 - 1
    seg = max(1, (w - (n - 1) * gap) // n)
    x = 0
    for i in range(n):
        c.ink(x, y, min(w, x + seg), y + thick)
        x += seg + gap


def dash_v(c: Cell, n: int, thick: int) -> None:
    w, h = c.iw, c.ih
    x = (w - thick) // 2
    gap = max(1, thick)
    seg = max(1, (h - (n - 1) * gap) // n)
    y = 0
    for i in range(n):
        c.ink(x, y, x + thick, min(h, y + seg))
        y += seg + gap


def diagonals(c: Cell, which: str) -> None:
    im = Image.fromarray(c.arr, "RGBA")
    dr = ImageDraw.Draw(im)
    t = light_px(c)
    x0, y0 = c.ox, c.oy
    x1, y1 = c.ox + c.iw, c.oy + c.ih
    col = (0, 0, 0, 255)
    if which in ("urll", "cross"):
        dr.line([(x1, y0), (x0, y1)], fill=col, width=t)
    if which in ("ullr", "cross"):
        dr.line([(x0, y0), (x1, y1)], fill=col, width=t)
    c.arr[:] = np.array(im)


def arc_corner(c: Cell, corner: str) -> None:
    im = Image.fromarray(c.arr, "RGBA")
    dr = ImageDraw.Draw(im)
    t = light_px(c)
    x0, y0 = c.ox, c.oy
    w, h = c.iw, c.ih
    col = (0, 0, 0, 255)
    # quarter-ellipses into the cell; extend slightly into pad so seams join
    if corner == "br":  # ╭  from center to right+down
        bbox = [x0 - w, y0 - h, x0 + w, y0 + h]
        dr.arc(bbox, 0, 90, fill=col, width=t)
        dr.line([(x0 + w // 2, y0 + h), (x0 + w, y0 + h)], fill=col, width=t)  # noop
    elif corner == "bl":
        bbox = [x0, y0 - h, x0 + 2 * w, y0 + h]
        dr.arc(bbox, 90, 180, fill=col, width=t)
    elif corner == "tl":
        bbox = [x0, y0, x0 + 2 * w, y0 + 2 * h]
        dr.arc(bbox, 180, 270, fill=col, width=t)
    elif corner == "tr":
        bbox = [x0 - w, y0, x0 + w, y0 + 2 * h]
        dr.arc(bbox, 270, 360, fill=col, width=t)
    c.arr[:] = np.array(im)
    # also draw the outgoing stems from mid to edge
    mx, my = w // 2, h // 2
    lp = light_px(c)
    if corner == "br":  # ╭ down+right
        c.ink(mx, my, mx + lp, h)
        c.ink(mx, my, w, my + lp)
    elif corner == "bl":
        c.ink(mx, my, mx + lp, h)
        c.ink(0, my, mx, my + lp)
    elif corner == "tl":
        c.ink(mx, 0, mx + lp, my)
        c.ink(0, my, mx, my + lp)
    elif corner == "tr":
        c.ink(mx, 0, mx + lp, my)
        c.ink(mx, my, w, my + lp)


def draw_box(c: Cell, cp: int) -> None:
    if cp in BOX:
        u, r, d, l = BOX[cp]
        lines_char(c, u, r, d, l)
        return
    dashes = {
        0x2504: ("h", 3, light_px(c)),
        0x2505: ("h", 3, heavy_px(c)),
        0x2506: ("v", 3, light_px(c)),
        0x2507: ("v", 3, heavy_px(c)),
        0x2508: ("h", 4, light_px(c)),
        0x2509: ("h", 4, heavy_px(c)),
        0x250A: ("v", 4, light_px(c)),
        0x250B: ("v", 4, heavy_px(c)),
        0x254C: ("h", 2, light_px(c)),
        0x254D: ("h", 2, heavy_px(c)),
        0x254E: ("v", 2, light_px(c)),
        0x254F: ("v", 2, heavy_px(c)),
    }
    if cp in dashes:
        axis, n, t = dashes[cp]
        (dash_h if axis == "h" else dash_v)(c, n, t)
        return
    if cp == 0x256D:
        arc_corner(c, "br")
    elif cp == 0x256E:
        arc_corner(c, "bl")
    elif cp == 0x256F:
        arc_corner(c, "tl")
    elif cp == 0x2570:
        arc_corner(c, "tr")
    elif cp == 0x2571:
        diagonals(c, "urll")
    elif cp == 0x2572:
        diagonals(c, "ullr")
    elif cp == 0x2573:
        diagonals(c, "cross")


def draw_block(c: Cell, cp: int) -> None:
    w, h = c.iw, c.ih
    e = 0.125
    # (align h, align v, fw, fh) or shade full
    if cp == 0x2588:
        c.ink(0, 0, w, h)
        return
    # Ghostty src/font/sprite/draw/common.zig Shade @ 600a86dc
    # (alpha8: light=0x40, medium=0x80, dark=0xC0). Density uses
    # optical coverage so these are ~0.25 / ~0.50 / ~0.75, not binary 1.
    shades = {0x2591: 0x40, 0x2592: 0x80, 0x2593: 0xC0}
    if cp in shades:
        c.shade(0, 0, w, h, shades[cp])
        return
    fracs = {
        0x2580: ("full", "top", 1, 0.5),
        0x2581: ("full", "bot", 1, e),
        0x2582: ("full", "bot", 1, 0.25),
        0x2583: ("full", "bot", 1, 0.375),
        0x2584: ("full", "bot", 1, 0.5),
        0x2585: ("full", "bot", 1, 0.625),
        0x2586: ("full", "bot", 1, 0.75),
        0x2587: ("full", "bot", 1, 0.875),
        0x2589: ("left", "full", 0.875, 1),
        0x258A: ("left", "full", 0.75, 1),
        0x258B: ("left", "full", 0.625, 1),
        0x258C: ("left", "full", 0.5, 1),
        0x258D: ("left", "full", 0.375, 1),
        0x258E: ("left", "full", 0.25, 1),
        0x258F: ("left", "full", e, 1),
        0x2590: ("right", "full", 0.5, 1),
        0x2594: ("full", "top", 1, e),
        0x2595: ("right", "full", e, 1),
    }
    if cp in fracs:
        ah, av, fw, fh = fracs[cp]
        bw, bh = max(1, round(w * fw)), max(1, round(h * fh))
        x = 0 if ah == "left" else (w - bw if ah == "right" else (w - bw) // 2)
        y = 0 if av == "top" else (h - bh if av == "bot" else (h - bh) // 2)
        if ah == "full":
            x, bw = 0, w
        if av == "full":
            y, bh = 0, h
        c.ink(x, y, x + bw, y + bh)
        return
    quads = {
        0x2596: (0, 0, 1, 0),
        0x2597: (0, 0, 0, 1),
        0x2598: (1, 0, 0, 0),
        0x2599: (1, 0, 1, 1),
        0x259A: (1, 0, 0, 1),
        0x259B: (1, 1, 1, 0),
        0x259C: (1, 1, 0, 1),
        0x259D: (0, 1, 0, 0),
        0x259E: (0, 1, 1, 0),
        0x259F: (0, 1, 1, 1),
    }
    if cp in quads:
        tl, tr, bl, br = quads[cp]
        mw, mh = w // 2, h // 2
        if tl:
            c.ink(0, 0, mw, mh)
        if tr:
            c.ink(mw, 0, w, mh)
        if bl:
            c.ink(0, mh, mw, h)
        if br:
            c.ink(mw, mh, w, h)


def draw_braille(c: Cell, cp: int) -> None:
    bits = cp & 0xFF
    w, h = c.iw, c.ih
    # 2×4 dots: (x,y) order per Unicode: 1=tl 2=ul 3=ll 4=tr 5=ur 6=lr 7=bl 8=br
    positions = [
        (0, 0),
        (0, 1),
        (0, 2),
        (1, 0),
        (1, 1),
        (1, 2),
        (0, 3),
        (1, 3),
    ]
    dw = max(1, w // 6)
    xsp, ysp = w // 2, h // 4
    xm, ym = xsp // 4, ysp // 4
    for i, (cx, cy) in enumerate(positions):
        if bits & (1 << i):
            x = xm + cx * xsp + (xsp - dw) // 2
            y = ym + cy * ysp + (ysp - dw) // 2
            c.ink(x, y, x + dw, y + dw)


def draw_geo(c: Cell, cp: int) -> None:
    im = Image.fromarray(c.arr, "RGBA")
    dr = ImageDraw.Draw(im)
    x0, y0 = c.ox, c.oy
    x1, y1 = x0 + c.iw, y0 + c.ih
    col = (0, 0, 0, 255)
    tris = {
        0x25E2: [(x1, y1), (x0, y1), (x1, y0)],  # br filled
        0x25E3: [(x0, y1), (x0, y0), (x1, y1)],
        0x25E4: [(x0, y0), (x1, y0), (x0, y1)],
        0x25E5: [(x1, y0), (x1, y1), (x0, y0)],
    }
    outlines = {
        0x25F8: [(x0, y0), (x0, y1), (x1, y0)],
        0x25F9: [(x1, y0), (x0, y0), (x1, y1)],
        0x25FA: [(x0, y1), (x0, y0), (x1, y1)],
        0x25FF: [(x1, y1), (x1, y0), (x0, y1)],
    }
    if cp in tris:
        dr.polygon(tris[cp], fill=col)
    elif cp in outlines:
        t = light_px(c)
        dr.line(outlines[cp] + outlines[cp][:1], fill=col, width=t)
    c.arr[:] = np.array(im)


def draw_powerline(c: Cell, cp: int) -> None:
    im = Image.fromarray(c.arr, "RGBA")
    dr = ImageDraw.Draw(im)
    x0, y0 = c.ox, c.oy
    x1, y1 = x0 + c.iw, y0 + c.ih
    ym = (y0 + y1) // 2
    xm = (x0 + x1) // 2
    col = (0, 0, 0, 255)
    t = light_px(c)
    # geometric subset — filled wedges / chevrons
    if cp == 0xE0B0:  # 
        dr.polygon([(x0, y0), (x1, ym), (x0, y1)], fill=col)
    elif cp == 0xE0B2:
        dr.polygon([(x1, y0), (x0, ym), (x1, y1)], fill=col)
    elif cp == 0xE0B1:
        dr.line([(x0, y0), (x1, ym), (x0, y1)], fill=col, width=t)
    elif cp == 0xE0B3:
        dr.line([(x1, y0), (x0, ym), (x1, y1)], fill=col, width=t)
    elif cp in (0xE0B4, 0xE0B6):  # round
        dr.pieslice([x0, y0, x1 + c.iw, y1], 90, 270, fill=col)
    elif cp in (0xE0B8, 0xE0BC, 0xE0BE):
        dr.polygon([(x0, y1), (x1, y0), (x1, y1)], fill=col)
    elif cp in (0xE0BA, 0xE0B9):
        dr.polygon([(x0, y0), (x1, y0), (x0, y1)], fill=col)
    else:
        dr.polygon([(x0, y0), (x1, ym), (x0, y1)], fill=col)
    c.arr[:] = np.array(im)


def draw_branch(c: Cell, cp: int) -> None:
    """Simplified git-graph set: h/v, arcs, and a node+arms for the rest."""
    w, h = c.iw, c.ih
    t = light_px(c)
    mx, my = (w - t) // 2, (h - t) // 2
    if cp == 0xF5D0:
        c.ink(0, my, w, my + t)
        return
    if cp == 0xF5D1:
        c.ink(mx, 0, mx + t, h)
        return
    if 0xF5D6 <= cp <= 0xF5D9:
        corners = {0xF5D6: "br", 0xF5D7: "bl", 0xF5D8: "tr", 0xF5D9: "tl"}
        arc_corner(c, corners[cp])
        return
    # node
    r = max(2, w // 6)
    im = Image.fromarray(c.arr, "RGBA")
    dr = ImageDraw.Draw(im)
    cx, cy = c.ox + w // 2, c.oy + h // 2
    col = (0, 0, 0, 255)
    filled = (cp - 0xF5D0) & 1 == 0
    box = [cx - r, cy - r, cx + r, cy + r]
    if filled:
        dr.ellipse(box, fill=col)
    else:
        dr.ellipse(box, outline=col, width=t)
    dr.line([(c.ox + mx, c.oy), (c.ox + mx, c.oy + h)], fill=col, width=t)
    c.arr[:] = np.array(im)


def paint(cp: int, cw: float, ch: float) -> Cell:
    cell = Cell(cw, ch)
    if 0x2500 <= cp <= 0x257F:
        draw_box(cell, cp)
    elif 0x2580 <= cp <= 0x259F:
        draw_block(cell, cp)
    elif 0x2800 <= cp <= 0x28FF:
        draw_braille(cell, cp)
    elif cp in (0x25E2, 0x25E3, 0x25E4, 0x25E5, 0x25F8, 0x25F9, 0x25FA, 0x25FF):
        draw_geo(cell, cp)
    elif 0xE0B0 <= cp <= 0xE0BF or cp in (0xE0D2, 0xE0D4):
        draw_powerline(cell, cp)
    elif 0xF5D0 <= cp <= 0xF60D:
        draw_branch(cell, cp)
    cell.add_grid()
    return cell


SPRITE_CPS = (
    list(range(0x2500, 0x2580))
    + list(range(0x2580, 0x25A0))
    + [0x25E2, 0x25E3, 0x25E4, 0x25E5, 0x25F8, 0x25F9, 0x25FA, 0x25FF]
    + list(range(0x2800, 0x2900))
    + list(range(0xE0B0, 0xE0C0))
    + [0xE0D2, 0xE0D4]
    + list(range(0xF5D0, 0xF60E))
)


def raster_rel(kind: str, cp: int) -> str:
    return f".rasters/4x/{kind}/{cp >> 8:02x}/{cp:04x}.png"


def main() -> None:
    here = Path(__file__).resolve().parent
    ap = argparse.ArgumentParser()
    ap.add_argument("--out", type=Path, default=here)
    args = ap.parse_args()
    cw, ch = cell_metrics()
    print(f"cell {cw:.2f}×{ch:.2f}  sprites {len(SPRITE_CPS)}", file=sys.stderr)

    tsv = args.out / "bmp-metrics-ghostty.tsv"
    existing = set()
    if tsv.exists():
        hdr = tsv.read_text(encoding="utf-8").splitlines()[0]
        for line in tsv.read_text(encoding="utf-8").splitlines()[1:]:
            existing.add(int(line.split("\t", 1)[0]))
    else:
        hdr = (
            "cp\thex\tchar\tname\tcategory\teaw\tcells\tblock\tghostty\tused_face\t"
            "packed_scale\tpacked_class\tpacked_density\tpacked_overflow_cells\t"
            "packed_ink_width_cells\tpacked_raster\t"
            "roomy_scale\troomy_class\troomy_density\troomy_overflow_cells\t"
            "roomy_ink_width_cells\troomy_raster"
        )

    blocks = {
        range(0x2500, 0x2580): "Box Drawing",
        range(0x2580, 0x25A0): "Block Elements",
        range(0x25E2, 0x25E6): "Geometric Shapes",
        range(0x25F8, 0x25FB): "Geometric Shapes",
        range(0x25FF, 0x2600): "Geometric Shapes",
        range(0x2800, 0x2900): "Braille Patterns",
        range(0xE000, 0xF900): "Private Use Area",
    }

    def block_name(cp: int) -> str:
        for rng, name in blocks.items():
            if cp in rng:
                return name
        return "Private Use Area"

    new_rows = []
    for i, cp in enumerate(SPRITE_CPS):
        if i % 100 == 0:
            print(f"  {i}/{len(SPRITE_CPS)} U+{cp:04X}", file=sys.stderr)
        cell = paint(cp, cw, ch)
        for kind in ("packed", "roomy"):
            cell.save(args.out / raster_rel(kind, cp))
        if cp in existing:
            continue
        chs = chr(cp)
        try:
            name = unicodedata.name(chs, "")
        except ValueError:
            name = ""
        try:
            cat = unicodedata.category(chs)
            eaw = unicodedata.east_asian_width(chs)
        except ValueError:
            cat, eaw = "Co", "A"
        new_rows.append(
            f"{cp}\tU+{cp:04X}\t{chs}\t{name}\t{cat}\t{eaw}\t1\t{block_name(cp)}\t"
            f"ghostty-sprite\tghostty-sprite\t"
            f"1.0000\tnarrow\t0.0000\t0.0000\t0.0000\t{raster_rel('packed', cp)}\t"
            f"1.0000\tnarrow\t0.0000\t0.0000\t0.0000\t{raster_rel('roomy', cp)}"
        )
    if new_rows:
        with tsv.open("a", encoding="utf-8") as f:
            if tsv.stat().st_size == 0:
                f.write(hdr + "\n")
            f.write("\n".join(new_rows) + "\n")
    print(f"appended {len(new_rows)} sprite rows", file=sys.stderr)


if __name__ == "__main__":
    main()
