@dataclass(frozen=True)
class Row:
    cp: int
    category: str
    eaw: str
    cells: int
    klass: str  # narrow | overlarge | wide | missing
    density: float
    overflow_cells: float
    ink_width_cells: float
    face: str
    ghostty: str
    block: str
    raster: str = ""

    @property
    def ch(self) -> str:
        return chr(self.cp)


def ghostty_config() -> tuple[str, float]:
    """Primary face and size from ``ghostty +show-config``, with fallbacks."""
    family = "VictorMono NFM SemiBold"
    size = 17.0
    try:
        out = subprocess.check_output(
            ["ghostty", "+show-config"], text=True, stderr=subprocess.DEVNULL
        )
    except (FileNotFoundError, subprocess.CalledProcessError):
        return family, size
    for line in out.splitlines():
        if line.startswith("font-family = ") and "font-family-" not in line:
            val = line.split("=", 1)[1].strip()
            if val:
                family = val
        elif line.startswith("font-size = "):
            try:
                size = float(line.split("=", 1)[1].strip())
            except ValueError:
                pass
    return family, size


def ghostty_faces(codepoints: list[int], chunk: int = 128) -> dict[int, str]:
    """Map codepoint → '+show-face' painter string. Empty dict if Ghostty missing."""
    if not codepoints:
        return {}
    faces: dict[int, str] = {}
    pat = re.compile(
        r"U\+([0-9A-Fa-f]+)\s+«.*?»\s+"
        r"(found in face “(?P<face>.*)”"
        r"|is handled by Ghostty's internal sprites"
        r"|not found)\."
    )
    for i in range(0, len(codepoints), chunk):
        part = codepoints[i : i + chunk]
        s = "".join(chr(cp) for cp in part)
        try:
            out = subprocess.check_output(
                ["ghostty", "+show-face", f"--string={s}"],
                text=True,
                stderr=subprocess.STDOUT,
            )
        except (FileNotFoundError, subprocess.CalledProcessError) as e:
            if i == 0:
                print(f"note: ghostty +show-face unavailable ({e!r})", file=sys.stderr)
                return {}
            continue
        for m in pat.finditer(out):
            cp = int(m.group(1), 16)
            if m.group("face") is not None:
                faces[cp] = m.group("face")
            elif "sprites" in m.group(2):
                faces[cp] = "ghostty-sprite"
            else:
                faces[cp] = "not-found"
    return faces


def block_name(cp: int) -> str:
    for start, end, name in BLOCKS:
        if start <= cp <= end:
            return name
    return "Unassigned block"


def skip_reason(cp: int) -> str | None:
    """None if we should measure; otherwise a table-cell mark ('x' or '')."""
    try:
        ch = chr(cp)
    except ValueError:
        return "x"
    cat = unicodedata.category(ch)
    if cat == "Cn":
        return ""
    if cat in SKIP_CATS:
        return "x"
    return None


def raster_relpath(cp: int, scale: int) -> str:
    """`.rasters/4x/25/2500.png` for U+2500 at 4×."""
    return f".rasters/{scale}x/{cp >> 8:02x}/{cp:04x}.png"


class Measurer:
    def __init__(self, family: str, point_size: float, scale: int = SCALE) -> None:
        from AppKit import (  # noqa: PLC0415
            NSAttributedString,
            NSBitmapImageFileTypePNG,
            NSBitmapImageRep,
            NSCalibratedRGBColorSpace,
            NSColor,
            NSFont,
            NSFontAttributeName,
            NSForegroundColorAttributeName,
            NSGraphicsContext,
        )
        import CoreText  # noqa: PLC0415
        import Quartz  # noqa: PLC0415

        self._NSAttributedString = NSAttributedString
        self._NSBitmapImageFileTypePNG = NSBitmapImageFileTypePNG
        self._NSColor = NSColor
        self._NSFontAttributeName = NSFontAttributeName
        self._NSForegroundColorAttributeName = NSForegroundColorAttributeName
        self._NSGraphicsContext = NSGraphicsContext
        self.CoreText = CoreText
        self.Quartz = Quartz

        self.family = family
        self.point_size = point_size
        self.scale = scale
        raster_pt = point_size * scale
        font = NSFont.fontWithName_size_(family, raster_pt)
        if font is None:
            raise SystemExit(
                f"CoreText could not open {family!r} at {raster_pt}pt. "
                f"Check `ghostty +list-fonts` / font-family."
            )
        self.font = font
        self.ascent = CoreText.CTFontGetAscent(font)
        self.descent = CoreText.CTFontGetDescent(font)
        self.leading = CoreText.CTFontGetLeading(font)
        self.cell_h = self.ascent + self.descent + self.leading
        space = self._line(" ")
        self.cell_w = CoreText.CTLineGetTypographicBounds(space, None, None, None)[0]
        if self.cell_w <= 0:
            raise SystemExit("primary font space advance is 0; not a usable cell")

        # 3 cells wide (½ + origin + second + ½), 2 cells tall (½ + cell + ½).
        self.px_w = int(round(self.cell_w * 3))
        self.px_h = int(round(self.cell_h * 2))
        self.origin_x = 0.5 * self.cell_w
        self.cell_bottom = 0.5 * self.cell_h  # CG y; baseline sits descent above this
        # RGBA is required: NSGraphicsContext refuses RGB-without-alpha bitmap reps.
        self.spp = 4
        self.rep = NSBitmapImageRep.alloc().initWithBitmapDataPlanes_pixelsWide_pixelsHigh_bitsPerSample_samplesPerPixel_hasAlpha_isPlanar_colorSpaceName_bytesPerRow_bitsPerPixel_(
            None,
            self.px_w,
            self.px_h,
            8,
            self.spp,
            True,
            False,
            NSCalibratedRGBColorSpace,
            self.px_w * self.spp,
            32,
        )
        self.ns_ctx = NSGraphicsContext.graphicsContextWithBitmapImageRep_(self.rep)
        if self.ns_ctx is None:
            raise SystemExit("could not create bitmap graphics context")

    def _line(self, ch: str):
        attr = self._NSAttributedString.alloc().initWithString_attributes_(
            ch,
            {
                self._NSFontAttributeName: self.font,
                self._NSForegroundColorAttributeName: self._NSColor.blackColor(),
            },
        )
        return self.CoreText.CTLineCreateWithAttributedString(attr)

    def measure(self, cp: int, ghostty: str, png_path: Path | None = None) -> Row:
        ch = chr(cp)
        cat = unicodedata.category(ch)
        try:
            eaw = unicodedata.east_asian_width(ch)
        except ValueError:
            eaw = "?"
        occ = wcwidth(ch)
        cells = 2 if occ is not None and occ >= 2 else 1

        line = self._line(ch)
        runs = self.CoreText.CTLineGetGlyphRuns(line)
        face = ""
        glyph_id = 0
        if runs:
            run = runs[0]
            attrs = dict(self.CoreText.CTRunGetAttributes(run))
            run_font = attrs.get("NSFont")
            if run_font is not None:
                face = self.CoreText.CTFontCopyFullName(run_font) or ""
            glyphs = self.CoreText.CTRunGetGlyphs(
                run, self.Quartz.CFRange(0, 1), None
            )
            if glyphs:
                glyph_id = int(glyphs[0])

        img = self.CoreText.CTLineGetImageBounds(line, None)
        img_x = float(img.origin.x)
        img_w = float(img.size.width)
        img_h = float(img.size.height)
        ink_width_cells = img_w / self.cell_w if self.cell_w else 0.0
        alloc_w = self.cell_w * cells
        overflow_cells = max(0.0, (img_x + img_w) - alloc_w) / self.cell_w

        density = self._paint(line, cells, png_path=png_path)

        no_ink = img_w < 0.5 and img_h < 0.5
        last_resort = "LastResort" in (face or "")
        if last_resort or (no_ink and glyph_id == 0):
            klass = "missing"
        elif cells >= 2:
            klass = "wide"
        elif overflow_cells > OVERFLOW_THRESH:
            klass = "overlarge"
        else:
            klass = "narrow"

        return Row(
            cp=cp,
            category=cat,
            eaw=eaw,
            cells=cells,
            klass=klass,
            density=float(density),
            overflow_cells=float(overflow_cells),
            ink_width_cells=float(ink_width_cells),
            face=face,
            ghostty=ghostty,
            block=block_name(cp),
            raster=raster_relpath(cp, self.scale) if png_path is not None else "",
        )

    def _paint(self, line, cells: int, png_path: Path | None) -> float:
        """Draw glyph into the 3×2-cell canvas. Return density of allocated cells.

        If ``png_path`` is set, stroke the cell grid afterwards and write PNG.
        Density is always taken *before* the red lines.
        """
        Quartz = self.Quartz
        NSGraphicsContext = self._NSGraphicsContext
        NSGraphicsContext.saveGraphicsState()
        NSGraphicsContext.setCurrentContext_(self.ns_ctx)
        cg = self.ns_ctx.CGContext()
        Quartz.CGContextSetRGBFillColor(cg, 1, 1, 1, 1)
        Quartz.CGContextFillRect(cg, Quartz.CGRectMake(0, 0, self.px_w, self.px_h))
        Quartz.CGContextSetTextPosition(
            cg, self.origin_x, self.cell_bottom + self.descent
        )
        self.CoreText.CTLineDraw(line, cg)
        NSGraphicsContext.restoreGraphicsState()

        density = self._density_from_bitmap(cells)

        if png_path is not None:
            NSGraphicsContext.saveGraphicsState()
            NSGraphicsContext.setCurrentContext_(self.ns_ctx)
            self._stroke_cell_grid(self.ns_ctx.CGContext())
            NSGraphicsContext.restoreGraphicsState()
            png_path.parent.mkdir(parents=True, exist_ok=True)
            data = self.rep.representationUsingType_properties_(
                self._NSBitmapImageFileTypePNG, None
            )
            if data is None or not data.writeToFile_atomically_(str(png_path), True):
                raise RuntimeError(f"failed to write {png_path}")

        return density

    def _rgb(self) -> np.ndarray:
        ptr = self.rep.bitmapData()
        bpr = int(self.rep.bytesPerRow())
        buf = (
            bytes(ptr)[: bpr * self.px_h]
            if isinstance(ptr, (bytes, bytearray, memoryview))
            else ctypes.string_at(ptr, bpr * self.px_h)
        )
        row = np.frombuffer(buf, dtype=np.uint8).reshape(self.px_h, bpr)
        return row[:, : self.px_w * self.spp].reshape(self.px_h, self.px_w, self.spp)

    def _density_from_bitmap(self, cells: int) -> float:
        rgba = self._rgb()
        # Ink: not-white on RGB (ignore alpha). Grid is not drawn yet.
        ink = rgba[:, :, :3].min(axis=2) < 240
        x0 = int(round(self.origin_x))
        x1 = int(round(self.origin_x + self.cell_w * cells))
        y0 = int(round(self.cell_bottom))
        y1 = int(round(self.cell_bottom + self.cell_h))
        x0 = max(0, min(self.px_w, x0))
        x1 = max(x0 + 1, min(self.px_w, x1))
        y0 = max(0, min(self.px_h, y0))
        y1 = max(y0 + 1, min(self.px_h, y1))
        # NSBitmapImageRep.bitmapData is top-row-first; CG y is bottom-up.
        top = self.px_h - y1
        bot = self.px_h - y0
        cell = ink[top:bot, x0:x1]
        area = cell.size
        return float(cell.sum() / area) if area else 0.0

    def _stroke_cell_grid(self, cg) -> None:
        """1px light red lines at origin/second cell edges (not the outer pad)."""
        Quartz = self.Quartz
        x_left = 0.5 * self.cell_w
        x_mid = 1.5 * self.cell_w
        x_right = 2.5 * self.cell_w
        y_bot = 0.5 * self.cell_h
        y_top = 1.5 * self.cell_h
        Quartz.CGContextSaveGState(cg)
        Quartz.CGContextSetShouldAntialias(cg, False)
        Quartz.CGContextSetLineWidth(cg, 1.0)
        # Very light red — visible on white, not a second subject.
        Quartz.CGContextSetRGBStrokeColor(cg, 1.0, 0.72, 0.72, 1.0)

        def vline(x: float) -> None:
            Quartz.CGContextMoveToPoint(cg, x + 0.5, y_bot)
            Quartz.CGContextAddLineToPoint(cg, x + 0.5, y_top)

        def hline(y: float) -> None:
            Quartz.CGContextMoveToPoint(cg, x_left, y + 0.5)
            Quartz.CGContextAddLineToPoint(cg, x_right, y + 0.5)

        vline(x_left)
        vline(x_mid)
        vline(x_right)
        hline(y_bot)
        hline(y_top)
        Quartz.CGContextStrokePath(cg)
        Quartz.CGContextRestoreGState(cg)


TSV_HEADER = (
    "cp\thex\tchar\tname\tcategory\teaw\tcells\tclass\t"
    "density\toverflow_cells\tink_width_cells\tface\tghostty\tblock\traster"
)


def tsv_line(row: Row) -> str:
    ch = row.ch.replace("\\", "\\\\").replace("\t", "\\t").replace("\n", "\\n")
    name = unicodedata.name(row.ch, "")
    return (
        f"{row.cp}\tU+{row.cp:04X}\t{ch}\t{name}\t{row.category}\t{row.eaw}\t"
        f"{row.cells}\t{row.klass}\t{row.density:.4f}\t{row.overflow_cells:.4f}\t"
        f"{row.ink_width_cells:.4f}\t{row.face}\t{row.ghostty}\t{row.block}\t"
        f"{row.raster}"
    )


def md_escape(ch: str) -> str:
    shown = ch.replace("\\", "\\\\")
    for spec in "|*_`":
        shown = shown.replace(spec, "\\" + spec)
    return shown


def md_cell(row: Row | None, mark: str | None) -> str:
    if mark is not None:
        return mark
    assert row is not None
    shown = md_escape(row.ch)
    if row.klass == "missing":
        return "·"
    if row.klass == "overlarge":
        return f"[{shown}>"
    return f"[{shown}]"


def rows_for(start: int, end: int) -> Iterable[int]:
    row0 = start & ~0xF
    row1 = end & ~0xF
    return range(row0, row1 + 1, 16)


def emit_md_table(
    start: int,
    end: int,
    by_cp: dict[int, Row],
    skip: dict[int, str],
) -> list[str]:
    header = "|        | " + " | ".join("0123456789ABCDEF") + " |"
    sep = "|:-------|" + "|".join([":---:"] * 16) + "|"
    lines = [header, sep]
    for row in rows_for(start, end):
        cells = []
        for nibble in range(16):
            cp = row + nibble
            if cp < start or cp > end:
                cells.append("")
            elif cp in skip:
                cells.append(skip[cp])
            elif cp in by_cp:
                cells.append(md_cell(by_cp[cp], None))
            else:
                cells.append("")
        label = f"U+{row:04X}"[:-1] + "x"
        lines.append(f"| {label} | " + " | ".join(cells) + " |")
    return lines


def parse_cp(s: str) -> int:
    s = s.strip().lower()
    if s.startswith("u+"):
        s = s[2:]
    if s.startswith("0x"):
        return int(s, 16)
    if any(c in s for c in "abcdef"):
        return int(s, 16)
    # Bare numbers: treat as hex (U+… style), so --to FFFF works and --from 0 works.
    return int(s, 16)


def main() -> None:
    here = Path(__file__).resolve().parent
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n", 1)[0])
    ap.add_argument("--from", dest="start", default="0", help="first codepoint (hex or U+)")
    ap.add_argument("--to", dest="end", default=f"{DEFAULT_RANGE_END:X}", help="last codepoint (inclusive)")
    ap.add_argument("--out", type=Path, default=here, help="directory for TSV and markdown")
    ap.add_argument("--scale", type=int, default=SCALE, help="raster scale vs configured font-size")
    ap.add_argument("--no-ghostty", action="store_true", help="skip ghostty +show-face")
    ap.add_argument("--no-md", action="store_true", help="write TSV only")
    ap.add_argument("--no-rasters", action="store_true", help="do not write PNG cache")
    args = ap.parse_args()

    start = parse_cp(args.start)
    end = parse_cp(args.end)
    if start < 0 or end > 0x10FFFF or start > end:
        raise SystemExit(f"bad range U+{start:X}..U+{end:X}")

    family, pt = ghostty_config()
    print(f"primary face: {family!r} @ {pt}pt  range U+{start:04X}–U+{end:04X}", file=sys.stderr)

    to_measure: list[int] = []
    skip: dict[int, str] = {}
    for cp in range(start, end + 1):
        mark = skip_reason(cp)
        if mark is None:
            to_measure.append(cp)
        else:
            skip[cp] = mark

    print(f"measuring {len(to_measure)} codepoints (skipped {len(skip)})", file=sys.stderr)

    faces: dict[int, str] = {}
    if not args.no_ghostty:
        print("ghostty +show-face …", file=sys.stderr)
        faces = ghostty_faces(to_measure)
        print(f"  faces for {len(faces)} codepoints", file=sys.stderr)

    measurer = Measurer(family, pt, scale=args.scale)
    print(
        f"cell {measurer.cell_w:.2f}×{measurer.cell_h:.2f}px at {pt * args.scale}pt raster "
        f"(aspect {measurer.cell_h / measurer.cell_w:.3f})  "
        f"canvas {measurer.px_w}×{measurer.px_h}",
        file=sys.stderr,
    )

    args.out.mkdir(parents=True, exist_ok=True)

    by_cp: dict[int, Row] = {}
    n = len(to_measure)
    for i, cp in enumerate(to_measure):
        if i % 2000 == 0:
            print(f"  {i}/{n} U+{cp:04X}", file=sys.stderr)
        png = None
        if not args.no_rasters:
            png = args.out / raster_relpath(cp, args.scale)
        by_cp[cp] = measurer.measure(cp, faces.get(cp, ""), png_path=png)
    print(f"  {n}/{n} done", file=sys.stderr)

    tsv_path = args.out / "bmp-metrics.tsv"
    with tsv_path.open("w", encoding="utf-8") as f:
        f.write(TSV_HEADER + "\n")
        for cp in to_measure:
            f.write(tsv_line(by_cp[cp]) + "\n")
    print(f"wrote {tsv_path} ({len(to_measure)} rows)", file=sys.stderr)

    counts: dict[str, int] = {}
    for row in by_cp.values():
        counts[row.klass] = counts.get(row.klass, 0) + 1
    print("classes: " + ", ".join(f"{k}={v}" for k, v in sorted(counts.items())), file=sys.stderr)

    if args.no_md:
        return

    md_path = args.out / "bmp-tables.md"
    lines: list[str] = [
        f"# Glyph metrics (U+{start:04X}–U+{end:04X})",
        "",
        f"Generated by `measure-glyphs`. Primary face **{family}** at {pt:g}pt. "
        f"Unicode {unicodedata.unidata_version}.",
        "",
        "Raster is CoreText (Ghostty's macOS engine) + system fallback, **not** "
        "Ghostty sprites or nerd-icon constraint. Occupancy is `wcwidth`.",
        "",
        "- `[…]` — standalone glyph, ink fits the allocated cell(s)",
        "- `[…>` — single-cell occupancy, ink overlaps the next cell",
        "- `·` — assigned but no glyph/ink in the cascade",
        "- `x` — combining, control, format, surrogate, or whitespace",
        "- empty — unassigned (`Cn`)",
        "",
        f"Cell (raster): {measurer.cell_w:.1f}×{measurer.cell_h:.1f}px at {pt * args.scale:g}pt "
        f"(canvas {measurer.px_w}×{measurer.px_h}, 3×2 cells). "
        f"PNGs in `.rasters/{args.scale}x/`. "
        f"Overlarge threshold: ink bbox more than {OVERFLOW_THRESH:.0%} of a cell past the right edge.",
        "",
        "Counts: " + ", ".join(f"{k} {v}" for k, v in sorted(counts.items())) + ".",
        "",
    ]
    for b_start, b_end, name in BLOCKS:
        lo = max(b_start, start)
        hi = min(b_end, end)
        if lo > hi:
            continue
        lines.append(f"## {name} (U+{b_start:04X}–U+{b_end:04X})")
        lines.append("")
        lines.extend(emit_md_table(lo, hi, by_cp, skip))
        lines.append("")
    md_path.write_text("\n".join(lines), encoding="utf-8")
    print(f"wrote {md_path}", file=sys.stderr)


if __name__ == "__main__":
    main()
