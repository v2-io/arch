  "arch/asf/eli" -> "arch/asf/aat" [label="depends-on-critically", color="#c0392b", style="solid", dir=forward, arrowhead=normal];
  "arch/asf/eli" -> "arch/asf/llm" [label="depends-on-critically", color="#c0392b", style="solid", dir=forward, arrowhead=normal];
  "arch/asf" -> "AISI-responses" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "arch/asf" -> "arch/exp/neurips/2026" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "arch/asf" -> "causal-language" [label="predecessor-of", color="#2b6cb0", style="solid", dir=forward, arrowhead=normal];
  "arch/logos" -> "AISI-responses" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "arch/logos" -> "arch/asf" [label="depends-on-critically", color="#c0392b", style="solid", dir=forward, arrowhead=normal];
  "arch/vivarium" -> "AISI-responses" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "arch/vivarium" -> "arch/asf" [label="depends-on-critically", color="#c0392b", style="solid", dir=forward, arrowhead=normal];
  "cos" -> "limen" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "cos" -> "night-lynx-autocolors" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "memorata" -> "vestigia" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "arch/exp/neurips/2026/rev" -> "arch/exp/neurips/2026" [label="component-of", color="#8e44ad", style="dotted", dir=none];
  "operata" -> "rowan" [label="depends-on-critically", color="#c0392b", style="solid", dir=forward, arrowhead=normal];
  "operata" -> "rowan" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "rowan" -> "arch/udon" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "rowan" -> "arch/verisectorium" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "rowan" -> "vox" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "arch/comproprium" -> "AISI-responses" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "arch/corporeum" -> "limen" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "eli-migration-prep" -> "sapientia" [label="depends-on-critically", color="#c0392b", style="solid", dir=forward, arrowhead=normal];
  "ennaos" -> "autopax" [label="predecessor-of", color="#2b6cb0", style="solid", dir=forward, arrowhead=normal];
  "nexum" -> "autopax" [label="predecessor-of", color="#2b6cb0", style="solid", dir=forward, arrowhead=normal];
  "nexum" -> "ennaos" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "sapientia" -> "autopax" [label="predecessor-of", color="#2b6cb0", style="solid", dir=forward, arrowhead=normal];
  "sapientia" -> "nexum" [label="predecessor-of", color="#2b6cb0", style="solid", dir=forward, arrowhead=normal];
  "sapientia" -> "zoetica" [label="predecessor-of", color="#2b6cb0", style="solid", dir=forward, arrowhead=normal];
  "synaptic" -> "autopax" [label="predecessor-of", color="#2b6cb0", style="solid", dir=forward, arrowhead=normal];
  "synaptic" -> "sapientia" [label="predecessor-of", color="#2b6cb0", style="solid", dir=forward, arrowhead=normal];
  "tst" -> "arch/asf/tst" [label="predecessor-of", color="#2b6cb0", style="solid", dir=forward, arrowhead=normal];
  "tst" -> "sapientia" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "tst" -> "sar" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "tst" -> "shoshin" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "tst" -> "synaptic" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "zoetica" -> "autopax" [label="predecessor-of", color="#2b6cb0", style="solid", dir=forward, arrowhead=normal];
  "zoetica" -> "elixir-tui" [label="depends-on-critically", color="#c0392b", style="solid", dir=forward, arrowhead=normal];
  "zoetica" -> "ennaos" [label="predecessor-of", color="#2b6cb0", style="solid", dir=forward, arrowhead=normal];
  "zoetica" -> "tablize" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "chiridion" -> "arch/udon" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "chiridion" -> "arch/verisectorium" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "ash-exploration" -> "rowan" [label="predecessor-of", color="#2b6cb0", style="solid", dir=forward, arrowhead=normal];
  "elixir-tui" -> "glintty" [label="predecessor-of", color="#2b6cb0", style="solid", dir=forward, arrowhead=normal];
  "elixir-tui" -> "tablize" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "sapientia/cultivator" -> "sapientia" [label="component-of", color="#8e44ad", style="dotted", dir=none];
  "sapientia/weaver" -> "sapientia" [label="component-of", color="#8e44ad", style="dotted", dir=none];
  "sar" -> "ennaos" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "sar2" -> "sar" [label="component-of", color="#8e44ad", style="dotted", dir=none];
  "synaptic/cultivator" -> "synaptic" [label="component-of", color="#8e44ad", style="dotted", dir=none];
  "zoetica-ELIs" -> "zoetica" [label="component-of", color="#8e44ad", style="dotted", dir=none];
  "old-firmatum" -> "arch/asf/eli" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "old-firmatum" -> "shoshin" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "practica-cli" -> "arch/practica" [label="predecessor-of", color="#2b6cb0", style="solid", dir=forward, arrowhead=normal];

  subgraph cluster_legend {
    label="lifecycle"; fontsize=10; style=dashed; color="#aaaaaa";
    "legend-pre-release" [label="pre-release", fillcolor="#cfe8ff"];
    "legend-reference" [label="reference", fillcolor="#e6e6e6"];
    "legend-experiment" [label="experiment", fillcolor="#ffe9b3"];
    "legend-nascent" [label="nascent", fillcolor="#d9f2d9"];
  }
}
