  "shoshin" [fillcolor="#cfe8ff"];
  "synaptic" [fillcolor="#cfe8ff"];
  "synaptic/cultivator" [fillcolor="#cfe8ff"];
  "tablize" [fillcolor="#cfe8ff"];
  "tst" [fillcolor="#cfe8ff"];
  "vestigia" [fillcolor="#cfe8ff"];
  "vox" [fillcolor="#cfe8ff"];
  "zoetica" [fillcolor="#cfe8ff"];
  "zoetica-ELIs" [fillcolor="#cfe8ff"];

  "arch/principles" -> "arch/aspectus" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "arch/principles" -> "arch/project-heat" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "arch/udon" -> "descent" [label="depends-on-critically", color="#c0392b", style="solid", dir=forward, arrowhead=normal];
  "arch/verisectorium" -> "AISI-responses" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "arch/verisectorium" -> "arch/comproprium" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "arch/git-heat" -> "arch/project-heat" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
  "arch/repo-heat" -> "arch/project-heat" [label="influences", color="#7f8c8d", style="dashed", dir=forward, arrowhead=vee];
