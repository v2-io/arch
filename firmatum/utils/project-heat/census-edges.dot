  "arch/asf/aat" -> "arch/asf" [label="component-of", color="#8e44ad", style="dotted", dir=none];
  "arch/asf/tst" -> "arch/asf" [label="component-of", color="#8e44ad", style="dotted", dir=none];
  "arch/asf/tst" -> "arch/asf/aat" [label="depends-on-critically", color="#c0392b", style="solid", dir=forward, arrowhead=normal];
