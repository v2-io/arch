  "elixir-tui" [fillcolor="#cfe8ff"];
  "ennaos" [fillcolor="#cfe8ff"];
  "glintty" [fillcolor="#cfe8ff"];
  "limen" [fillcolor="#cfe8ff"];
  "memorata" [fillcolor="#cfe8ff"];
  "nexum" [fillcolor="#cfe8ff"];
  "night-lynx-autocolors" [fillcolor="#cfe8ff"];
  "old-firmatum" [fillcolor="#cfe8ff"];
  "operata" [fillcolor="#cfe8ff"];
  "practica-cli" [fillcolor="#cfe8ff"];
