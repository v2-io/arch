digraph census {
  rankdir=LR;
  graph [fontname="Helvetica", nodesep=0.35, ranksep=0.9];
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", margin="0.12,0.06"];
  edge [fontname="Helvetica", fontsize=9];

  "AISI-responses" [fillcolor="#cfe8ff"];
  "arch/asf" [fillcolor="#cfe8ff"];
  "arch/asf/aat" [fillcolor="#cfe8ff"];
  "arch/asf/eli" [fillcolor="#cfe8ff"];
  "arch/asf/llm" [fillcolor="#cfe8ff"];
