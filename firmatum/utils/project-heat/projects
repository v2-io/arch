def axis_color(ax: str, value: str, kind: str, dark: bool) -> str:
    """Hex for this cell, '' = none. Light hexes are authored; dark falls
    back to channel-inversion (the heatmap's existing convention)."""
    c = AXIS_COLORS.get(ax, {}).get(value or "undeclared", {})
    if dark:
        hx = c.get(f"{kind}-dark", "")
        if hx:
            return hx
        base = c.get(kind, "")
        return invert_hex(base) if base else ""
    return c.get(kind, "")

