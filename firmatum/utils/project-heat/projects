def edge_fields(line: str) -> list[str]:
    """Whitespace-separated fields; [brackets] guard spaces (DAG-grammar style)."""
    fields: list[str] = []
    buf: list[str] = []
    depth = 0
    for ch in line:
        if ch == "[":
            depth += 1
            buf.append(ch)
        elif ch == "]":
            depth = max(0, depth - 1)
            buf.append(ch)
        elif ch.isspace() and depth == 0:
            if buf:
                fields.append("".join(buf))
                buf = []
        else:
            buf.append(ch)
    if buf:
        fields.append("".join(buf))
    return fields


def edge_list(fieldval: str) -> list[str]:
    """Comma-list inside one field; commas inside [brackets] don't split;
    brackets are stripped from each element."""
    out: list[str] = []
    buf: list[str] = []
    depth = 0
    for ch in fieldval:
        if ch == "[":
            depth += 1
        elif ch == "]":
            depth = max(0, depth - 1)
        elif ch == "," and depth == 0:
            tok = "".join(buf).strip()
            if tok:
                out.append(tok)
            buf = []
            continue
        buf.append(ch)
    tok = "".join(buf).strip()
    if tok:
        out.append(tok)
    return [t[1:-1].strip() if t.startswith("[") and t.endswith("]") else t for t in out]


def load_edges(
    path: Path, names: list[str]
) -> tuple[dict[str, list[dict]], dict[str, list[dict]]]:
    """census-edges.txt → (edges-out by name, edges-in by name).

    Lines: `inverse: A <-> B`, `alias: NAME -> REL`, and edges
    `FROM REL TO [INV]` (sentence order; comma-lists; globs; [brackets]
    guard spaces; INV '-' = explicitly none). Both-side declarations
    collapse: a relation declared as the right side of an inverse pair
    is flipped to its left-side (canonical) form before dedupe.
    """
    out_map: dict[str, list[dict]] = {}
    in_map: dict[str, list[dict]] = {}
    if not path.is_file():
        return out_map, in_map
    inverses: dict[str, str] = {}
    canon_left: set[str] = set()
    aliases: dict[str, str] = {}
    edges: dict[tuple[str, str, str], str] = {}  # (from, to, rel) -> inv ('' = none)
    nameset = set(names)

    def expand_names(spec: str, line: str) -> list[str]:
        hits: list[str] = []
        for tok in edge_list(spec):
            if "*" in tok or "?" in tok:
                rx = glob_to_re(tok)
                found = [n for n in names if rx.match(n)]
                if not found:
                    print(
                        f"projects: census-edges: {tok!r} matches no census "
                        f"project ({line})",
                        file=sys.stderr,
                    )
                hits += found
            elif tok in nameset:
                hits.append(tok)
            else:
                print(
                    f"projects: census-edges: unknown project {tok!r} ({line})",
                    file=sys.stderr,
                )
        return hits

    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        low = line.lower()
        if low.startswith("inverse:"):
            body = line.split(":", 1)[1]
            if "<->" not in body:
                die(f"census-edges: inverse wants 'A <-> B': {line}", 2)
            a, b = (x.strip() for x in body.split("<->", 1))
            inverses[a] = b
            inverses[b] = a
            canon_left.add(a)
            continue
        if low.startswith("alias:"):
            body = line.split(":", 1)[1]
            if "->" not in body:
                die(f"census-edges: alias wants 'NAME -> REL': {line}", 2)
            a, b = (x.strip() for x in body.split("->", 1))
            aliases[a] = b
            continue
        fields = edge_fields(line)
        if len(fields) not in (3, 4):
            die(f"census-edges: edge wants 'FROM REL TO [INV]': {line}", 2)
        froms = expand_names(fields[0], line)
        rels = [aliases.get(r, r) for r in edge_list(fields[1])]
        tos = expand_names(fields[2], line)
        invs = [aliases.get(i, i) for i in edge_list(fields[3])] if len(fields) == 4 else []
        if len(rels) == 1 and len(froms) > 1:
            rels = rels * len(froms)
        if froms and len(rels) != len(froms):
            die(
                f"census-edges: {len(froms)} FROM but {len(rels)} REL "
                f"(they pair positionally): {line}",
                2,
            )
        if invs:
            if len(invs) == 1 and len(froms) > 1:
                invs = invs * len(froms)
            if froms and len(invs) != len(froms):
                die(f"census-edges: INV count mismatch: {line}", 2)
        for idx, f in enumerate(froms):
            rel = rels[idx]
            inv = invs[idx] if invs else inverses.get(rel, "")
            if inv == "-":
                inv = ""
            for t in tos:
                ff, tt, rr, ii = f, t, rel, inv
                if rel in inverses and rel not in canon_left:
                    # declared from the other side; flip to canonical
                    ff, tt, rr, ii = t, f, inverses[rel], rel
                edges.setdefault((ff, tt, rr), ii)

    for (f, t, r), inv in sorted(edges.items()):
        out_map.setdefault(f, []).append({"to": t, "rel": r})
        entry: dict = {"from": f}
        if inv or inverses.get(r):
            entry["rel"] = inv or inverses[r]
        else:
            entry["reverse-of"] = r
        in_map.setdefault(t, []).append(entry)
    return out_map, in_map


def gather(
    args: argparse.Namespace, home: Path
) -> tuple[list[Project], Filters, list[Path]]:
    cdpath = load_cdpath(home)
    home_resolved = home.resolve()
    parents: list[Path] = []
    for parent in cdpath:
        if not parent.is_dir():
            continue
        try:
            if not args.include_home and parent.resolve() == home_resolved:
                continue
        except OSError:
            continue
        parents.append(parent)

    projects = collect(parents, leaves=args.leaves, home=home)
    filters = Filters()
    if not args.no_census:
        filters = load_filters(args.census_file, home)
        if filters.exclude or filters.only:
            projects = [proj for proj in projects if not dropped(proj, filters, home)]
    return projects, filters, parents


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="projects",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=(
            "Census of cdpath work-trees, with .practica overlay.\n"
            "Default order: canonical (cdpath, then lexical)."
        ),
        epilog=(
            "commands:\n"
            "  projects [flags]                          census listing (default: names)\n"
            "  projects pd <name>                        print project dir (a `pd`\n"
            "                                            symlink to this script works too)\n"
            "  projects set <name-or-path> field=value   freeze an override\n"
            "  projects set <name-or-path> <axis-value>   bare shorthand (see AXES)\n"
            "  projects unset <name-or-path> field [f…]  unfreeze + clear; detection\n"
            "                                            and census defaults refill\n"
            "  projects heatmap                          17-week inferno rows (activity=active)\n"
            "  projects heatmap --double | --triple      + 17 / 34 older weeks below\n"
            "  projects feedback <text…>                 report friction to the inbox\n"
            "\n"
            f"Census file: {DEFAULT_CENSUS}\n"
            "Each project root gets a .practica (JSON), which is also the cache —\n"
            "note the tool WRITES those files into project roots on every run\n"
            "(--no-write to suppress). Default runs reuse the cache; --refresh\n"
            "reruns git/session detection. Frozen fields are never overwritten.\n"
            "Nested names: second pass, closest-to-~ first; parent is another\n"
            "census project whose root prefixes this one.\n"
            "\n"
            "AXES — seven per-project facts (TAXONOMY-PLAN.md). git-rel /\n"
            "git-vis / proj-rel are detected; lifecycle / activity / local-use /\n"
            "public-use are declared (census `default <axis>=<value>: glob…`\n"
            "lines set defaults; `projects set` freezes per-project; local-use\n"
            "and public-use default to 'undeclared'). The old `disposition`\n"
            "field is retired and ignored — not migrated; refusals name the\n"
            "axes an old token splits into. --refresh also asks `gh` for each\n"
            "github remote's visibility (cached as gh-visibility; a measured\n"
            "'public' flips an internal-org repo's git-vis to public; absent\n"
            "when gh is unavailable — normal runs never touch the network).\n"
            "\n"
            "-v shows a 7-char block, one column per axis, '·' = undeclared\n"
            "(glyphs are a PROVISIONAL v0 vocabulary):\n"
            "  1 git-rel     g gitroot  s submodule  j subgit  - no-git  G group\n"
            "  2 git-vis     l local  p private  P public  x external  G group\n"
            "  3 lifecycle   n nascent  e experiment  1 pre-poc  2 pre-mvp\n"
            "                3 pre-release  o ongoing  m maintenance  r reference\n"
            "  4 activity    a active  = paused  w watch  z archived\n"
            "  5 proj-rel    R root  m mid  l leaf  i isolated\n"
            "  6 local-use   p pending  i pilot  t transition  2 secondary  1 primary\n"
            "  7 public-use  u unlikely  e peers-only  ? undecided  n planned\n"
            "                r preprint  s submitted  a accepted  P published\n"
            "                E early  B broad\n"
            "\n"
            f"Edges: {DEFAULT_EDGES.name} beside the census — typed relations\n"
            "(`FROM REL TO [INV]`, sentence order; inverse:/alias: lines;\n"
            "[brackets] guard spaces). Exposed per-project in --format=json\n"
            "as edges-out / edges-in.\n"
            "\n"
            "Sort (listing and heatmap): default canonical; -g headings;\n"
            "-c change-date; -a alphabetical. -g combines with -c/-a as\n"
            "headings plus that order within each cdpath group.\n"
            "\n"
            "Heatmap week stats read `| 25·254|` = distinct projects · total\n"
            "commits that week. In a pipe (or --color=never) the heatmap is\n"
            "glyphs: ▁▂▃▄▅▆▇█ heat (log), · pre-birth, blank zero/stale.\n"
            "\n"
            "examples:\n"
            "  projects -vc                   axes + paths, most recently touched first\n"
            "  projects -vvv                  the full table (last-action, git, desc)\n"
            "  projects heatmap --triple -c   ~a year of activity, stacked bands\n"
            "  aspectus $(pd arch)            use a project root in another command\n"
            "  projects set cos experiment    freeze lifecycle=experiment\n"
            "  projects set x pre-mvp paused  bare tokens resolve to their axes\n"
            "  projects --format=json -c      census records + edges for machines"
        ),
    )
    p.add_argument(
        "-v",
        "--verbose",
        action="count",
        default=0,
        dest="verbose",
        help="counting verbosity: (none) names → -v axes+paths → -vv +desc "
        "→ -vvv +last/git",
    )
    p.add_argument("-n", "--names", action="store_true", help="names only (full name)")
    p.add_argument("-p", "--paths", action="store_true", help="absolute paths only")
    order = p.add_mutually_exclusive_group()
    order.add_argument(
        "-c",
        "--changed",
        action="store_true",
        help="sort by last-action-time (newest first)",
    )
    order.add_argument(
        "-a",
        "--alpha",
        "-S",
        "--sorted",
        action="store_true",
        help="sort alphabetically by name",
    )
    p.add_argument(
        "-g",
        "--group",
        action="store_true",
        help="group headings by cdpath parent (canonical, or with -c/-a within groups)",
    )
    span = p.add_mutually_exclusive_group()
    span.add_argument(
        "--double",
        action="store_true",
        help="heatmap: stack the previous 17 weeks below, weeks aligned",
    )
    span.add_argument(
        "--triple",
        action="store_true",
        help="heatmap: stack two older 17-week bands (~a year)",
    )
    p.add_argument(
        "-H",
        "--home",
        action="store_true",
        dest="include_home",
        help="include $HOME children (Desktop, Documents, …)",
    )
    p.add_argument(
        "-l",
        "--leaves",
        action="store_true",
        help="skip children that are themselves cdpath parents",
    )
    p.add_argument(
        "-s",
        "--shadows",
        action="store_true",
        help="show later same-name directories cd would not use",
    )
    p.add_argument(
        "-0",
        dest="nul",
        action="store_true",
        help="NUL-separate (implies -p)",
    )
    p.add_argument(
        "--color",
        choices=["auto", "always", "never"],
        default="auto",
        help="auto (default) colors only a TTY; a pipe gets the plain "
        "glyph rendering (heatmap: ▁▂▃▄▅▆▇█ ramp, · pre-birth)",
    )
    p.add_argument(
        "--version",
        action="version",
        version=version_string(),
    )
    p.add_argument(
        "--format",
        choices=["table", "json"],
        default="table",
        help="json: census records (facts — ISO times, booleans, paths); "
        "for heatmap, per-project day counts plus the scale",
    )
    p.add_argument(
        "--no-write",
        action="store_true",
        help="do not write .practica files",
    )
    p.add_argument(
        "--refresh",
        action="store_true",
        help="recompute git / last-action / last-session (ignore .practica cache)",
    )
    p.add_argument(
        "--no-census",
        "--no-exclude",
        dest="no_census",
        action="store_true",
        help="do not apply census-details.txt (drop, only, disposition)",
    )
    p.add_argument(
        "--census-file",
        "--exclude-file",
        dest="census_file",
        type=Path,
        default=DEFAULT_CENSUS,
        metavar="PATH",
        help="census file (default: census-details.txt next to this script)",
    )
    return p


def main(argv: list[str] | None = None) -> int:
    try:
        locale.setlocale(locale.LC_COLLATE, "")
    except locale.Error:
        pass
    if argv is None:
        argv = sys.argv[1:]
    parser = build_parser()
    prog = Path(sys.argv[0]).name if sys.argv else ""
    if prog == "pd":
        return cmd_pd(argv, parser.parse_args([]))
    if argv and argv[0] == "pd":
        return cmd_pd(argv[1:], parser.parse_args([]))
    if argv and argv[0] == "feedback":
        return cmd_feedback(argv[1:])
    if argv and argv[0] == "set":
        list_ns = parser.parse_args([])
        return cmd_set(argv[1:], list_ns)
    if argv and argv[0] == "unset":
        return cmd_unset(argv[1:], parser.parse_args([]))
    if argv and argv[0] == "heatmap":
        return cmd_heatmap(parser.parse_args(argv[1:]))

    args = parser.parse_args(argv)
    if args.names and args.paths:
        die("--names and --paths are mutually exclusive", 2)
    if args.nul:
        args.paths = True

    home = Path.home()
    projects, filters, parents = gather(args, home)
    populate(
        projects,
        filters,
        home,
        write=not args.no_write,
        refresh=args.refresh,
    )
    if args.format == "json":
        edges_out, edges_in = load_edges(
            DEFAULT_EDGES, [display_name(p) for p in projects]
        )
        out = []
        for proj in sort_projects(projects, sort_mode_from_args(args)):
            rec = ordered_record(proj.rec)
            rec["path"] = str(proj.path)
            name = display_name(proj)
            if edges_out.get(name):
                rec["edges-out"] = edges_out[name]
            if edges_in.get(name):
                rec["edges-in"] = edges_in[name]
            out.append(rec)
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return 0
    emit_table(
        projects,
        parents,
        names_only=args.names,
        paths_only=args.paths,
        grouped=args.group,
        sort_mode=sort_mode_from_args(args),
        show_shadows=args.shadows,
        nul=args.nul,
        home=home,
        now=datetime.now(tz=timezone.utc).timestamp(),
        use_color=color_enabled(args.color),
        verbosity=args.verbose,
    )
    return 0


if __name__ == "__main__":
    try:
        code = main()
    except KeyboardInterrupt:
        code = 130
    except BrokenPipeError:
        # e.g. `projects | head` — the cut is the caller's, not an error
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        code = 0
    raise SystemExit(code)
