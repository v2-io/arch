def _interp_hex_ramp(colors: list[str], n: int) -> list[str]:
    rgb = []
    for h in colors:
        h = h.lstrip("#")
        rgb.append((int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)))
    out: list[str] = []
    last = len(rgb) - 1
    for i in range(n):
        t = 0.0 if n == 1 else i / (n - 1)
        x = t * last
        lo = int(x)
        hi = min(lo + 1, last)
        f = x - lo
        r = round(rgb[lo][0] * (1 - f) + rgb[hi][0] * f)
        g = round(rgb[lo][1] * (1 - f) + rgb[hi][1] * f)
        b = round(rgb[lo][2] * (1 - f) + rgb[hi][2] * f)
        out.append(f"#{r:02x}{g:02x}{b:02x}")
    return out


