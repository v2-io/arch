def parse_set_value(key: str, raw: str) -> object:
    if key in {"categories", "related", "extra-noise", "frozen"}:
        if not raw.strip():
            return []
        return [p.strip() for p in raw.split(",") if p.strip()]
    if key == "has-remote":
        v = raw.strip().lower()
        if v in {"1", "true", "yes", "y"}:
            return True
        if v in {"0", "false", "no", "n"}:
            return False
        die(f"set: {key} wants true/false, got {raw!r}", 2)
    if key in AXES:
        v = raw.strip()
        if v not in AXES[key]:
            die(f"set: {key} wants one of {', '.join(AXES[key])}; got {v!r}", 2)
        return v
    if key == "highlight":
        try:
            n = int(raw.strip())
        except ValueError:
            die(f"set: highlight wants 0–10, got {raw!r}", 2)
        if n < 0 or n > 10:
            die(f"set: highlight wants 0–10, got {raw!r}", 2)
        return n
    return raw


def find_project(ident: str, projects: list[Project], home: Path) -> Project:
    expanded = expand_userish(ident, home)
    cand_path = Path(expanded)
    if cand_path.exists():
        try:
            want = cand_path.resolve()
        except OSError:
            want = cand_path
        hits = [p for p in projects if resolved(p) == want]
        if len(hits) == 1:
            return hits[0]
    hits = [
        p
        for p in projects
        if display_name(p) == ident or p.cd_name == ident or p.rec.get("base-name") == ident
    ]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        names = ", ".join(display_name(p) for p in hits)
        die(f"{ident!r} is ambiguous ({names})", 2)
    die(f"no census project matching {ident!r} (list names: projects -n)", 2)


def cmd_set(argv: list[str], list_ns: argparse.Namespace) -> int:
    if not argv or argv[0] in {"-h", "--help"}:
        print("usage: projects set <name-or-path> field=value [field=value…]")
        print("       projects set <name-or-path> <axis-value> [<axis-value>…]")
        print("fields:", ", ".join(sorted(SET_FIELDS)))
        print("a bare token is an axis value (unique across axes); 'group'")
        print("sets git-rel AND git-vis; rel-group / vis-group pick one.")
        print("legacy disposition tokens (active-exp, ref-only, …) translate")
        print("to activity/lifecycle and print what they applied.")
        print("marks each field frozen in that project's .practica")
        return 0 if argv and argv[0] in {"-h", "--help"} else 2
    ident = argv[0]
    pairs = argv[1:]
    if not pairs:
        die("set: need at least one field=value (or an axis value)", 2)
    updates: list[tuple[str, object]] = []
    notes: list[str] = []

    for pair in pairs:
        if "=" not in pair:
            tok = pair.strip()
            if tok in RETIRED_DISPOSITIONS and tok not in VALUE_AXIS:
                die(
                    f"set: {tok!r} is a retired disposition — say what you "
                    f"mean on the axes, e.g.: {RETIRED_DISPOSITIONS[tok]}",
                    2,
                )
            if tok == "group":
                updates.append(("git-rel", "group"))
                updates.append(("git-vis", "group"))
            elif tok == "rel-group":
                updates.append(("git-rel", "group"))
            elif tok == "vis-group":
                updates.append(("git-vis", "group"))
            elif tok in VALUE_AXIS:
                updates.append((VALUE_AXIS[tok], tok))
            else:
                die(
                    f"set: unknown axis value {tok!r} — see --help for the "
                    "axis vocabularies (or use field=value)",
                    2,
                )
            continue
        k, v = pair.split("=", 1)
        if k == "disposition":
            hint = RETIRED_DISPOSITIONS.get(
                v.strip(), "activity=… lifecycle=… (see --help AXES)"
            )
            die(f"set: 'disposition' is retired — say what you mean: {hint}", 2)
        if k not in SET_FIELDS:
            die(f"set: unknown field {k!r} (want {', '.join(sorted(SET_FIELDS))})", 2)
        updates.append((k, parse_set_value(k, v)))

    home = Path.home()
    projects, filters, _parents = gather(list_ns, home)
    populate(projects, filters, home, write=True, refresh=False)
    proj = find_project(ident, projects, home)
    for k, v in updates:
        set_explicit(proj.rec, k, v)
    save_practica(proj.path, proj.rec)
    pass2_names(projects, write=True)
    print(f"{display_name(proj)}  {disp(proj.path, home)}")
    for note in notes:
        print(f"  {note}")
    for k, _ in updates:
        print(f"  {k}={proj.rec.get(k)!r}  (frozen)")
    return 0


