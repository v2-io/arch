def load_axis_glyphs() -> tuple[dict[str, dict[str, str]], dict[str, dict[str, dict[str, str]]]]:
    """Built-in glyph table overlaid with axis-glyphs.json, plus a color
    table. Per-axis keys: `glyph-<value>` (one char), `fg-<value>` /
    `bg-<value>` (hex for a light terminal; "" = none), and optional
    `fg-dark-<value>` / `bg-dark-<value>` (dark terminals otherwise get
    the channel-inverted light color, matching the heatmap convention).
    A bare `<value>: glyph` entry still reads as a glyph. Colors are
    presentation only — applied solely on the TTY/--color path; pipes
    and agents get bare glyphs untouched. Missing file is fine;
    unreadable warns and falls back; bad entries are skipped with notes."""
    table = {ax: dict(vals) for ax, vals in AXIS_GLYPHS_BUILTIN.items()}
    colors: dict[str, dict[str, dict[str, str]]] = {}
    try:
        raw = json.loads(GLYPHS_FILE.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return table, colors
    except (OSError, json.JSONDecodeError) as e:
        print(
            f"projects: {GLYPHS_FILE.name} unreadable ({e}); using built-in glyphs",
            file=sys.stderr,
        )
        return table, colors

    def note(msg: str) -> None:
        print(f"projects: {GLYPHS_FILE.name}: {msg}", file=sys.stderr)

    if not isinstance(raw, dict):
        return table, colors
    prefixes = ("glyph-", "fg-dark-", "bg-dark-", "fg-", "bg-")
    for ax, vals in raw.items():
        if ax not in table or not isinstance(vals, dict):
            note(f"unknown axis {ax!r} skipped")
            continue
        allowed = set(AXES[ax]) | {"undeclared"}
        for key, g in vals.items():
            kind, value = "glyph", key
            for pre in prefixes:
                if key.startswith(pre):
                    kind, value = pre[:-1], key[len(pre):]
                    break
            if value not in allowed:
                note(f"unknown {ax} value {value!r} skipped")
                continue
            if kind == "glyph":
                if not isinstance(g, str) or not g:
                    note(f"{ax}.{value} glyph must be a non-empty string, got {g!r} — skipped")
                    continue
                table[ax][value] = g
            else:
                if not isinstance(g, str) or (g and not _HEX_RE.match(g)):
                    note(f"{ax}.{key} wants '#rrggbb' or '', got {g!r} — skipped")
                    continue
                if g:
                    colors.setdefault(ax, {}).setdefault(value, {})[kind] = g
    return table, colors


