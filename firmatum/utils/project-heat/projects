    """`projects unset <name> field [field…]` — remove the frozen mark and
    the stored value; detection / census defaults refill immediately."""
    if not argv or argv[0] in {"-h", "--help"}:
        print("usage: projects unset <name-or-path> field [field…]")
        print("removes each field from `frozen` and clears the stored value;")
        print("detection and census defaults refill it on the same run")
