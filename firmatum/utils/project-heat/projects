            "and public-use default to 'undeclared'). The old `disposition`\n"
            "field is retired and ignored — not migrated; refusals name the\n"
            "axes an old token splits into. --refresh also asks `gh` for each\n"
            "github remote's visibility (cached as gh-visibility) — the\n"
            "primary source for an internal-org repo's public/private;\n"
            "freeze git-vis to override. Normal runs never touch the network.\n"
            "\n"
            + axes_help_text() + "\n"
            "\n"
            f"public-use floors to 'published' when measured gh\n"
            f"stars+forks+watchers > {GH_PUBLISHED_THRESHOLD} (derived; declared/frozen win).\n"
            "\n"
            f"Edges: {DEFAULT_EDGES.name} beside the census — typed relations\n"
            "(`FROM REL TO [INV]`, sentence order; inverse:/alias: lines;\n"
            "[brackets] guard spaces). Exposed per-project in --format=json\n"
            "as edges-out / edges-in.\n"
            "\n"
            "Sort (listing and heatmap): default canonical; -g headings;\n"
            "-c change-date; -a alphabetical. -g combines with -c/-a as\n"
            "headings plus that order within each cdpath group.\n"
            "\n"
            f"Heatmap heat is a forward EWMA of daily commits ({SMOOTH_HALF_LIFE_DAYS:g}d\n"
            f"half-life, in commit units, shown minus {SMOOTH_FLOOR:g} so the decay fades\n"
            "white). Days before a project's first commit get an onramp: the\n"
            "same filter run backward from its opening commits, steeper\n"
            f"({ONRAMP_HALF_LIFE_DAYS:g}d half-life). --strict shows raw counts only. Week\n"
            "stats read `| 25·254|` = projects with commits (or the onramp) ·\n"
            "total raw commits that week. In a pipe (or --color=never) the\n"
            "heatmap is glyphs:\n"
            "▁▂▃▄▅▆▇█ heat (log), · pre-birth, blank zero/stale.\n"
            "\n"
            "examples:\n"
            "  projects -vc                   axes + paths, most recently touched first\n"
            "  projects -vvv                  the full table (last-action, git, desc)\n"
            "  projects heatmap --triple -c   ~a year of activity, stacked bands\n"
            "  aspectus $(pd arch)            use a project root in another command\n"
            "  projects set cos experiment    freeze lifecycle=experiment\n"
            "  projects set x pre-mvp paused  bare tokens resolve to their axes\n"
            "  projects --format=json -c      census records + edges for machines"
        ),
    )
    p.add_argument(
        "-v",
        "--verbose",
        action="count",
        default=0,
        dest="verbose",
        help="counting verbosity: (none) names → -v axes+paths → -vv +desc "
        "→ -vvv +last/git",
    )
    p.add_argument("-n", "--names", action="store_true", help="names only (full name)")
    p.add_argument("-p", "--paths", action="store_true", help="absolute paths only")
    order = p.add_mutually_exclusive_group()
    order.add_argument(
        "-c",
        "--changed",
        action="store_true",
        help="sort by last-action-time (newest first)",
    )
    order.add_argument(
        "-a",
        "--alpha",
        "-S",
        "--sorted",
        action="store_true",
        help="sort alphabetically by name",
    )
    p.add_argument(
        "-g",
        "--group",
        action="store_true",
        help="group headings by cdpath parent (canonical, or with -c/-a within groups)",
    )
    span = p.add_mutually_exclusive_group()
    span.add_argument(
        "--double",
        action="store_true",
        help="heatmap: stack the previous 17 weeks below, weeks aligned",
    )
    span.add_argument(
        "--triple",
        action="store_true",
        help="heatmap: stack two older 17-week bands (~a year)",
    )
    p.add_argument(
        "--strict",
        action="store_true",
        help="heatmap: raw daily counts — no EWMA smoothing, no birth onramp",
    )
    p.add_argument(
        "-H",
        "--home",
        action="store_true",
        dest="include_home",
        help="include $HOME children (Desktop, Documents, …)",
    )
    p.add_argument(
        "-l",
        "--leaves",
        action="store_true",
        help="skip children that are themselves cdpath parents",
    )
    p.add_argument(
        "-s",
        "--shadows",
        action="store_true",
        help="show later same-name directories cd would not use",
    )
    p.add_argument(
        "-0",
        dest="nul",
        action="store_true",
        help="NUL-separate (implies -p)",
    )
    p.add_argument(
        "--color",
        choices=["auto", "always", "never"],
        default="auto",
        help="auto (default) colors only a TTY; a pipe gets the plain "
        "glyph rendering (heatmap: ▁▂▃▄▅▆▇█ ramp, · pre-birth)",
    )
    p.add_argument(
        "--version",
        action="version",
        version=version_string(),
    )
    p.add_argument(
        "--format",
        choices=["table", "json"],
        default="table",
        help="json: census records (facts — ISO times, booleans, paths); "
        "for heatmap, per-project day counts plus the scale",
    )
    p.add_argument(
        "--no-write",
        action="store_true",
        help="do not write .practica files",
    )
    p.add_argument(
        "--refresh",
        action="store_true",
        help="recompute git / last-action / last-session (ignore .practica cache)",
    )
    p.add_argument(
        "--no-census",
        "--no-exclude",
        dest="no_census",
        action="store_true",
        help="do not apply census-details.txt (drop, only, disposition)",
    )
    p.add_argument(
        "--census-file",
        "--exclude-file",
        dest="census_file",
        type=Path,
        default=DEFAULT_CENSUS,
        metavar="PATH",
        help="census file (default: census-details.txt next to this script)",
    )
    return p


def main(argv: list[str] | None = None) -> int:
    try:
        locale.setlocale(locale.LC_COLLATE, "")
    except locale.Error:
        pass
    if argv is None:
        argv = sys.argv[1:]
    parser = build_parser()
    prog = Path(sys.argv[0]).name if sys.argv else ""
    if prog == "pd":
        return cmd_pd(argv, parser.parse_args([]))
    if argv and argv[0] == "pd":
        return cmd_pd(argv[1:], parser.parse_args([]))
    if argv and argv[0] == "feedback":
        return cmd_feedback(argv[1:])
    if argv and argv[0] == "set":
        list_ns = parser.parse_args([])
        return cmd_set(argv[1:], list_ns)
    if argv and argv[0] == "unset":
        return cmd_unset(argv[1:], parser.parse_args([]))
    if argv and argv[0] == "heatmap":
        return cmd_heatmap(parser.parse_args(argv[1:]))
    if argv and argv[0] == "dag":
        list_ns = parser.parse_args([])
        return cmd_dag(argv[1:], list_ns)

    args = parser.parse_args(argv)
    if args.names and args.paths:
        die("--names and --paths are mutually exclusive", 2)
    if args.nul:
        args.paths = True

    home = Path.home()
    projects, filters, parents = gather(args, home)
    populate(
        projects,
        filters,
        home,
        write=not args.no_write,
        refresh=args.refresh,
    )
    if args.format == "json":
        edges_out, edges_in = load_edges(
            DEFAULT_EDGES, [display_name(p) for p in projects]
        )
        out = []
        for proj in sort_projects(projects, sort_mode_from_args(args)):
            rec = ordered_record(proj.rec)
            rec["path"] = str(proj.path)
            name = display_name(proj)
            if edges_out.get(name):
                rec["edges-out"] = edges_out[name]
            if edges_in.get(name):
                rec["edges-in"] = edges_in[name]
            out.append(rec)
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return 0
    emit_table(
        projects,
        parents,
        names_only=args.names,
        paths_only=args.paths,
        grouped=args.group,
        sort_mode=sort_mode_from_args(args),
        show_shadows=args.shadows,
        nul=args.nul,
        home=home,
        now=datetime.now(tz=timezone.utc).timestamp(),
        use_color=color_enabled(args.color),
        verbosity=args.verbose,
    )
    return 0


if __name__ == "__main__":
    try:
        code = main()
    except KeyboardInterrupt:
        code = 130
    except BrokenPipeError:
        # e.g. `projects | head` — the cut is the caller's, not an error
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        code = 0
    raise SystemExit(code)
