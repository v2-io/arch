def display_name(proj: Project) -> str:
    return str(proj.rec.get("name") or proj.cd_name)


def sort_mode_from_args(args: argparse.Namespace) -> str:
    if getattr(args, "alpha", False):
        return "alpha"
    if getattr(args, "changed", False):
        return "changed"
    return "canonical"


def sort_projects(projects: list[Project], mode: str) -> list[Project]:
    if mode == "alpha":
        return sorted(projects, key=lambda p: name_key(display_name(p)))
    if mode == "changed":

        def action_ts(p: Project) -> float:
            t = parse_ts(p.rec.get("last-action-time"))
            if t is None:
                t = parse_ts(p.rec.get("last-commit-time"))
            return t if t is not None else float("-inf")

        return sorted(projects, key=action_ts, reverse=True)
    return list(projects)


def git_cell(proj: Project, by_root: dict[Path, str]) -> str:
    rec = proj.rec
    own = bool(rec.get("git"))
    subgit = bool(rec.get("subgit"))
    submodule = bool(rec.get("submodule"))
    remote = str(rec.get("remote") or "")
    if own:
        if rec.get("has-remote") and remote:
            cell = None
            if remote.startswith(("/", "~")) or remote.startswith("file://"):
                raw = remote[len("file://") :] if remote.startswith("file://") else remote
                try:
                    rp = Path(raw).expanduser().resolve()
                except OSError:
                    rp = Path(raw).expanduser()
                if rp in by_root:
                    cell = f"({by_root[rp]})"
            if cell is None:
                cell = remote
                for prefix in ("https://github.com/", "git@github.com:"):
                    if cell.startswith(prefix):
                        cell = cell[len(prefix) :]
                        break
                if cell.endswith(".git"):
                    cell = cell[: -len(".git")]
        else:
            cell = "(local)"
        if submodule:
            cell += " (sub)"
        return cell
    if subgit:
        parent = str(rec.get("parent-name") or "")
        return f"({parent})" if parent else "(parent)"
    return "--"


def emit_table(
    projects: list[Project],
    cdpath_parents: list[Path],
    *,
    names_only: bool,
    paths_only: bool,
    grouped: bool,
    sort_mode: str,
    show_shadows: bool,
    nul: bool,
    home: Path,
    now: float,
) -> None:
    by_root: dict[Path, str] = {}
    for p in projects:
        try:
            by_root[p.path.resolve()] = display_name(p)
        except OSError:
            by_root[p.path] = display_name(p)

    def row_cells(proj: Project) -> tuple[str, str, str, str, str]:
        extra = ""
        if show_shadows and proj.shadows:
            extra = "  (shadows " + ", ".join(disp(s, home) for s in proj.shadows) + ")"
        return (
            display_name(proj),
            ago(parse_ts(proj.rec.get("last-action-time")), now),
            str(proj.rec.get("disposition") or "—"),
            git_cell(proj, by_root),
            disp(proj.path, home) + extra,
        )

    def row(proj: Project) -> None:
        if nul:
            sys.stdout.buffer.write(os.fsencode(proj.path) + b"\0")
            return
        if names_only:
            print(display_name(proj))
            return
        if paths_only:
            print(proj.path)
            return
        nm, last, disp_s, git_s, path_s = row_cells(proj)
        print(f"{nm:<{nw}}  {last:<{lw}}  {disp_s:<{dw}}  {git_s:<{gw}}  {path_s}")

    if names_only or paths_only or nul:
        nw = lw = dw = gw = 1
    else:
        cells = [row_cells(p) for p in projects]
        nw = max([len("NAME")] + [len(c[0]) for c in cells])
        lw = max([len("LAST")] + [len(c[1]) for c in cells])
        dw = max([len("DISP")] + [len(c[2]) for c in cells])
        gw = max([len("GIT")] + [len(c[3]) for c in cells])
        print(f"{'NAME':<{nw}}  {'LAST':<{lw}}  {'DISP':<{dw}}  {'GIT':<{gw}}  PATH")

    if grouped:
        by_parent: dict[Path, list[Project]] = {p: [] for p in cdpath_parents}
        for proj in projects:
            by_parent.setdefault(proj.cdpath_parent, []).append(proj)
        first = True
        for parent in cdpath_parents:
            group = by_parent.get(parent, [])
            if not group:
                continue
            group = sort_projects(group, sort_mode)
            if not names_only and not paths_only and not nul:
                if not first:
                    print()
                print(f"# {disp(parent, home)}")
                first = False
            for proj in group:
                row(proj)
        if not names_only and not paths_only and not nul and not first:
            print()
        return

    for proj in sort_projects(list(projects), sort_mode):
        row(proj)


def elide(s: str, width: int = HEATMAP_NAME_W) -> str:
    if len(s) <= width:
        return s
    if width <= 1:
        return "…"[:width]
    return s[: width - 1] + "…"


def hex_rgb(h: str) -> tuple[int, int, int]:
    h = h.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def ansi_block(hex_color: str) -> str:
    r, g, b = hex_rgb(hex_color)
    return f"\x1b[38;2;{r};{g};{b}m█"


def heatmap_window(today: date | None = None) -> list[date]:
    """Newest first (far left = today).

    Always 17 complete Sun–Sat weeks plus the current week through today.
    Grows one column a day (Sun = shortest, Sat = longest); the next Sunday
    drops the oldest full week and snaps back.
    """
    if today is None:
        today = datetime.now().astimezone().date()
    into = (today.weekday() + 1) % 7  # 0 on Sunday, 6 on Saturday
    n = HEATMAP_FULL_WEEKS * 7 + into + 1
    return [today - timedelta(days=i) for i in range(n)]


def local_day(ts: float) -> date:
    return datetime.fromtimestamp(ts).date()


def prune_days(days: dict, window: list[date]) -> dict[str, int]:
    keep = {d.isoformat() for d in window}
    return {k: int(v) for k, v in days.items() if k in keep and int(v) > 0}


def add_timestamps(days: dict[str, int], stamps: list[float]) -> None:
    for ts in stamps:
        key = local_day(ts).isoformat()
        days[key] = days.get(key, 0) + 1


def git_commit_times_since(
    root: Path, after_ts: float, pathspecs: list[str] | None = None
) -> list[float] | None:
    specs = pathspecs or ["."]
    code, out = git_run(
        root,
        "log",
        "--pretty=format:%ct",
        f"--after={int(after_ts)}",
        "--",
        *specs,
        timeout=60,
    )
    if code != 0:
        return None
    stamps: list[float] = []
    for line in out.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            stamps.append(float(line))
        except ValueError:
            continue
    return stamps


def git_first_commit_ts(
    root: Path, pathspecs: list[str] | None = None
) -> float | None:
    """Oldest commit touching pathspecs. Default log is newest-first; take the last line.

    `git log --reverse -1` is *not* this — `-1`/`--max-count` selects before
    reverse, so you get the newest commit printed once.
    """
    specs = pathspecs or ["."]
    code, out = git_run(
        root, "log", "--pretty=format:%ct", "--", *specs, timeout=60
    )
    if code != 0 or not out:
        return None
    lines = [ln.strip() for ln in out.splitlines() if ln.strip()]
    if not lines:
        return None
    try:
        return float(lines[-1])
    except ValueError:
        return None


def macos_dark() -> bool:
    try:
        r = subprocess.run(
            ["defaults", "read", "-g", "AppleInterfaceStyle"],
            capture_output=True,
            text=True,
            timeout=1,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return r.returncode == 0 and "Dark" in (r.stdout or "")


def scale_t(count: int, maxc: int) -> float:
    """log1p t in [0, 1] matching activity colors. 0 if no count/max."""
    if count <= 0 or maxc <= 0:
        return 0.0
    t = math.log1p(count) / math.log1p(maxc)
    return max(1.0 / (_INFERNO_N - 1), min(1.0, t))


def idle_span_days(last_count: int, maxc: int) -> int:
    """Head-fade length: 14 days at scale max, ~1–2 days for a couple of commits."""
    t = scale_t(last_count, maxc)
    if t <= 0:
        return DIM_HEAD_DAYS
    return max(1, int(round(DIM_HEAD_DAYS * t)))


def dim_zero_fills(
    window: list[date],
    days: dict[str, int],
    first_ts: float | None,
    last_commit_ts: float | None = None,
    *,
    dark: bool,
    maxc: int = 0,
) -> dict[str, str]:
    """iso → hex for cells that shouldn't use inferno.

    Head (newest / left): idle walks the heat scale from the last
    non-zero day's t down to 0 (not an RGB lerp). Fade length scales
    with that day's count vs the grid max. Tail (oldest / right): wash
    #e6e6f1 except a 4-day onramp up the heat scale to t=0.5 (not the
    hot end), only if first-ever commit is in-window and suffix ≥7.
    """
    invert = not dark
    wash = invert_hex(TAIL_WASH_LIGHT) if dark else TAIL_WASH_LIGHT
    mid = inferno_hex(0.5, invert=invert)
    counts = [int(days.get(d.isoformat(), 0)) for d in window]
    n = len(window)
    fills: dict[str, str] = {}
    if n == 0:
        return fills

    i = 0
    while i < n and counts[i] == 0:
        i += 1
    k = n - 1
    while k >= 0 and counts[k] == 0:
        k -= 1
    suffix = n - 1 - k
    all_zero = i + suffix >= n and i > 0

    born_in_window = False
    if first_ts is not None:
        first_d = local_day(first_ts)
        born_in_window = window[-1] <= first_d <= window[0]

    def head_ramp(prefix_len: int) -> None:
        last_c = local_day(last_commit_ts) if last_commit_ts is not None else None
        last_count = 0
        if 0 <= prefix_len < n:
            last_count = counts[prefix_len]
        elif i < n:
            last_count = counts[i]
        t0 = scale_t(last_count, maxc)
        span = idle_span_days(last_count, maxc)
        zero = inferno_hex(0.0, invert=invert)
        for j in range(prefix_len):
            d = window[j]
            if last_c is None:
                fills[d.isoformat()] = zero
                continue
            idle = (d - last_c).days
            if idle < 1:
                continue
            progress = min(1.0, idle / span)
            t = t0 * (1.0 - progress)
            fills[d.isoformat()] = inferno_hex(t, invert=invert)

    def paint_tail(start: int) -> None:
        for j in range(start, n):
            fills[window[j].isoformat()] = wash
        if first_ts is None:
            return
        first_d = local_day(first_ts)
        for ahead in range(1, 5):
            d = first_d - timedelta(days=ahead)
            iso = d.isoformat()
            if iso in fills:
                t = 0.5 * (5 - ahead) / 4.0
                fills[iso] = inferno_hex(t, invert=invert)

    if all_zero:
        if born_in_window and first_ts is not None:
            first_d = local_day(first_ts)
            j = 0
            while j < n and window[j] > first_d:
                j += 1
            if j > 0:
                head_ramp(j)
            t = n - 1
            while t >= 0 and window[t] < first_d:
                t -= 1
            if n - 1 - t >= DIM_ZERO_MIN:
                paint_tail(t + 1)
        elif i > 0:
            head_ramp(i)
        if first_ts is not None:
            biso = local_day(first_ts).isoformat()
            if days.get(biso, 0) == 0 and any(d.isoformat() == biso for d in window):
                fills[biso] = mid
        return fills

    if i > 0:
        head_ramp(i)
    if born_in_window and suffix >= DIM_ZERO_MIN:
        paint_tail(k + 1)
    if first_ts is not None:
        biso = local_day(first_ts).isoformat()
        if days.get(biso, 0) == 0 and any(d.isoformat() == biso for d in window):
            fills[biso] = mid
    return fills


def heatmap_counts(
    proj: Project,
    window: list[date],
    projects: list[Project],
    *,
    refresh: bool,
    write: bool,
) -> dict[str, int]:
    rec = proj.rec
    extra = rec.get("extra-noise") or []
    extra_s = [str(x) for x in extra] if isinstance(extra, list) else []
    gitish = bool(rec.get("git") or rec.get("subgit"))
    kids = census_child_rels(proj, projects)
    specs = git_pathspecs(kids)
    kids_changed = list(rec.get("heatmap-kids") or []) != kids
    head = containing_head_id(proj.path) if gitish else None
    head_changed = bool(gitish) and rec.get("heatmap-head") != head

    if gitish and (refresh or kids_changed or not rec.get("first-commit")):
        fts = git_first_commit_ts(proj.path, specs)
        if fts is not None:
            set_derived(rec, "first-commit", iso_utc(fts))
    if not gitish:
        # No commit stream: file birth + mtime are the proxy for change-counts.
        # Active no-git rows are tiny; still reuse the day cache unless refresh.
        cached_ng = rec.get("heatmap-days") if isinstance(rec.get("heatmap-days"), dict) else {}
        if not refresh and rec.get("first-commit") and cached_ng:
            return prune_days(
                {str(k): int(v) for k, v in cached_ng.items() if str(k)},
                window,
            )
        events = file_event_times(proj.path, extra_s, kids, limit=None)
        days: dict[str, int] = {}
        if events:
            add_timestamps(days, events)
            set_derived(rec, "first-commit", iso_utc(min(events)))
            set_derived(rec, "last-action-time", iso_utc(max(events)))
        else:
            fts = dir_birth_ts(proj.path)
            if fts is not None:
                set_derived(rec, "first-commit", iso_utc(fts))
        days = prune_days(days, window)
        now = datetime.now(tz=timezone.utc).timestamp()
        set_derived(rec, "heatmap-days", days)
        set_derived(rec, "heatmap-as-of", iso_utc(now))
        set_derived(rec, "heatmap-kids", kids)
        if write:
            save_practica(proj.path, rec)
        return days

    cached = rec.get("heatmap-days") if isinstance(rec.get("heatmap-days"), dict) else {}
    as_of = parse_ts(rec.get("heatmap-as-of"))
    oldest = min(window)
    start_ts = datetime.combine(oldest, datetime.min.time()).timestamp()
    need_log = refresh or as_of is None or kids_changed or head_changed
    if not need_log:
        # HEAD unchanged: reuse day counts. Skip git status — AISI-responses
        # alone is ~2s of lstat over a 300k-file work tree, and 44 statuses
        # were the whole warm-run cost. Dirty overlay still runs when HEAD
        # moves or on --refresh.
        return prune_days(
            {str(k): int(v) for k, v in cached.items() if str(k)},
            window,
        )

    if refresh or as_of is None or kids_changed:
        days = {}
        after = start_ts - 1
    else:
        days = {str(k): int(v) for k, v in cached.items() if str(k)}
        after = as_of
    stamps = git_commit_times_since(proj.path, after, specs)
    if stamps is not None:
        add_timestamps(days, stamps)
        days = prune_days(days, window)
        now = datetime.now(tz=timezone.utc).timestamp()
        set_derived(rec, "heatmap-days", days)
        set_derived(rec, "heatmap-as-of", iso_utc(now))
        set_derived(rec, "heatmap-kids", kids)
        if head is not None:
            set_derived(rec, "heatmap-head", head)
        if write:
            save_practica(proj.path, rec)
    else:
        days = prune_days(days, window)
    display = dict(days)
    add_timestamps(
        display, exclusive_dirty_mtimes(proj.path, extra_s, specs, kids)
    )
    return prune_days(display, window)


def heat_hex(count: int, maxc: int, *, invert: bool = False) -> str:
    """log1p scale so 1–10–30 stay distinct when the max is a busy monorepo day.

    Returns a continuous inferno color (not a bin). A positive count is
    floored one LUT step above empty so 1-commit days don't collapse to 0.
    `invert` for light terminals (1.0 - rgb).
    """
    if count <= 0 or maxc <= 0:
        return inferno_hex(0.0, invert=invert)
    t = math.log1p(count) / math.log1p(maxc)
    t = max(0.0, min(1.0, t))
    t = max(t, 1.0 / (_INFERNO_N - 1))
    return inferno_hex(t, invert=invert)


def week_gap(a: date, b: date) -> bool:
    """True on the Saturday/Sunday boundary (either time direction)."""
    return {a.weekday(), b.weekday()} == {5, 6}


def heatmap_slots(window: list[date]) -> list[date | None]:
    """Day cells with a blank slot between Sat and Sun."""
    slots: list[date | None] = []
    for i, d in enumerate(window):
        if i > 0 and week_gap(window[i - 1], d):
            slots.append(None)
        slots.append(d)
    return slots


def week_runs(slots: list[date | None]) -> list[tuple[int, list[date]]]:
    """Consecutive day runs between Sat/Sun gaps: (start index in slots, days)."""
    runs: list[tuple[int, list[date]]] = []
    start: int | None = None
    days: list[date] = []
    for i, s in enumerate(slots):
        if s is None:
            if days and start is not None:
                runs.append((start, days))
            start = None
            days = []
            continue
        if start is None:
            start = i
        days.append(s)
    if days and start is not None:
        runs.append((start, days))
    return runs


def week_stats_line(
    slots: list[date | None],
    rows: list[tuple[dict[str, int], dict[str, str]]],
    *,
    wash: str,
    zero: str,
    name_w: int,
) -> str:
    """`NN|NNN` over each full (7-day) week: distinct projects | total counts.

    A project counts if it has any commits that week or any onramp/offramp
    fill that isn't the flat wash or the 0-commit color.
    """
    cols = [" "] * len(slots)
    for start, wdays in week_runs(slots):
        if len(wdays) != 7:
            continue
        isos = [d.isoformat() for d in wdays]
        nproj = 0
        ncontrib = 0
        for days, fills in rows:
            week_sum = 0
            active = False
            for iso in isos:
                c = int(days.get(iso, 0))
                week_sum += c
                if c > 0:
                    active = True
                else:
                    col = fills.get(iso)
                    if col is not None and col != wash and col != zero:
                        active = True
            if active:
                nproj += 1
            ncontrib += week_sum
        label = f"{nproj:>2}|{ncontrib}"
        for k, ch in enumerate(label):
            j = start + k
            if j >= len(cols):
                break
            if k < 7 or slots[j] is None:
                cols[j] = ch
    return " " * name_w + "  " + "".join(cols)


def month_header(window: list[date], name_w: int) -> str:
    slots = heatmap_slots(window)
    cols = [" "] * len(slots)
    i = 0
    while i < len(slots):
        d = slots[i]
        if d is None:
            i += 1
            continue
        label = d.strftime("%b")
        for j, ch in enumerate(label):
            k = i + j
            if k < len(cols):
                cols[k] = ch
        ym = (d.year, d.month)
        i += 1
        while i < len(slots) and (slots[i] is None or (slots[i].year, slots[i].month) == ym):
            i += 1
    return " " * name_w + "  " + "".join(cols)


def scale_bar(maxc: int, *, invert: bool = False) -> str:
    last = SCALE_BAR_N - 1
    blocks = "".join(
        ansi_block(inferno_hex(i / last if last else 0.0, invert=invert))
        for i in range(SCALE_BAR_N)
    ) + "\x1b[0m"
    label = f"0 → {maxc}/day  (log)"
    return f"{label:>{HEATMAP_NAME_W}}  {blocks}"


def cmd_heatmap(args: argparse.Namespace) -> int:
    home = Path.home()
    projects, filters, parents = gather(args, home)
    populate(
        projects,
        filters,
        home,
        write=not args.no_write,
        refresh=args.refresh,
    )
    active = [
        p
        for p in projects
        if str(p.rec.get("disposition") or "").startswith("active")
    ]
    window = heatmap_window()
    counts: dict[Path, dict[str, int]] = {}
    maxc = 0
    for proj in active:
        days = heatmap_counts(
            proj,
            window,
            projects,
            refresh=args.refresh,
            write=not args.no_write,
        )
        try:
            key = proj.path.resolve()
        except OSError:
            key = proj.path
        counts[key] = days
        if days:
            maxc = max(maxc, max(days.values()))

    mode = sort_mode_from_args(args)
    slots = heatmap_slots(window)
    dark = macos_dark()
    invert = not dark
    wash = invert_hex(TAIL_WASH_LIGHT) if dark else TAIL_WASH_LIGHT
    zero = heat_hex(0, maxc, invert=invert)

    def proj_key(proj: Project) -> Path:
        try:
            return proj.path.resolve()
        except OSError:
            return proj.path

    fills_by: dict[Path, dict[str, str]] = {}
    for proj in active:
        key = proj_key(proj)
        days = counts.get(key, {})
        first_ts = parse_ts(proj.rec.get("first-commit"))
        last_c = parse_ts(proj.rec.get("last-action-time")) or parse_ts(
            proj.rec.get("last-commit-time")
        )
        fills_by[key] = dim_zero_fills(
            window, days, first_ts, last_c, dark=dark, maxc=maxc
        )

    def emit_row(proj: Project) -> None:
        key = proj_key(proj)
        days = counts.get(key, {})
        fills = fills_by.get(key, {})
        name = elide(display_name(proj)).rjust(HEATMAP_NAME_W)
        cells = []
        for slot in slots:
            if slot is None:
                cells.append(" ")
                continue
            iso = slot.isoformat()
            if iso in fills:
                cells.append(ansi_block(fills[iso]))
                continue
            c = int(days.get(iso, 0))
            cells.append(ansi_block(heat_hex(c, maxc, invert=invert)))
        print(name + "  " + "".join(cells) + "\x1b[0m")

    print(month_header(window, HEATMAP_NAME_W))
    print(
        week_stats_line(
            slots,
            [(counts.get(proj_key(p), {}), fills_by.get(proj_key(p), {})) for p in active],
            wash=wash,
            zero=zero,
            name_w=HEATMAP_NAME_W,
        )
    )
    if args.group:
        by_parent: dict[Path, list[Project]] = {p: [] for p in parents}
        for proj in active:
            by_parent.setdefault(proj.cdpath_parent, []).append(proj)
        first = True
        for parent in parents:
            group = by_parent.get(parent, [])
            if not group:
                continue
            group = sort_projects(group, mode)
            if not first:
                print()
            print(f"# {disp(parent, home)}")
            first = False
            for proj in group:
                emit_row(proj)
        if not first:
            print()
    else:
        for proj in sort_projects(active, mode):
            emit_row(proj)
        print()
    print(scale_bar(maxc, invert=not dark))
    return 0


def parse_set_value(key: str, raw: str) -> object:
    if key in {"categories", "related", "extra-noise", "frozen"}:
        if not raw.strip():
            return []
        return [p.strip() for p in raw.split(",") if p.strip()]
    if key in {"git", "subproject", "subgit", "submodule", "has-remote"}:
        v = raw.strip().lower()
        if v in {"1", "true", "yes", "y"}:
            return True
        if v in {"0", "false", "no", "n"}:
            return False
        die(f"set: {key} wants true/false, got {raw!r}", 2)
    if key == "disposition" and raw.strip() not in DISPOSITIONS:
        die(f"set: unknown disposition {raw!r}", 2)
    return raw


def find_project(ident: str, projects: list[Project], home: Path) -> Project:
    expanded = expand_userish(ident, home)
    cand_path = Path(expanded)
    if cand_path.exists():
        try:
            want = cand_path.resolve()
        except OSError:
            want = cand_path
        hits = [p for p in projects if resolved(p) == want]
        if len(hits) == 1:
            return hits[0]
    hits = [
        p
        for p in projects
        if display_name(p) == ident or p.cd_name == ident or p.rec.get("base-name") == ident
    ]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        names = ", ".join(display_name(p) for p in hits)
        die(f"set: {ident!r} is ambiguous ({names})", 2)
    die(f"set: no census project matching {ident!r}", 2)


def cmd_set(argv: list[str], list_ns: argparse.Namespace) -> int:
    if not argv or argv[0] in {"-h", "--help"}:
        print("usage: projects set <name-or-path> field=value [field=value…]")
        print("fields:", ", ".join(sorted(SET_FIELDS)))
        print("marks each field frozen in that project's .practica")
        return 0 if argv and argv[0] in {"-h", "--help"} else 2
    ident = argv[0]
    pairs = argv[1:]
    if not pairs:
        die("set: need at least one field=value", 2)
    updates: list[tuple[str, object]] = []
    for pair in pairs:
        if "=" not in pair:
            die(f"set: expected field=value, got {pair!r}", 2)
        k, v = pair.split("=", 1)
        if k not in SET_FIELDS:
            die(f"set: unknown field {k!r} (want {', '.join(sorted(SET_FIELDS))})", 2)
        updates.append((k, parse_set_value(k, v)))

    home = Path.home()
    projects, filters, _parents = gather(list_ns, home)
    populate(projects, filters, home, write=True, refresh=False)
    proj = find_project(ident, projects, home)
    for k, v in updates:
        set_explicit(proj.rec, k, v)
    save_practica(proj.path, proj.rec)
    pass2_names(projects, write=True)
    print(f"{display_name(proj)}  {disp(proj.path, home)}")
    for k, _ in updates:
        print(f"  {k}={proj.rec.get(k)!r}  (frozen)")
    return 0


def gather(
    args: argparse.Namespace, home: Path
) -> tuple[list[Project], Filters, list[Path]]:
    cdpath = load_cdpath(home)
    home_resolved = home.resolve()
    parents: list[Path] = []
    for parent in cdpath:
        if not parent.is_dir():
            continue
        try:
            if not args.include_home and parent.resolve() == home_resolved:
                continue
        except OSError:
            continue
        parents.append(parent)

    projects = collect(parents, leaves=args.leaves, home=home)
    filters = Filters()
    if not args.no_census:
        filters = load_filters(args.census_file, home)
        if filters.exclude or filters.only:
            projects = [proj for proj in projects if not dropped(proj, filters, home)]
    return projects, filters, parents


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="projects",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=(
            "Census of cdpath work-trees, with .practica overlay.\n"
            "Default order: canonical (cdpath, then lexical)."
        ),
        epilog=(
            f"Census file: {DEFAULT_CENSUS}\n"
            "Each project root gets a .practica (JSON), which is also the cache.\n"
            "Default runs reuse it; --refresh reruns git/session detection.\n"
            "Frozen fields are never overwritten. Nested names: second pass,\n"
            "closest-to-~ first; parent is another census project whose root\n"
            "prefixes this one.\n"
            "\n"
            "Sort (listing and heatmap): default canonical; -g headings;\n"
            "-c change-date; -a alphabetical. -g combines with -c/-a as\n"
            "headings plus that order within each cdpath group.\n"
            "\n"
            "  projects set <name-or-path> field=value   freeze an override\n"
            "  projects heatmap                          17-week inferno rows (active*)"
        ),
    )
    p.add_argument("-n", "--names", action="store_true", help="names only (full name)")
    p.add_argument("-p", "--paths", action="store_true", help="absolute paths only")
    order = p.add_mutually_exclusive_group()
    order.add_argument(
        "-c",
        "--changed",
        action="store_true",
        help="sort by last-action-time (newest first)",
    )
    order.add_argument(
        "-a",
        "--alpha",
        "-S",
        "--sorted",
        action="store_true",
        help="sort alphabetically by name",
    )
    p.add_argument(
        "-g",
        "--group",
        action="store_true",
        help="group headings by cdpath parent (canonical, or with -c/-a within groups)",
    )
    p.add_argument(
        "-H",
        "--home",
        action="store_true",
        dest="include_home",
        help="include $HOME children (Desktop, Documents, …)",
    )
    p.add_argument(
        "-l",
        "--leaves",
        action="store_true",
        help="skip children that are themselves cdpath parents",
    )
    p.add_argument(
        "-s",
        "--shadows",
        action="store_true",
        help="show later same-name directories cd would not use",
    )
    p.add_argument(
        "-0",
        dest="nul",
        action="store_true",
        help="NUL-separate (implies -p)",
    )
    p.add_argument(
        "--no-write",
        action="store_true",
        help="do not write .practica files",
    )
    p.add_argument(
        "--refresh",
        action="store_true",
        help="recompute git / last-action / last-session (ignore .practica cache)",
    )
    p.add_argument(
        "--no-census",
        "--no-exclude",
        dest="no_census",
        action="store_true",
        help="do not apply census-details.txt (drop, only, disposition)",
    )
    p.add_argument(
        "--census-file",
        "--exclude-file",
        dest="census_file",
        type=Path,
        default=DEFAULT_CENSUS,
        metavar="PATH",
        help="census file (default: census-details.txt next to this script)",
    )
    return p


def main(argv: list[str] | None = None) -> int:
    try:
        locale.setlocale(locale.LC_COLLATE, "")
    except locale.Error:
        pass
    if argv is None:
        argv = sys.argv[1:]
    parser = build_parser()
    if argv and argv[0] == "set":
        list_ns = parser.parse_args([])
        return cmd_set(argv[1:], list_ns)
    if argv and argv[0] == "heatmap":
        return cmd_heatmap(parser.parse_args(argv[1:]))

    args = parser.parse_args(argv)
    if args.names and args.paths:
        die("--names and --paths are mutually exclusive", 2)
    if args.nul:
        args.paths = True

    home = Path.home()
    projects, filters, parents = gather(args, home)
    populate(
        projects,
        filters,
        home,
        write=not args.no_write,
        refresh=args.refresh,
    )
    emit_table(
        projects,
        parents,
        names_only=args.names,
        paths_only=args.paths,
        grouped=args.group,
        sort_mode=sort_mode_from_args(args),
        show_shadows=args.shadows,
        nul=args.nul,
        home=home,
        now=datetime.now(tz=timezone.utc).timestamp(),
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
