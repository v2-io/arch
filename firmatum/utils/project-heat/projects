def _inferno_rgb_at(i: int) -> tuple[int, int, int]:
    o = i * 6
    h = _INFERNO_PACKED[o : o + 6]
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def inferno_hex(t: float, *, invert: bool = False) -> str:
    """t in [0, 1] → inferno RGB hex. Continuous lerp on the 256 LUT.

    `invert` subtracts each RGB channel from 1 (matplotlib-style
    1.0 - rgb). Use on light terminals; inferno itself is built for dark.
    """
    t = max(0.0, min(1.0, t))
    last = _INFERNO_N - 1
    x = t * last
    lo = int(x)
    hi = min(lo + 1, last)
    f = x - lo
    r0, g0, b0 = _inferno_rgb_at(lo)
    if f == 0.0 or lo == hi:
        r, g, b = r0, g0, b0
    else:
        r1, g1, b1 = _inferno_rgb_at(hi)
        r = round(r0 * (1 - f) + r1 * f)
        g = round(g0 * (1 - f) + g1 * f)
        b = round(b0 * (1 - f) + b1 * f)
    if invert:
        r, g, b = 255 - r, 255 - g, 255 - b
    return f"#{r:02x}{g:02x}{b:02x}"
