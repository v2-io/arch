def edge_fields(line: str) -> list[str]:
    """Whitespace-separated fields; [brackets] guard spaces (DAG-grammar style)."""
    fields: list[str] = []
    buf: list[str] = []
    depth = 0
    for ch in line:
        if ch == "[":
            depth += 1
            buf.append(ch)
        elif ch == "]":
            depth = max(0, depth - 1)
            buf.append(ch)
        elif ch.isspace() and depth == 0:
            if buf:
                fields.append("".join(buf))
                buf = []
        else:
            buf.append(ch)
    if buf:
        fields.append("".join(buf))
    return fields


def edge_list(fieldval: str) -> list[str]:
    """Comma-list inside one field; commas inside [brackets] don't split;
    brackets are stripped from each element."""
    out: list[str] = []
    buf: list[str] = []
    depth = 0
    for ch in fieldval:
        if ch == "[":
            depth += 1
        elif ch == "]":
            depth = max(0, depth - 1)
        elif ch == "," and depth == 0:
            tok = "".join(buf).strip()
            if tok:
                out.append(tok)
            buf = []
            continue
        buf.append(ch)
    tok = "".join(buf).strip()
    if tok:
        out.append(tok)
    return [t[1:-1].strip() if t.startswith("[") and t.endswith("]") else t for t in out]


def load_edges(
    path: Path, names: list[str]
) -> tuple[dict[str, list[dict]], dict[str, list[dict]]]:
    """census-edges.txt → (edges-out by name, edges-in by name).

    Lines: `inverse: A <-> B`, `alias: NAME -> REL`, and edges
    `FROM REL TO [INV]` (sentence order; comma-lists; globs; [brackets]
    guard spaces; INV '-' = explicitly none). Both-side declarations
    collapse: a relation declared as the right side of an inverse pair
    is flipped to its left-side (canonical) form before dedupe.
    """
    out_map: dict[str, list[dict]] = {}
    in_map: dict[str, list[dict]] = {}
    if not path.is_file():
        return out_map, in_map
    inverses: dict[str, str] = {}
    canon_left: set[str] = set()
    aliases: dict[str, str] = {}
    edges: dict[tuple[str, str, str], str] = {}  # (from, to, rel) -> inv ('' = none)
    nameset = set(names)

    def expand_names(spec: str, line: str) -> list[str]:
        hits: list[str] = []
        for tok in edge_list(spec):
            if "*" in tok or "?" in tok:
                rx = glob_to_re(tok)
                found = [n for n in names if rx.match(n)]
                if not found:
                    print(
                        f"projects: census-edges: {tok!r} matches no census "
                        f"project ({line})",
                        file=sys.stderr,
                    )
                hits += found
            elif tok in nameset:
                hits.append(tok)
            else:
                print(
                    f"projects: census-edges: unknown project {tok!r} ({line})",
                    file=sys.stderr,
                )
        return hits

    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        low = line.lower()
        if low.startswith("inverse:"):
            body = line.split(":", 1)[1]
            if "<->" not in body:
                die(f"census-edges: inverse wants 'A <-> B': {line}", 2)
            a, b = (x.strip() for x in body.split("<->", 1))
            inverses[a] = b
            inverses[b] = a
            canon_left.add(a)
            continue
        if low.startswith("alias:"):
            body = line.split(":", 1)[1]
            if "->" not in body:
                die(f"census-edges: alias wants 'NAME -> REL': {line}", 2)
            a, b = (x.strip() for x in body.split("->", 1))
            aliases[a] = b
            continue
        fields = edge_fields(line)
        if len(fields) not in (3, 4):
            die(f"census-edges: edge wants 'FROM REL TO [INV]': {line}", 2)
        froms = expand_names(fields[0], line)
        rels = [aliases.get(r, r) for r in edge_list(fields[1])]
        tos = expand_names(fields[2], line)
        invs = [aliases.get(i, i) for i in edge_list(fields[3])] if len(fields) == 4 else []
        if len(rels) == 1 and len(froms) > 1:
            rels = rels * len(froms)
        if froms and len(rels) != len(froms):
            die(
                f"census-edges: {len(froms)} FROM but {len(rels)} REL "
                f"(they pair positionally): {line}",
                2,
            )
        if invs:
            if len(invs) == 1 and len(froms) > 1:
                invs = invs * len(froms)
            if froms and len(invs) != len(froms):
                die(f"census-edges: INV count mismatch: {line}", 2)
        for idx, f in enumerate(froms):
            rel = rels[idx]
            inv = invs[idx] if invs else inverses.get(rel, "")
            if inv == "-":
                inv = ""
            for t in tos:
                ff, tt, rr, ii = f, t, rel, inv
                if rel in inverses and rel not in canon_left:
                    # declared from the other side; flip to canonical
                    ff, tt, rr, ii = t, f, inverses[rel], rel
                edges.setdefault((ff, tt, rr), ii)

    for (f, t, r), inv in sorted(edges.items()):
        out_map.setdefault(f, []).append({"to": t, "rel": r})
        entry: dict = {"from": f}
        if inv or inverses.get(r):
            entry["rel"] = inv or inverses[r]
        else:
            entry["reverse-of"] = r
        in_map.setdefault(t, []).append(entry)
    return out_map, in_map


def gather(
    args: argparse.Namespace, home: Path
) -> tuple[list[Project], Filters, list[Path]]:
    cdpath = load_cdpath(home)
    home_resolved = home.resolve()
    parents: list[Path] = []
    for parent in cdpath:
        if not parent.is_dir():
            continue
        try:
            if not args.include_home and parent.resolve() == home_resolved:
                continue
        except OSError:
            continue
        parents.append(parent)

    projects = collect(parents, leaves=args.leaves, home=home)
    filters = Filters()
    if not args.no_census:
        filters = load_filters(args.census_file, home)
        if filters.exclude or filters.only:
            projects = [proj for proj in projects if not dropped(proj, filters, home)]
    return projects, filters, parents


def axes_help_text() -> str:
    """AXES teaching for --help, rendered from the loaded glyph table so
    edits to axis-glyphs.json show up in usage automatically."""
    lines = [
        "-v shows an AXES block, one column per axis, '·' = undeclared\n"
        f"(vocabulary loads from {GLYPHS_FILE.name} beside this script —\n"
        "edit it and this section updates; columns pad to the axis's\n"
        "widest glyph):",
    ]
    for i, ax in enumerate(AXIS_ORDER, 1):
        pairs = [
            f"{AXIS_GLYPHS[ax].get(v, '·')} {v}"
            for v in AXES[ax]
            if v != "undeclared"
        ]
        head = f"  {i} {ax:<11} "
        cur = head
        first = True
        for p in pairs:
            add = p if first else "  " + p
            if len(cur) + len(add) > 76:
                lines.append(cur)
                cur = " " * len(head) + p
            else:
                cur += add
            first = False
        lines.append(cur)
    return "\n".join(lines)


