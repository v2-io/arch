@dataclass
class Project:
    cd_name: str
    path: Path
    cdpath_parent: Path
    shadows: list[Path] = field(default_factory=list)
    rec: dict = field(default_factory=dict)
    parent_proj: Project | None = None


def die(msg: str, code: int = 1) -> None:
    print(f"projects: {msg}", file=sys.stderr)
    raise SystemExit(code)


def expand_userish(raw: str, home: Path) -> str:
    s = raw.strip().strip("'\"")
    s = s.replace("${HOME}", str(home)).replace("$HOME", str(home))
    if s == "~":
        return str(home)
    if s.startswith("~/"):
        return str(home / s[2:])
    return s


def parse_cdpath(text: str, home: Path) -> list[Path]:
    m = CDPATH_ASSIGN_RE.search(text)
    if not m:
        die(f"no cdpath=(...) found in {DEFAULT_CDPATH_FILE}")
    out: list[Path] = []
    for raw in m.group(1).splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        out.append(Path(expand_userish(line, home)))
    return out


def load_cdpath(home: Path) -> list[Path]:
    env = os.environ.get("CDPATH")
    if env:
        return [Path(expand_userish(p, home)) for p in env.split(":") if p]
    path = Path(os.environ.get("PROJECTS_CDPATH_FILE", DEFAULT_CDPATH_FILE))
    if not path.is_file():
        die(f"no cdpath set and cannot read {path}")
    return parse_cdpath(path.read_text(encoding="utf-8"), home)


def glob_to_re(pattern: str) -> re.Pattern[str]:
    """fnmatch with `**` across directories; `*` / `?` stay within a segment."""
    i = 0
    out: list[str] = ["^"]
    n = len(pattern)
    while i < n:
        if pattern.startswith("**/", i):
            out.append("(?:.*/)?")
            i += 3
        elif pattern.startswith("**", i):
            out.append(".*")
            i += 2
        elif pattern[i] == "*":
            out.append("[^/]*")
            i += 1
        elif pattern[i] == "?":
            out.append("[^/]")
            i += 1
        else:
            out.append(re.escape(pattern[i]))
            i += 1
    out.append("$")
    return re.compile("".join(out))


@dataclass
class Filters:
    exclude: list[tuple[str, re.Pattern[str]]] = field(default_factory=list)
    only: dict[str, frozenset[str]] = field(default_factory=dict)
    # (axis, value, pattern, rx) — first match wins per axis
    defaults: list[tuple[str, str, str, re.Pattern[str]]] = field(default_factory=list)
    internal_orgs: frozenset[str] = frozenset()


def parent_idents(parent: Path, home: Path) -> set[str]:
    rel = rel_home(parent, home)
    idents = {parent.name, parent.as_posix(), str(parent), rel}
    if rel == ".":
        idents.add("~")
    else:
        idents.add(f"~/{rel}")
    try:
        idents.add(parent.resolve().as_posix())
    except OSError:
        pass
    return idents


def load_filters(path: Path, home: Path) -> Filters:
    filters = Filters()
    if not path.is_file():
        return filters
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.lower().startswith("only "):
            rest = line[5:].strip()
            if ":" not in rest:
                die(f"{path.name}: 'only' line needs a colon: only <parent>: [names…]", 2)
            selector, namespec = rest.split(":", 1)
            selector = selector.strip()
            if not selector:
                die(f"{path.name}: 'only' line missing parent", 2)
            try:
                names = frozenset(shlex.split(namespec))
            except ValueError as e:
                die(f"{path.name}: {e}", 2)
            keys = {selector}
            if "/" in selector or selector.startswith(("~", "$")):
                expanded = expand_userish(selector, home)
                keys.add(expanded)
                keys |= parent_idents(Path(expanded), home)
            for key in keys:
                prev = filters.only.get(key, frozenset())
                filters.only[key] = prev | names
            continue
        if line.lower().startswith("internal-git-orgs:"):
            orgs = line.split(":", 1)[1]
            filters.internal_orgs = filters.internal_orgs | {
                o.strip() for o in orgs.split(",") if o.strip()
            }
            continue
        if line.lower().startswith("default "):
            rest = line.split(None, 1)[1]
            if ":" not in rest:
                die(
                    f"{path.name}: 'default' line needs a colon: "
                    "default <axis>=<value>: glob [glob…]",
                    2,
                )
            spec, globspec = rest.split(":", 1)
            if "=" not in spec:
                die(f"{path.name}: 'default' wants axis=value, got {spec.strip()!r}", 2)
            axis, value = (x.strip() for x in spec.split("=", 1))
            if axis not in DECLARED_AXES:
                die(
                    f"{path.name}: 'default' axis must be one of "
                    f"{', '.join(DECLARED_AXES)}, got {axis!r}",
                    2,
                )
            if value not in AXES[axis]:
                die(
                    f"{path.name}: unknown {axis} {value!r} "
                    f"(want {', '.join(AXES[axis])})",
                    2,
                )
            _add_defaults(filters, path, axis, value, globspec, home)
            continue
        if line.lower().startswith("disposition "):
            die(
                f"{path.name}: 'disposition' lines are retired — use "
                "'default <axis>=<value>: glob…' (axes: "
                f"{', '.join(DECLARED_AXES)})",
                2,
            )
        pat = expand_userish(line, home)
        filters.exclude.append((pat, glob_to_re(pat)))
    return filters


def _add_defaults(
    filters: Filters, path: Path, axis: str, value: str, globspec: str, home: Path
) -> None:
    try:
        globs = shlex.split(globspec)
    except ValueError as e:
        die(f"{path.name}: {e}", 2)
    if not globs:
        die(f"{path.name}: default {axis}={value} has no globs", 2)
    for g in globs:
        pat = expand_userish(g, home)
        filters.defaults.append((axis, value, pat, glob_to_re(pat)))


def only_names(parent: Path, filters: Filters, home: Path) -> frozenset[str] | None:
    found: frozenset[str] | None = None
    for ident in parent_idents(parent, home):
        if ident in filters.only:
            found = filters.only[ident] if found is None else found | filters.only[ident]
    return found


def dropped(proj: Project, filters: Filters, home: Path) -> bool:
    allowed = only_names(proj.cdpath_parent, filters, home)
    if allowed is not None and proj.cd_name not in allowed:
        return True
    name = proj.cd_name
    path_abs = proj.path.as_posix()
    path_rel = rel_home(proj.path, home)
    for pat, rx in filters.exclude:
        if "/" in pat:
            if rx.match(path_rel) or rx.match(path_abs):
                return True
        elif rx.match(name):
            return True
    return False


def census_axis_defaults(proj: Project, filters: Filters, home: Path) -> dict[str, str]:
    """Per-axis census defaults; first matching glob wins per axis."""
    path_abs = proj.path.as_posix()
    path_rel = rel_home(proj.path, home)
    out: dict[str, str] = {}
    for axis, val, pat, rx in filters.defaults:
        if axis in out:
            continue
        if "/" in pat:
            if rx.match(path_rel) or rx.match(path_abs):
                out[axis] = val
        elif rx.match(proj.cd_name):
            out[axis] = val
    out.setdefault("activity", "active")
    for axis in ("local-use", "public-use"):
        out.setdefault(axis, "undeclared")
    return out


def rel_home(path: Path, home: Path) -> str:
    try:
        return path.relative_to(home).as_posix()
    except ValueError:
        return path.as_posix()


def disp(path: Path, home: Path) -> str:
    try:
        rel = path.relative_to(home)
    except ValueError:
        return str(path)
    return "~" if str(rel) == "." else f"~/{rel.as_posix()}"


def name_key(s: str) -> str:
    return locale.strxfrm(s)


def children(parent: Path) -> list[Path]:
    try:
        entries = list(parent.iterdir())
    except OSError:
        return []
    dirs: list[Path] = []
    for p in entries:
        name = p.name
        if not name or name.startswith("."):
            continue
        try:
            if p.is_dir():
                dirs.append(p)
        except OSError:
            continue
    dirs.sort(key=lambda p: name_key(p.name))
    return dirs


def collect(
    parents: list[Path],
    *,
    leaves: bool,
    home: Path,
) -> list[Project]:
    parent_resolved = [p.resolve() for p in parents]
    container = set(parent_resolved)
    seen: dict[str, Project] = {}
    order: list[str] = []
    for parent in parents:
        for child in children(parent):
            name = child.name
            if name in seen:
                seen[name].shadows.append(child)
                continue
            if leaves:
                try:
                    if child.resolve() in container:
                        continue
                except OSError:
                    pass
            seen[name] = Project(cd_name=name, path=child, cdpath_parent=parent)
            order.append(name)
    return [seen[n] for n in order]


# --- .practica -------------------------------------------------------------


def practica_path(root: Path) -> Path:
    return root / PRACTICA_NAME


def load_practica(root: Path) -> dict:
    path = practica_path(root)
    if not path.is_file():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as e:
        print(f"projects: skip unreadable {path}: {e}", file=sys.stderr)
        return {"__corrupt": True}
    return data if isinstance(data, dict) else {}


def ordered_record(rec: dict) -> dict:
    out: dict = {}
    for k in RECORD_KEY_ORDER:
        if k in rec and rec[k] not in (None, "", [], {}):
            if k == "frozen" and not rec[k]:
                continue
            out[k] = rec[k]
    for k, v in rec.items():
        if k.startswith("__") or k in SAVE_EXCLUDE:
            continue
        if k not in out and v not in (None, "", [], {}):
            out[k] = v
    return out


def save_practica(root: Path, rec: dict) -> None:
    if rec.get("__corrupt"):
        return
    path = practica_path(root)
    payload = json.dumps(ordered_record(rec), indent=2, ensure_ascii=False) + "\n"
    if path.is_file():
        try:
            if path.read_text(encoding="utf-8") == payload:
                return
        except OSError:
            pass
    dir_times = None
    try:
        st = root.stat()
        dir_times = (st.st_atime, st.st_mtime)
    except OSError:
        pass
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".practica-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(payload)
        os.replace(tmp, path)
        if dir_times is not None:
            os.utime(root, dir_times)
    except OSError as e:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        print(f"projects: could not write {path}: {e}", file=sys.stderr)


def frozen_of(rec: dict) -> set[str]:
    raw = rec.get("frozen") or []
    if isinstance(raw, str):
        return {raw}
    return {str(x) for x in raw}


def set_derived(rec: dict, key: str, value: object) -> None:
    if key in frozen_of(rec):
        return
    rec[key] = value


def set_explicit(rec: dict, key: str, value: object) -> None:
    rec[key] = value
    fz = frozen_of(rec)
    fz.add(key)
    rec["frozen"] = sorted(fz)


def iso_utc(ts: float) -> str:
    return (
        datetime.fromtimestamp(ts, tz=timezone.utc)
        .isoformat(timespec="seconds")
        .replace("+00:00", "Z")
    )


def parse_ts(val: object) -> float | None:
    if val is None or val == "":
        return None
    if isinstance(val, (int, float)):
        return float(val)
    s = str(val).strip()
    if not s:
        return None
    try:
        return float(s)
    except ValueError:
        pass
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    try:
        return datetime.fromisoformat(s).timestamp()
    except ValueError:
        return None


def ago(ts: float | None, now: float) -> str:
    if ts is None:
        return "—"
    d = now - ts
    if d < 0:
        d = 0
    if d < 90:
        return f"{int(d)}s"
    if d < 90 * 60:
        return f"{int(d / 60)}m"
    if d < 36 * 3600:
        return f"{int(d / 3600)}h"
    if d < 14 * 86400:
        return f"{int(d / 86400)}d"
    return datetime.fromtimestamp(ts, tz=timezone.utc).strftime("%Y-%m-%d")


# --- detection -------------------------------------------------------------


def git_run(root: Path, *args: str, timeout: int = 20) -> tuple[int, str]:
    env = os.environ.copy()
    env["GIT_OPTIONAL_LOCKS"] = "0"
    try:
        r = subprocess.run(
            ["git", "-C", str(root), *args],
            capture_output=True,
            text=True,
            timeout=timeout,
            env=env,
        )
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""
    return r.returncode, r.stdout.strip()


def parse_org(url: str) -> str:
    m = REMOTE_ORG_RE.search(url.strip())
    return m.group("org") if m else ""


def _mtime(path: Path) -> float | None:
    try:
        return path.stat().st_mtime
    except OSError:
        return None


def read_gitdir(git: Path) -> Path | None:
    if git.is_dir():
        return git
    if not git.is_file():
        return None
    try:
        text = git.read_text(encoding="utf-8")
    except OSError:
        return None
    for line in text.splitlines():
        if line.lower().startswith("gitdir:"):
            p = Path(line.split(":", 1)[1].strip())
            if not p.is_absolute():
                p = git.parent / p
            try:
                return p.resolve()
            except OSError:
                return p
    return None


def own_git_meta(root: Path) -> Path | None:
    """This directory's `.git` (dir or submodule gitfile). Does not walk up —
    parent HEAD would invalidate every subgit child on any sibling commit.
    """
    git = root / ".git"
    if git.exists():
        return read_gitdir(git)
    return None


def git_head_id(root: Path) -> str | None:
    """Resolved HEAD (ref + sha, or detached sha). One/two file reads, no git binary."""
    meta = own_git_meta(root)
    if meta is None:
        return None
    try:
        raw = (meta / "HEAD").read_text(encoding="utf-8").strip()
    except OSError:
        return None
    if raw.startswith("ref:"):
        ref = raw.split(":", 1)[1].strip()
        refp = meta / ref
        try:
            sha = refp.read_text(encoding="utf-8").strip()
            return f"{ref} {sha}"
        except OSError:
            return raw
    return raw


def git_cache_stale(root: Path, rec: dict) -> bool:
    if "git" not in rec:
        return True
    head = git_head_id(root)
    cached = rec.get("git-head")
    if head is None:
        return bool(rec.get("git")) and not cached
    return head != cached


def nearest_git_root(root: Path) -> Path | None:
    """Work tree that owns `root` (the project itself, or a parent for subgit)."""
    try:
        cur = root.resolve()
    except OSError:
        cur = root
    seen: set[Path] = set()
    while cur not in seen:
        seen.add(cur)
        if own_git_meta(cur) is not None:
            return cur
        parent = cur.parent
        if parent == cur:
            break
        cur = parent
    return None


def containing_head_id(root: Path) -> str | None:
    """HEAD of this tree, or of the repo that contains it (subgit). File reads only."""
    top = nearest_git_root(root)
    return git_head_id(top) if top is not None else None


_porcelain_cache: dict[str, list[str]] = {}


def toplevel_porcelain(top: Path) -> list[str]:
    """Repo-relative dirty/untracked paths. One `git status` per work tree per process."""
    key = str(top)
    if key in _porcelain_cache:
        return _porcelain_cache[key]
    code, porc = git_run(top, "status", "--porcelain", "-uall")
    rels = porcelain_paths(porc) if code == 0 and porc else []
    _porcelain_cache[key] = rels
    return rels


def session_stamp(root: Path, home: Path) -> float | None:
    times: list[float] = []
    claude = home / ".claude" / "projects" / claude_slug(root)
    mt = _mtime(claude)
    if mt is not None:
        times.append(mt)
    grok = grok_session_dir(root, home / ".grok" / "sessions")
    mt = _mtime(grok)
    if mt is not None:
        times.append(mt)
    return max(times) if times else None


def cache_stale(cached: float | None, stamp: float | None) -> bool:
    if stamp is None:
        return False
    if cached is None:
        return True
    return stamp > cached + 2.0


def detect_git(root: Path) -> dict:
    code, top = git_run(root, "rev-parse", "--show-toplevel")
    if code != 0 or not top:
        return {
            "git": False,
            "subgit": False,
            "submodule": False,
            "has-remote": False,
            "remote": "",
            "org": "",
        }
    try:
        top_p = Path(top).resolve()
        root_p = root.resolve()
    except OSError:
        top_p = Path(top)
        root_p = root
    own = top_p == root_p
    gitfile = (root / ".git").is_file()
    super_code, super_out = git_run(root, "rev-parse", "--show-superproject-working-tree")
    submodule = own and (gitfile or (super_code == 0 and bool(super_out)))
    remote = ""
    org = ""
    has_remote = False
    if own:
        rc, url = git_run(root, "remote", "get-url", "origin")
        if rc != 0 or not url:
            rc, remotes = git_run(root, "remote")
            if rc == 0 and remotes:
                first = remotes.splitlines()[0].strip()
                rc, url = git_run(root, "remote", "get-url", first)
        if rc == 0 and url:
            has_remote = True
            remote = url
            org = parse_org(url)
    return {
        "git": own,
        "subgit": not own,
        "submodule": bool(submodule),
        "has-remote": has_remote,
        "remote": remote,
        "org": org,
    }


def porcelain_paths(text: str) -> list[str]:
    out: list[str] = []
    for line in text.splitlines():
        if len(line) < 4:
            continue
        rest = line[3:] if line[2] == " " else line[2:].lstrip()
        if " -> " in rest:
            rest = rest.split(" -> ", 1)[1]
        if rest.startswith('"') and rest.endswith('"'):
            rest = rest[1:-1]
        out.append(rest)
    return out


def noise_basenames(extra: list[str]) -> set[str]:
    return set(GIT_NOISE) | {PRACTICA_NAME} | {str(x) for x in extra}


def is_noise_file(path: Path, extra: list[str]) -> bool:
    name = path.name
    if name.startswith(".") or name in noise_basenames(extra):
        return True
    return False


def dir_birth_ts(root: Path) -> float | None:
    """When this directory inode appeared (macOS birthtime; ctime elsewhere)."""
    try:
        st = root.stat()
    except OSError:
        return None
    birth = getattr(st, "st_birthtime", None)
    if birth:
        return float(birth)
    return float(st.st_ctime)


def file_event_times(
    root: Path,
    extra: list[str],
    skip_rels: list[str] | None = None,
    limit: int | None = 8000,
) -> list[float]:
    """Birth + mtime of each non-noise file, excluding census-child subtrees.

    Two stamps per file when birth and mtime differ by ≥1s (create vs later
    edit); one stamp when they coincide. This is the no-git stand-in for a
    commit stream: counts, first, and most-recent all come from the same walk.
    """
    skip_rels = skip_rels or []
    stamps: list[float] = []
    n = 0
    try:
        root_p = root.resolve()
    except OSError:
        root_p = root
    try:
        for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
            dirnames[:] = [
                d
                for d in dirnames
                if not d.startswith(".") and d not in SKIP_DIR_NAMES
            ]
            dp = Path(dirpath)
            try:
                rel_dir = dp.resolve().relative_to(root_p).as_posix()
            except ValueError:
                rel_dir = ""
            if rel_dir in {".", ""}:
                rel_dir = ""
            elif under_child(rel_dir, skip_rels):
                dirnames[:] = []
                continue
            keep: list[str] = []
            for d in dirnames:
                child = f"{rel_dir}/{d}" if rel_dir else d
                if not under_child(child, skip_rels):
                    keep.append(d)
            dirnames[:] = keep
            for fn in filenames:
                if fn.startswith(".") or fn in noise_basenames(extra):
                    continue
                n += 1
                if limit is not None and n > limit:
                    return stamps
                fp = dp / fn
                try:
                    st = fp.stat()
                except OSError:
                    continue
                mt = float(st.st_mtime)
                stamps.append(mt)
                birth = getattr(st, "st_birthtime", None)
                if birth is not None and abs(float(birth) - mt) >= 1.0:
                    stamps.append(float(birth))
    except OSError:
        pass
    return stamps


def census_child_rels(proj: Project, projects: list[Project]) -> list[str]:
    """Immediate census children of proj, as paths relative to proj.root."""
    rp = resolved(proj)
    rels: list[str] = []
    for other in projects:
        if other is proj:
            continue
        op = resolved(other)
        try:
            rel = op.relative_to(rp)
        except ValueError:
            continue
        if not rel.parts:
            continue
        skip = False
        for mid in projects:
            if mid is proj or mid is other:
                continue
            mp = resolved(mid)
            try:
                op.relative_to(mp)
                mp.relative_to(rp)
            except ValueError:
                continue
            skip = True
            break
        if not skip:
            rels.append(rel.as_posix())
    return sorted(rels)


def git_pathspecs(child_rels: list[str]) -> list[str]:
    return ["."] + [f":!{rel}" for rel in child_rels]


def under_child(rel_posix: str, child_rels: list[str]) -> bool:
    for e in child_rels:
        if rel_posix == e or rel_posix.startswith(e + "/"):
            return True
    return False


def exclusive_dirty_mtimes(
    root: Path,
    extra: list[str],
    skip_rels: list[str] | None = None,
) -> list[float]:
    """Mtimes of dirty/untracked files under root, excluding census children."""
    skip_rels = skip_rels or []
    top_p = nearest_git_root(root)
    if top_p is None:
        return []
    try:
        root_p = root.resolve()
    except OSError:
        root_p = root
    out: list[float] = []
    for rel in toplevel_porcelain(top_p):
        fp = top_p / rel
        try:
            inside = fp.resolve().relative_to(root_p)
        except ValueError:
            continue
        if under_child(inside.as_posix(), skip_rels):
            continue
        if fp.name == PRACTICA_NAME or is_noise_file(fp, extra):
            continue
        if any(part in SKIP_DIR_NAMES or part.startswith(".") for part in fp.parts):
            continue
        try:
            out.append(fp.stat().st_mtime)
        except OSError:
            continue
    return out


def detect_last_action(
    root: Path,
    git_info: dict,
    extra: list[str],
    pathspecs: list[str] | None = None,
    skip_rels: list[str] | None = None,
) -> tuple[float | None, float | None]:
    """Return (last-action including dirty, last exclusive commit)."""
    specs = pathspecs or ["."]
    skip_rels = skip_rels or []
    commit_ts: float | None = None
    best: float | None = None
    if git_info.get("git") or git_info.get("subgit"):
        code, out = git_run(root, "log", "-1", "--format=%ct", "--", *specs)
        if code == 0 and out:
            try:
                commit_ts = float(out.splitlines()[0])
                best = commit_ts
            except ValueError:
                pass
        for mt in exclusive_dirty_mtimes(root, extra, skip_rels):
            if best is None or mt > best:
                best = mt
        if best is not None:
            return best, commit_ts
    events = file_event_times(root, extra, skip_rels)
    if not events:
        return None, commit_ts
    return max(events), commit_ts


def claude_slug(path: Path) -> str:
    return path.resolve().as_posix().replace("/", "-")


def grok_session_dir(path: Path, grok_root: Path) -> Path:
    key = quote(path.resolve().as_posix(), safe="")
    return grok_root / key


def detect_last_session(root: Path, home: Path) -> dict | None:
    best: dict | None = None
    best_ts = -1.0

    claude_dir = home / ".claude" / "projects" / claude_slug(root)
    if claude_dir.is_dir():
        jsonls = list(claude_dir.glob("*.jsonl"))
        if jsonls:
            newest = max(jsonls, key=lambda p: p.stat().st_mtime)
            ts = newest.stat().st_mtime
            model = ""
            try:
                lines = newest.read_text(encoding="utf-8", errors="replace").splitlines()
                for line in reversed(lines[-80:]):
                    try:
                        o = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    t = o.get("timestamp")
                    pt = parse_ts(t)
                    if pt is not None:
                        ts = max(ts, pt)
                    m = o.get("message")
                    if isinstance(m, dict) and m.get("model"):
                        model = str(m["model"])
                        break
                    if o.get("model"):
                        model = str(o["model"])
                        break
            except OSError:
                pass
            if ts >= best_ts:
                best_ts = ts
                best = {
                    "time": iso_utc(ts),
                    "id": newest.stem,
                    "model": model,
                    "source": "claude",
                }

    grok_root = home / ".grok" / "sessions"
    gdir = grok_session_dir(root, grok_root)
    if gdir.is_dir():
        try:
            children_d = [p for p in gdir.iterdir() if p.is_dir()]
        except OSError:
            children_d = []
        for sess in children_d:
            summary = sess / "summary.json"
            ts = None
            model = ""
            sid = sess.name
            if summary.is_file():
                try:
                    s = json.loads(summary.read_text(encoding="utf-8"))
                except (OSError, json.JSONDecodeError):
                    s = {}
                ts = parse_ts(s.get("last_active_at") or s.get("updated_at"))
                model = str(s.get("current_model_id") or "")
                info = s.get("info") or {}
                if isinstance(info, dict) and info.get("id"):
                    sid = str(info["id"])
            if ts is None:
                try:
                    ts = sess.stat().st_mtime
                except OSError:
                    continue
            if ts >= best_ts:
                best_ts = ts
                best = {
                    "time": iso_utc(ts),
                    "id": sid,
                    "model": model,
                    "source": "grok",
                }
    return best


def hydrate_git_flags(rec: dict) -> None:
    """In-memory git booleans from stored git-rel (booleans are not saved)."""
    if "git" in rec:
        return
    gr = str(rec.get("git-rel") or "")
    if not gr:
        return
    rec["git"] = gr in ("gitroot", "submodule")
    rec["subgit"] = gr == "subgit"
    rec["submodule"] = gr == "submodule"


def drop_disposition(rec: dict) -> None:
    """The retired `disposition` field is ignored, not migrated (Joseph,
    2026-09-01: the new axes exist because it wasn't working). Drop the
    key and its frozen mark; axes start fresh from census defaults."""
    if "disposition" not in rec and "disposition" not in frozen_of(rec):
        return
    rec.pop("disposition", None)
    fz = frozen_of(rec)
    if "disposition" in fz:
        fz.discard("disposition")
        rec["frozen"] = sorted(fz)


def git_rel_of(rec: dict, root: Path, kids: list[str]) -> str:
    if rec.get("submodule"):
        return "submodule"
    if rec.get("git"):
        return "gitroot"
    if rec.get("subgit"):
        return "subgit"
    # group = no git of its own, but holds git roots — census children or
    # plain immediate subdirs (e.g. ~/src-ext/aisi: 30 clones, none census).
    for rel in kids:
        if (root / rel / ".git").exists():
            return "group"
    try:
        for child in root.iterdir():
            if child.name.startswith(".") or child.name in SKIP_DIR_NAMES:
                continue
            try:
                if child.is_dir() and (child / ".git").exists():
                    return "group"
            except OSError:
                continue
    except OSError:
        pass
    return "no-git"


def gh_visibility(remote: str) -> str | None:
    """Ask `gh` for a github repo's visibility. None (absent, never faked)
    when the remote isn't github, gh is missing/unauthenticated, or the
    call fails. Only invoked on --refresh — never on a normal cached run."""
    if "github.com" not in remote:
        return None
    m = REMOTE_ORG_RE.search(remote.strip())
    if not m:
        return None
    slug = f"{m.group('org')}/{m.group('repo')}"
    try:
        r = subprocess.run(
            ["gh", "repo", "view", slug, "--json", "visibility", "-q", ".visibility"],
            capture_output=True,
            text=True,
            timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    vis = (r.stdout or "").strip().lower()
    return vis if vis in ("public", "private", "internal") else None


def git_vis_of(rec: dict, filters: Filters) -> str:
    gr = rec.get("git-rel")
    if gr == "group":
        return "group"
    if gr == "subgit":
        # A subgit has no governing remote of its own; pass2 inherits the
        # census parent's git-vis. Until then: absent, never guessed.
        return ""
    if rec.get("has-remote"):
        org = str(rec.get("org") or "")
        ghv = str(rec.get("gh-visibility") or "")
        if org and org in filters.internal_orgs:
            # gh-measured visibility (cached on --refresh) settles the
            # public/private split; org-membership is the offline default.
            return "public" if ghv == "public" else "private"
        return "external"
    return "local"


def pass1_detect(
    projects: list[Project],
    filters: Filters,
    home: Path,
    *,
    write: bool,
    refresh: bool,
) -> None:
    n_git = n_sess = n_hit = 0
    for proj in projects:
        rec = load_practica(proj.path)
        hydrate_git_flags(rec)
        before = json.dumps(ordered_record(rec), sort_keys=True)
        drop_disposition(rec)
        extra = rec.get("extra-noise") or []
        if not isinstance(extra, list):
            extra = []
        extra_s = [str(x) for x in extra]
        set_derived(rec, "project-root", str(proj.path.resolve()))
        for axis, value in census_axis_defaults(proj, filters, home).items():
            set_derived(rec, axis, value)
        if "categories" not in rec:
            rec["categories"] = []
        if "related" not in rec:
            rec["related"] = []
        if "extra-noise" not in rec:
            rec["extra-noise"] = extra_s

        kids = census_child_rels(proj, projects)
        redo_git = refresh or git_cache_stale(proj.path, rec)
        if list(rec.get("stat-kids") or []) != kids:
            redo_git = True
        if (rec.get("git") or rec.get("subgit")) and not rec.get("last-commit-time"):
            redo_git = True
        if redo_git:
            n_git += 1
            info = detect_git(proj.path)
            for k, v in info.items():
                set_derived(rec, k, v)
            head = git_head_id(proj.path)
            if head:
                set_derived(rec, "git-head", head)
            elif "git-head" not in frozen_of(rec):
                rec.pop("git-head", None)
            action, commit = detect_last_action(
                proj.path,
                info,
                extra_s,
                pathspecs=git_pathspecs(kids),
                skip_rels=kids,
            )
            set_derived(rec, "stat-kids", kids)
            if action is not None:
                set_derived(rec, "last-action-time", iso_utc(action))
            elif "last-action-time" not in frozen_of(rec):
                rec.pop("last-action-time", None)
            if commit is not None:
                set_derived(rec, "last-commit-time", iso_utc(commit))
            elif "last-commit-time" not in frozen_of(rec):
                rec.pop("last-commit-time", None)

        if refresh and rec.get("has-remote"):
            vis = gh_visibility(str(rec.get("remote") or ""))
            if vis is not None:
                set_derived(rec, "gh-visibility", vis)
        set_derived(rec, "git-rel", git_rel_of(rec, proj.path, kids))
        set_derived(rec, "git-vis", git_vis_of(rec, filters))

        sess_cached = None
        ls = rec.get("last-session")
        if isinstance(ls, dict):
            sess_cached = parse_ts(ls.get("time"))
        redo_sess = refresh or cache_stale(sess_cached, session_stamp(proj.path, home))
        if redo_sess:
            n_sess += 1
            sess = detect_last_session(proj.path, home)
            if sess is not None:
                set_derived(rec, "last-session", sess)

        proj.rec = rec
        if write and json.dumps(ordered_record(rec), sort_keys=True) != before:
            save_practica(proj.path, rec)
        if not redo_git and not redo_sess:
            n_hit += 1
    if os.environ.get("PROJECTS_CACHE_STATS"):
        print(
            f"projects: cache hit {n_hit}  git-detect {n_git}  session-detect {n_sess}",
            file=sys.stderr,
        )


def resolved(proj: Project) -> Path:
    try:
        return proj.path.resolve()
    except OSError:
        return proj.path


def pass2_names(projects: list[Project], *, write: bool) -> None:
    """Closest to ~ first, then outward. Parent = another census root that is a prefix."""
    ordered = sorted(projects, key=lambda p: (len(resolved(p).parts), str(resolved(p))))
    befores: dict[int, str] = {}
    for proj in ordered:
        rec = proj.rec
        befores[id(proj)] = json.dumps(ordered_record(rec), sort_keys=True)
        rp = resolved(proj)
        parent: Project | None = None
        best = -1
        for other in projects:
            if other is proj:
                continue
            op = resolved(other)
            if op == rp:
                continue
            try:
                rp.relative_to(op)
            except ValueError:
                continue
            n = len(op.parts)
            if n > best:
                best = n
                parent = other
        proj.parent_proj = parent
        set_derived(rec, "subproject", parent is not None)
        if "base-name" not in frozen_of(rec):
            rec["base-name"] = proj.path.name
        if parent is not None:
            pname = parent.rec.get("name") or parent.path.name
            set_derived(rec, "parent-name", pname)
        else:
            set_derived(rec, "parent-name", "")
        bn = rec.get("base-name") or proj.path.name
        pn = rec.get("parent-name") or ""
        set_derived(rec, "name", f"{pn}/{bn}" if pn else bn)
        if not rec.get("last-session") and parent and parent.rec.get("last-session"):
            if "last-session" not in frozen_of(rec):
                rec["last-session"] = dict(parent.rec["last-session"])

    # proj-rel needs the whole parent graph; subgit inherits its census
    # parent's git-vis (a subgit has no remote of its own to judge by).
    has_kids: set[int] = set()
    for proj in projects:
        if proj.parent_proj is not None:
            has_kids.add(id(proj.parent_proj))
    for proj in ordered:
        rec = proj.rec
        kids = id(proj) in has_kids
        parented = proj.parent_proj is not None
        pr = (
            "mid" if (kids and parented)
            else "root" if kids
            else "leaf" if parented
            else "isolated"
        )
        set_derived(rec, "proj-rel", pr)
        if rec.get("git-rel") == "subgit" and proj.parent_proj is not None:
            pvis = proj.parent_proj.rec.get("git-vis")
            if pvis:
                set_derived(rec, "git-vis", pvis)
        if write and json.dumps(ordered_record(rec), sort_keys=True) != befores[id(proj)]:
            save_practica(proj.path, rec)


def populate(
    projects: list[Project],
    filters: Filters,
    home: Path,
    *,
    write: bool,
    refresh: bool = False,
) -> None:
    pass1_detect(projects, filters, home, write=write, refresh=refresh)
    pass2_names(projects, write=write)


# --- output ----------------------------------------------------------------


def display_name(proj: Project) -> str:
    return str(proj.rec.get("name") or proj.cd_name)


def sort_mode_from_args(args: argparse.Namespace) -> str:
    if getattr(args, "alpha", False):
        return "alpha"
    if getattr(args, "changed", False):
        return "changed"
    return "canonical"


def sort_projects(projects: list[Project], mode: str) -> list[Project]:
    if mode == "alpha":
        return sorted(projects, key=lambda p: name_key(display_name(p)))
    if mode == "changed":

        def action_ts(p: Project) -> float:
            t = parse_ts(p.rec.get("last-action-time"))
            if t is None:
                t = parse_ts(p.rec.get("last-commit-time"))
            return t if t is not None else float("-inf")

        return sorted(projects, key=action_ts, reverse=True)
    return list(projects)


def git_cell(proj: Project, by_root: dict[Path, str]) -> str:
    rec = proj.rec
    own = bool(rec.get("git"))
    subgit = bool(rec.get("subgit"))
    submodule = bool(rec.get("submodule"))
    remote = str(rec.get("remote") or "")
    if own:
        if rec.get("has-remote") and remote:
            cell = None
            if remote.startswith(("/", "~")) or remote.startswith("file://"):
                raw = remote[len("file://") :] if remote.startswith("file://") else remote
                try:
                    rp = Path(raw).expanduser().resolve()
                except OSError:
                    rp = Path(raw).expanduser()
                if rp in by_root:
                    cell = f"({by_root[rp]})"
            if cell is None:
                cell = remote
                for prefix in ("https://github.com/", "git@github.com:"):
                    if cell.startswith(prefix):
                        cell = cell[len(prefix) :]
                        break
                if cell.endswith(".git"):
                    cell = cell[: -len(".git")]
        else:
            cell = "(local)"
        if submodule:
            cell += " (sub)"
        return cell
    if subgit:
        parent = str(rec.get("parent-name") or "")
        return f"({parent})" if parent else "(parent)"
    return "--"


def axis_block(rec: dict) -> str:
    """7 chars, one per axis in AXIS_ORDER; '·' = undeclared/unknown."""
    out = []
    for ax in AXIS_ORDER:
        v = rec.get(ax)
        out.append(AXIS_GLYPHS[ax].get(str(v), "·") if v else "·")
    return "".join(out)


def emit_table(
    projects: list[Project],
    cdpath_parents: list[Path],
    *,
    names_only: bool,
    paths_only: bool,
    grouped: bool,
    sort_mode: str,
    show_shadows: bool,
    nul: bool,
    home: Path,
    now: float,
    use_color: bool = True,
    verbosity: int = 0,
) -> None:
    by_root: dict[Path, str] = {}
    for p in projects:
        try:
            by_root[p.path.resolve()] = display_name(p)
        except OSError:
            by_root[p.path] = display_name(p)

    # Counting verbosity: (none) names → -v axes+paths → -vv +desc → -vvv +last/git
    if verbosity <= 1:
        cols = ["axes", "name", "path"]
    elif verbosity == 2:
        cols = ["axes", "name", "path", "desc"]
    else:
        cols = ["axes", "name", "last", "git", "path", "desc"]
    headers = {
        "axes": "AXES", "name": "NAME", "last": "LAST",
        "git": "GIT", "path": "PATH", "desc": "DESC",
    }

    def row_cells(proj: Project) -> dict[str, str]:
        extra = ""
        if show_shadows and proj.shadows:
            extra = "  (shadows " + ", ".join(disp(s, home) for s in proj.shadows) + ")"
        return {
            "axes": axis_block(proj.rec),
            "name": display_name(proj),
            "last": ago(parse_ts(proj.rec.get("last-action-time")), now),
            "git": git_cell(proj, by_root),
            "path": disp(proj.path, home) + extra,
            "desc": str(proj.rec.get("desc") or ""),
        }

    def row(proj: Project) -> None:
        if nul:
            sys.stdout.buffer.write(os.fsencode(proj.path) + b"\0")
            return
        if names_only or verbosity < 1:
            print(display_name(proj))
            return
        if paths_only:
            print(proj.path)
            return
        c = row_cells(proj)
        level = highlight_level(proj.rec)
        parts: list[str] = []
        for col in cols:
            if col == "name":
                continue
            pad = widths[col] if col != cols[-1] else 0
            parts.append(f"{c[col]:<{pad}}" if pad else c[col])
        axes_s = parts.pop(0)
        rest = "  ".join(parts).rstrip()
        nm = c["name"]
        if not use_color:
            print(f"{axes_s}  {nm:<{widths['name']}}  {rest}".rstrip())
            return
        named = style_name(f"{nm:<{widths['name']}}", level, dark=macos_dark())
        line = f"{axes_s}  {named}"
        if level >= HIGHLIGHT_UNDERLINE_AT:
            print(f"\x1b[4m{line}  {rest}\x1b[0m")
        elif level != 1:
            print(f"{line}\x1b[0m  {rest}")
        else:
            print(f"{axes_s}  {nm:<{widths['name']}}  {rest}".rstrip())

    widths: dict[str, int] = {}
    if not (names_only or paths_only or nul or verbosity < 1):
        cells = [row_cells(p) for p in projects]
        for col in cols:
            widths[col] = max(
                [len(headers[col])] + [len(c[col]) for c in cells]
            )
        print("  ".join(
            f"{headers[col]:<{widths[col]}}" if col != cols[-1] else headers[col]
            for col in cols
        ).rstrip())

    if grouped:
        by_parent: dict[Path, list[Project]] = {p: [] for p in cdpath_parents}
        for proj in projects:
            by_parent.setdefault(proj.cdpath_parent, []).append(proj)
        first = True
        for parent in cdpath_parents:
            group = by_parent.get(parent, [])
            if not group:
                continue
            group = sort_projects(group, sort_mode)
            if not names_only and not paths_only and not nul:
                if not first:
                    print()
                print(f"# {disp(parent, home)}")
                first = False
            for proj in group:
                row(proj)
        if not names_only and not paths_only and not nul and not first:
            print()
        return

    for proj in sort_projects(list(projects), sort_mode):
        row(proj)


def elide(s: str, width: int = HEATMAP_NAME_W) -> str:
    if len(s) <= width:
        return s
    if width <= 1:
        return "…"[:width]
    return s[: width - 1] + "…"


def hex_rgb(h: str) -> tuple[int, int, int]:
    h = h.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def mix_hex(a: str, b: str, t: float) -> str:
    t = max(0.0, min(1.0, t))
    ar, ag, ab = hex_rgb(a)
    br, bg, bb = hex_rgb(b)
    r = round(ar * (1 - t) + br * t)
    g = round(ag * (1 - t) + bg * t)
    b = round(ab * (1 - t) + bb * t)
    return f"#{r:02x}{g:02x}{b:02x}"


def ansi_fg(hex_color: str) -> str:
    r, g, b = hex_rgb(hex_color)
    return f"\x1b[38;2;{r};{g};{b}m"


def ansi_block(hex_color: str) -> str:
    r, g, b = hex_rgb(hex_color)
    return f"\x1b[38;2;{r};{g};{b}m█"


HIGHLIGHT_RED = "#ff1a1a"
HIGHLIGHT_UNDERLINE_AT = 8


def highlight_level(rec: dict) -> int:
    raw = rec.get("highlight")
    if raw is None or raw == "":
        return 1
    try:
        n = int(raw)
    except (TypeError, ValueError):
        return 1
    return max(0, min(10, n))


def style_name(name: str, level: int, *, dark: bool) -> str:
    if level <= 0:
        hx = "#6a6a6a" if dark else "#9a9a9a"
        return ansi_fg(hx) + name
    if level <= 1:
        return name
    t = (level - 1) / 9.0
    base = "#dddddd" if dark else "#222222"
    out = ansi_fg(mix_hex(base, HIGHLIGHT_RED, t)) + name
    if level >= 10:
        out = "\x1b[1;3m" + out + "\x1b[22;23m"
    return out


def heatmap_window(today: date | None = None) -> list[date]:
    """Newest first (far left = today).

    Always 17 complete Sun–Sat weeks plus the current week through today.
    Grows one column a day (Sun = shortest, Sat = longest); the next Sunday
    drops the oldest full week and snaps back.
    """
    if today is None:
        today = datetime.now().astimezone().date()
    into = (today.weekday() + 1) % 7  # 0 on Sunday, 6 on Saturday
    n = HEATMAP_FULL_WEEKS * 7 + into + 1
    return [today - timedelta(days=i) for i in range(n)]


def heatmap_panels(extra: int = 0, today: date | None = None) -> list[list[date]]:
    """Primary window, then `extra` older 17-week bands (contiguous, newest first)."""
    primary = heatmap_window(today)
    if extra <= 0:
        return [primary]
    n = len(primary) + extra * HEATMAP_FULL_WEEKS * 7
    full = [primary[0] - timedelta(days=i) for i in range(n)]
    panels = [full[: len(primary)]]
    off = len(primary)
    chunk = HEATMAP_FULL_WEEKS * 7
    for _ in range(extra):
        panels.append(full[off : off + chunk])
        off += chunk
    return panels


def week_align_pad(slots: list[date | None]) -> int:
    """Columns to shift an older band so its weeks sit under the primary's weeks."""
    runs = week_runs(slots)
    if not runs:
        return 0
    start, days = runs[0]
    if len(days) >= 7:
        return 0
    pad = len(days)
    gap = start + len(days)
    if gap < len(slots) and slots[gap] is None:
        pad += 1
    return pad


def local_day(ts: float) -> date:
    return datetime.fromtimestamp(ts).date()


def prune_days(days: dict, window: list[date]) -> dict[str, int]:
    keep = {d.isoformat() for d in window}
    return {k: int(v) for k, v in days.items() if k in keep and int(v) > 0}


def add_timestamps(days: dict[str, int], stamps: list[float]) -> None:
    for ts in stamps:
        key = local_day(ts).isoformat()
        days[key] = days.get(key, 0) + 1


def git_commit_times_since(
    root: Path, after_ts: float, pathspecs: list[str] | None = None
) -> list[float] | None:
    specs = pathspecs or ["."]
    code, out = git_run(
        root,
        "log",
        "--pretty=format:%ct",
        f"--after={int(after_ts)}",
        "--",
        *specs,
        timeout=60,
    )
    if code != 0:
        return None
    stamps: list[float] = []
    for line in out.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            stamps.append(float(line))
        except ValueError:
            continue
    return stamps


def git_first_commit_ts(
    root: Path, pathspecs: list[str] | None = None
) -> float | None:
    """Oldest commit touching pathspecs. Default log is newest-first; take the last line.

    `git log --reverse -1` is *not* this — `-1`/`--max-count` selects before
    reverse, so you get the newest commit printed once.
    """
    specs = pathspecs or ["."]
    code, out = git_run(
        root, "log", "--pretty=format:%ct", "--", *specs, timeout=60
    )
    if code != 0 or not out:
        return None
    lines = [ln.strip() for ln in out.splitlines() if ln.strip()]
    if not lines:
        return None
    try:
        return float(lines[-1])
    except ValueError:
        return None


def macos_dark() -> bool:
    try:
        r = subprocess.run(
            ["defaults", "read", "-g", "AppleInterfaceStyle"],
            capture_output=True,
            text=True,
            timeout=1,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return r.returncode == 0 and "Dark" in (r.stdout or "")


def scale_t(count: int, maxc: int) -> float:
    """log1p t in [0, 1] matching activity colors. 0 if no count/max."""
    if count <= 0 or maxc <= 0:
        return 0.0
    t = math.log1p(count) / math.log1p(maxc)
    return max(1.0 / (_INFERNO_N - 1), min(1.0, t))


def idle_span_days(last_count: int, maxc: int) -> int:
    """Head-fade length: 14 days at scale max, ~1–2 days for a couple of commits."""
    t = scale_t(last_count, maxc)
    if t <= 0:
        return DIM_HEAD_DAYS
    return max(1, int(round(DIM_HEAD_DAYS * t)))


def dim_zero_fills(
    window: list[date],
    days: dict[str, int],
    first_ts: float | None,
    last_commit_ts: float | None = None,
    *,
    dark: bool,
    maxc: int = 0,
) -> tuple[dict[str, str], dict[str, str]]:
    """iso → (hex, kind) for cells that shouldn't use activity inferno.

    Head (newest / left): idle walks the heat scale from the last
    non-zero day's t down to 0. After 4 weeks of inactivity the 5th
    week fades that white-zero toward #eff1f5 (historical vs neglected).
    Tail (oldest / right): wash #e6e6f1 except a 4-day onramp up the
    heat scale to t=0.5. If first commit is after this window, the
    whole panel is pre-birth wash, not activity-zero.

    Kinds: onramp / offramp count as week-stats pseudo-work.
    wash / zero / birth / stale do not.

    Third return: iso → heat-scale t for the ramped kinds
    (onramp / offramp / birth), so a glyph rendering can share the scale.
    """
    invert = not dark
    wash = invert_hex(TAIL_WASH_LIGHT) if dark else TAIL_WASH_LIGHT
    mid = inferno_hex(0.5, invert=invert)
    counts = [int(days.get(d.isoformat(), 0)) for d in window]
    n = len(window)
    fills: dict[str, str] = {}
    kinds: dict[str, str] = {}
    tvals: dict[str, float] = {}
    if n == 0:
        return fills, kinds, tvals

    def paint(iso: str, hx: str, kind: str, t: float | None = None) -> None:
        fills[iso] = hx
        kinds[iso] = kind
        if t is not None:
            tvals[iso] = t

    i = 0
    while i < n and counts[i] == 0:
        i += 1
    k = n - 1
    while k >= 0 and counts[k] == 0:
        k -= 1
    suffix = n - 1 - k
    all_zero = i + suffix >= n and i > 0

    first_d = local_day(first_ts) if first_ts is not None else None
    born_in_window = (
        first_d is not None and window[-1] <= first_d <= window[0]
    )
    born_after_window = first_d is not None and first_d > window[0]

    def head_ramp(prefix_len: int) -> None:
        last_c = local_day(last_commit_ts) if last_commit_ts is not None else None
        last_count = 0
        if 0 <= prefix_len < n:
            last_count = counts[prefix_len]
        elif i < n:
            last_count = counts[i]
        t0 = scale_t(last_count, maxc)
        span = idle_span_days(last_count, maxc)
        zero = inferno_hex(0.0, invert=invert)
        stale = invert_hex(STALE_LIGHT) if dark else STALE_LIGHT
        for j in range(prefix_len):
            d = window[j]
            iso = d.isoformat()
            if last_c is None:
                paint(iso, zero, "zero")
                continue
            idle = (d - last_c).days
            if idle < 1:
                continue
            if idle <= span:
                progress = idle / span
                t = t0 * (1.0 - progress)
                paint(iso, inferno_hex(t, invert=invert), "offramp", t)
            elif idle <= STALE_AFTER_DAYS:
                paint(iso, zero, "zero")
            else:
                p = min(1.0, (idle - STALE_AFTER_DAYS) / STALE_FADE_DAYS)
                paint(iso, mix_hex(zero, stale, p), "stale")

    def paint_tail(start: int) -> None:
        for j in range(start, n):
            paint(window[j].isoformat(), wash, "wash")
        if first_ts is None:
            return
        first_d = local_day(first_ts)
        for ahead in range(1, 5):
            d = first_d - timedelta(days=ahead)
            iso = d.isoformat()
            if iso in fills:
                t = 0.5 * (5 - ahead) / 4.0
                paint(iso, inferno_hex(t, invert=invert), "onramp", t)

    def paint_birth() -> None:
        if first_ts is None:
            return
        biso = local_day(first_ts).isoformat()
        if days.get(biso, 0) == 0 and any(d.isoformat() == biso for d in window):
            paint(biso, mid, "birth", 0.5)

    if born_after_window:
        paint_tail(0)
        return fills, kinds, tvals

    if all_zero:
        if born_in_window and first_ts is not None:
            first_d = local_day(first_ts)
            j = 0
            while j < n and window[j] > first_d:
                j += 1
            if j > 0:
                head_ramp(j)
            t = n - 1
            while t >= 0 and window[t] < first_d:
                t -= 1
            if n - 1 - t >= DIM_ZERO_MIN:
                paint_tail(t + 1)
        elif i > 0:
            head_ramp(i)
        paint_birth()
        return fills, kinds, tvals

    if i > 0:
        head_ramp(i)
    if born_in_window and suffix >= DIM_ZERO_MIN:
        paint_tail(k + 1)
    paint_birth()
    return fills, kinds, tvals


def heatmap_counts(
    proj: Project,
    window: list[date],
    projects: list[Project],
    *,
    refresh: bool,
    write: bool,
) -> dict[str, int]:
    rec = proj.rec
    extra = rec.get("extra-noise") or []
    extra_s = [str(x) for x in extra] if isinstance(extra, list) else []
    gitish = bool(rec.get("git") or rec.get("subgit"))
    kids = census_child_rels(proj, projects)
    specs = git_pathspecs(kids)
    kids_changed = list(rec.get("heatmap-kids") or []) != kids
    head = containing_head_id(proj.path) if gitish else None
    head_changed = bool(gitish) and rec.get("heatmap-head") != head

    if gitish and (refresh or kids_changed or not rec.get("first-commit")):
        fts = git_first_commit_ts(proj.path, specs)
        if fts is not None:
            set_derived(rec, "first-commit", iso_utc(fts))
    if not gitish:
        # No commit stream: file birth + mtime are the proxy for change-counts.
        # Active no-git rows are tiny; still reuse the day cache unless refresh
        # or the window grew past what the cache was pruned to (--double/--triple).
        cached_ng = rec.get("heatmap-days") if isinstance(rec.get("heatmap-days"), dict) else {}
        ng_span = min(window).isoformat()
        ng_cached_span = str(rec.get("heatmap-span-oldest") or "")[:10]
        ng_span_ok = bool(ng_cached_span) and ng_cached_span <= ng_span
        if not refresh and rec.get("first-commit") and cached_ng and ng_span_ok:
            return prune_days(
                {str(k): int(v) for k, v in cached_ng.items() if str(k)},
                window,
            )
        events = file_event_times(proj.path, extra_s, kids, limit=None)
        days: dict[str, int] = {}
        if events:
            add_timestamps(days, events)
            set_derived(rec, "first-commit", iso_utc(min(events)))
            set_derived(rec, "last-action-time", iso_utc(max(events)))
        else:
            fts = dir_birth_ts(proj.path)
            if fts is not None:
                set_derived(rec, "first-commit", iso_utc(fts))
        days = prune_days(days, window)
        now = datetime.now(tz=timezone.utc).timestamp()
        set_derived(rec, "heatmap-days", days)
        set_derived(rec, "heatmap-as-of", iso_utc(now))
        set_derived(rec, "heatmap-kids", kids)
        set_derived(rec, "heatmap-span-oldest", ng_span)
        if write:
            save_practica(proj.path, rec)
        return days

    cached = rec.get("heatmap-days") if isinstance(rec.get("heatmap-days"), dict) else {}
    as_of = parse_ts(rec.get("heatmap-as-of"))
    oldest = min(window)
    start_ts = datetime.combine(oldest, datetime.min.time()).timestamp()
    span_iso = oldest.isoformat()
    cached_span = str(rec.get("heatmap-span-oldest") or "")[:10]
    span_short = (not cached_span) or cached_span > span_iso
    need_log = refresh or as_of is None or kids_changed or head_changed or span_short
    if not need_log:
        # HEAD unchanged: reuse day counts. Skip git status — AISI-responses
        # alone is ~2s of lstat over a 300k-file work tree, and 44 statuses
        # were the whole warm-run cost. Dirty overlay still runs when HEAD
        # moves or on --refresh.
        return prune_days(
            {str(k): int(v) for k, v in cached.items() if str(k)},
            window,
        )

    if refresh or as_of is None or kids_changed or span_short:
        days = {}
        after = start_ts - 1
    else:
        days = {str(k): int(v) for k, v in cached.items() if str(k)}
        after = as_of
    stamps = git_commit_times_since(proj.path, after, specs)
    if stamps is not None:
        add_timestamps(days, stamps)
        days = prune_days(days, window)
        now = datetime.now(tz=timezone.utc).timestamp()
        set_derived(rec, "heatmap-days", days)
        set_derived(rec, "heatmap-as-of", iso_utc(now))
        set_derived(rec, "heatmap-kids", kids)
        set_derived(rec, "heatmap-span-oldest", span_iso)
        if head is not None:
            set_derived(rec, "heatmap-head", head)
        if write:
            save_practica(proj.path, rec)
    else:
        days = prune_days(days, window)
    display = dict(days)
    add_timestamps(
        display, exclusive_dirty_mtimes(proj.path, extra_s, kids)
    )
    return prune_days(display, window)


def heat_hex(count: int, maxc: int, *, invert: bool = False) -> str:
    """log1p scale so 1–10–30 stay distinct when the max is a busy monorepo day.

    Returns a continuous inferno color (not a bin). A positive count is
    floored one LUT step above empty so 1-commit days don't collapse to 0.
    `invert` for light terminals (1.0 - rgb).
    """
    if count <= 0 or maxc <= 0:
        return inferno_hex(0.0, invert=invert)
    t = math.log1p(count) / math.log1p(maxc)
    t = max(0.0, min(1.0, t))
    t = max(t, 1.0 / (_INFERNO_N - 1))
    return inferno_hex(t, invert=invert)


def week_gap(a: date, b: date) -> bool:
    """True on the Saturday/Sunday boundary (either time direction)."""
    return {a.weekday(), b.weekday()} == {5, 6}


def heatmap_slots(window: list[date]) -> list[date | None]:
    """Day cells with a blank slot between Sat and Sun."""
    slots: list[date | None] = []
    for i, d in enumerate(window):
        if i > 0 and week_gap(window[i - 1], d):
            slots.append(None)
        slots.append(d)
    return slots


def week_runs(slots: list[date | None]) -> list[tuple[int, list[date]]]:
    """Consecutive day runs between Sat/Sun gaps: (start index in slots, days)."""
    runs: list[tuple[int, list[date]]] = []
    start: int | None = None
    days: list[date] = []
    for i, s in enumerate(slots):
        if s is None:
            if days and start is not None:
                runs.append((start, days))
            start = None
            days = []
            continue
        if start is None:
            start = i
        days.append(s)
    if days and start is not None:
        runs.append((start, days))
    return runs


def week_stats_line(
    slots: list[date | None],
    rows: list[tuple[dict[str, int], dict[str, str]]],
    *,
    name_w: int,
    left_pad: int = 0,
) -> str:
    """`| 25·254 |` over each full week — space after the pipe, then
    nproj·ncontrib, then spaces until the next Sat/Sun pipe.

    A project counts if it has any commits that week, or an onramp /
    offramp fill (not 0-commit white, wash, birth, or stale).
    """
    cols = ["|" if s is None else " " for s in slots]
    for start, wdays in week_runs(slots):
        if len(wdays) != 7:
            continue
        isos = [d.isoformat() for d in wdays]
        nproj = 0
        ncontrib = 0
        for days, kinds in rows:
            week_sum = 0
            active = False
            for iso in isos:
                c = int(days.get(iso, 0))
                week_sum += c
                if c > 0 or kinds.get(iso) in PSEUDO_KINDS:
                    active = True
            if active:
                nproj += 1
            ncontrib += week_sum
        label = f" {nproj}·{ncontrib}"
        for k, ch in enumerate(label):
            j = start + k
            if j >= len(cols) or slots[j] is None:
                break
            cols[j] = ch
    prefix = " " * left_pad
    return " " * name_w + "  " + prefix + "".join(cols)


def month_header(window: list[date], name_w: int, left_pad: int = 0) -> str:
    """`<- Aug |` at the start of the month — the older/right edge.

    Newest is left, so day 1 sits on the right of that month's span.
    Reading right-to-left: `|` then immediately left of it, `<- Aug`.
    Omitted if the span is too short to fit.
    """
    slots = heatmap_slots(window)
    cols = [" "] * len(slots)
    i = 0
    while i < len(slots):
        d = slots[i]
        if d is None:
            i += 1
            continue
        ym = (d.year, d.month)
        end = i + 1
        while end < len(slots) and (
            slots[end] is None or (slots[end].year, slots[end].month) == ym
        ):
            end += 1
        label = f"<- {d.strftime('%b')} |"
        pos = end - len(label)
        if pos >= i:
            for j, ch in enumerate(label):
                cols[pos + j] = ch
        i = end
    return " " * name_w + "  " + (" " * left_pad) + "".join(cols)


def scale_bar(maxc: int, *, invert: bool = False) -> str:
    last = SCALE_BAR_N - 1
    blocks = "".join(
        ansi_block(inferno_hex(i / last if last else 0.0, invert=invert))
        for i in range(SCALE_BAR_N)
    ) + "\x1b[0m"
    label = f"0 → {maxc}/day  (log)"
    return f"{label:>{HEATMAP_NAME_W}}  {blocks}"


def glyph_legend(maxc: int) -> str:
    label = f"0 → {maxc}/day  (log)"
    return (
        f"{label:>{HEATMAP_NAME_W}}  "
        f"{GLYPH_RAMP[1:]}   {GLYPH_WASH} pre-birth   (zero/stale blank)"
        f"   weeks: |nproj·ncommits"
    )


def color_enabled(mode: str) -> bool:
    if mode == "always":
        return True
    if mode == "never":
        return False
    return sys.stdout.isatty()


def cmd_heatmap(args: argparse.Namespace) -> int:
    home = Path.home()
    projects, filters, parents = gather(args, home)
    populate(
        projects,
        filters,
        home,
        write=not args.no_write,
        refresh=args.refresh,
    )
    active = [p for p in projects if p.rec.get("activity") == "active"]
    extra = 2 if getattr(args, "triple", False) else 1 if getattr(args, "double", False) else 0
    panels = heatmap_panels(extra)
    fetch_window = [d for panel in panels for d in panel]
    counts: dict[Path, dict[str, int]] = {}
    maxc = 0
    for proj in active:
        days = heatmap_counts(
            proj,
            fetch_window,
            projects,
            refresh=args.refresh,
            write=not args.no_write,
        )
        try:
            key = proj.path.resolve()
        except OSError:
            key = proj.path
        counts[key] = days
        if days:
            maxc = max(maxc, max(days.values()))

    mode = sort_mode_from_args(args)
    if args.format == "json":
        return heatmap_json(active, counts, maxc, fetch_window, mode)
    use_color = color_enabled(args.color)
    dark = macos_dark() if use_color else False
    invert = not dark
    align = week_align_pad(heatmap_slots(panels[0]))

    def proj_key(proj: Project) -> Path:
        try:
            return proj.path.resolve()
        except OSError:
            return proj.path

    def emit_row(
        proj: Project,
        slots: list[date | None],
        fills: dict[str, str],
        kinds: dict[str, str],
        tvals: dict[str, float],
        left_pad: int,
    ) -> None:
        key = proj_key(proj)
        days = counts.get(key, {})
        level = highlight_level(proj.rec)
        name = elide(display_name(proj)).rjust(HEATMAP_NAME_W)
        if not use_color:
            cells = [" "] * left_pad
            for slot in slots:
                if slot is None:
                    cells.append(" ")
                    continue
                iso = slot.isoformat()
                kind = kinds.get(iso)
                if kind == "wash":
                    cells.append(GLYPH_WASH)
                elif kind == "stale":
                    cells.append(GLYPH_STALE)
                elif kind == "zero":
                    cells.append(" ")
                elif kind in ("onramp", "offramp", "birth"):
                    cells.append(ramp_glyph(tvals.get(iso, 0.0)))
                else:
                    cells.append(ramp_glyph(scale_t(int(days.get(iso, 0)), maxc)))
            print(name + "  " + "".join(cells))
            return
        named = style_name(name, level, dark=dark)
        cells = [" "] * left_pad
        for slot in slots:
            if slot is None:
                cells.append(" ")
                continue
            iso = slot.isoformat()
            if iso in fills:
                hx = fills[iso]
            else:
                hx = heat_hex(int(days.get(iso, 0)), maxc, invert=invert)
            cells.append(ansi_block(hx))
        prefix = "\x1b[4m" if level >= HIGHLIGHT_UNDERLINE_AT else ""
        print(prefix + named + "  " + "".join(cells) + "\x1b[0m")

    def existed_in_window(proj: Project, window: list[date]) -> bool:
        """True unless first-commit is after this panel's newest day.

        Extra bands drop rows that were not yet born at any point in those
        17 weeks (the whole-row pre-birth wash). Born mid-window stays —
        that's where the activity is. Unknown first-commit stays.
        """
        first_ts = parse_ts(proj.rec.get("first-commit"))
        if first_ts is None:
            return True
        return local_day(first_ts) <= window[0]

    def render_panel(
        window: list[date], left_pad: int, *, omit_unborn: bool = False
    ) -> None:
        shown = (
            [p for p in active if existed_in_window(p, window)]
            if omit_unborn
            else list(active)
        )
        slots = heatmap_slots(window)
        fills_by: dict[Path, dict[str, str]] = {}
        kinds_by: dict[Path, dict[str, str]] = {}
        tvals_by: dict[Path, dict[str, float]] = {}
        for proj in shown:
            key = proj_key(proj)
            days = prune_days(counts.get(key, {}), window)
            first_ts = parse_ts(proj.rec.get("first-commit"))
            last_c = parse_ts(proj.rec.get("last-action-time")) or parse_ts(
                proj.rec.get("last-commit-time")
            )
            fills, kinds, tvals = dim_zero_fills(
                window, days, first_ts, last_c, dark=dark, maxc=maxc
            )
            fills_by[key] = fills
            kinds_by[key] = kinds
            tvals_by[key] = tvals
        print(month_header(window, HEATMAP_NAME_W, left_pad=left_pad))
        print(
            week_stats_line(
                slots,
                [
                    (
                        prune_days(counts.get(proj_key(p), {}), window),
                        kinds_by.get(proj_key(p), {}),
                    )
                    for p in shown
                ],
                name_w=HEATMAP_NAME_W,
                left_pad=left_pad,
            )
        )
        if args.group:
            by_parent: dict[Path, list[Project]] = {p: [] for p in parents}
            for proj in shown:
                by_parent.setdefault(proj.cdpath_parent, []).append(proj)
            first = True
            for parent in parents:
                group = by_parent.get(parent, [])
                if not group:
                    continue
                group = sort_projects(group, mode)
                if not first:
                    print()
                print(f"# {disp(parent, home)}")
                first = False
                for proj in group:
                    k = proj_key(proj)
                    emit_row(
                        proj, slots, fills_by.get(k, {}), kinds_by.get(k, {}),
                        tvals_by.get(k, {}), left_pad,
                    )
            if not first:
                print()
        else:
            for proj in sort_projects(shown, mode):
                k = proj_key(proj)
                emit_row(
                    proj, slots, fills_by.get(k, {}), kinds_by.get(k, {}),
                    tvals_by.get(k, {}), left_pad,
                )
            print()

    rule_w = HEATMAP_NAME_W + 2 + len(heatmap_slots(panels[0]))
    for i, panel in enumerate(panels):
        if i > 0:
            print("─" * rule_w)
        render_panel(panel, 0 if i == 0 else align, omit_unborn=i > 0)
    print(scale_bar(maxc, invert=invert) if use_color else glyph_legend(maxc))
    return 0


