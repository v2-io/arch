def _jet_hexes(n: int = 60) -> list[str]:
    """MATLAB/matplotlib jet: navy → cyan → yellow → red."""

    def rgb(t: float) -> tuple[float, float, float]:
        t = max(0.0, min(1.0, t))
        if t < 0.125:
            return 0.0, 0.0, 0.5 + 4.0 * t
        if t < 0.375:
            return 0.0, 4.0 * (t - 0.125), 1.0
        if t < 0.625:
            return 4.0 * (t - 0.375), 1.0, 1.0 - 4.0 * (t - 0.375)
        if t < 0.875:
            return 1.0, 1.0 - 4.0 * (t - 0.625), 0.0
        return 1.0 - 4.0 * (t - 0.875), 0.0, 0.0

    out: list[str] = []
    for i in range(n):
        t = i / (n - 1) if n > 1 else 0.0
        r, g, b = rgb(t)
        out.append(
            f"#{int(round(r * 255)):02x}{int(round(g * 255)):02x}{int(round(b * 255)):02x}"
        )
    return out


