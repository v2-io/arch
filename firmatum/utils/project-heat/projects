def ramp_glyph(t: float) -> str:
    if t <= 0:
        return " "
    return GLYPH_RAMP[max(1, min(8, math.ceil(t * 8)))]


def invert_hex(h: str) -> str:
    h = h.lstrip("#")
    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    return f"#{255 - r:02x}{255 - g:02x}{255 - b:02x}"


