#!/usr/bin/env python3
"""repo-heat — per-repo commits/day heatmap (calendar-time EMA).

Sibling of git-heat, which scores *paths inside one repo* by commits-behind-HEAD.
This scores *repositories* against each other by an exponentially-weighted
commit rate with a wall-clock half-life (default 7 days).

Catalog
  gh repo list for each --owner (default: josephwecker, v2-io), plus
  local-only trees: --local PATH and, by default, top-level no-remote
  git repos under --src (AISI-responses, vestigia, …).

Score
  κ = ln(2) / half_life_days
  score = κ · Σ  2^(-age_days / half_life)     over unique SHAs
  units: commits/day. A steady 1 commit/day forever → 1.0.
  A commit one half-life ago contributes half of one today.

Local `git log --branches` is the source of timestamps when a clone exists
(unpushed work counts; a fetch of a fork's upstream does not). Repos with no
clone fall back to the GitHub commits API (skipped for forks — upstream
history would impersonate heat). Cache: ~/.cache/repo-heat/

Examples
  repo-heat
  repo-heat --half-life 3 --top 20
  repo-heat --format json
  repo-heat --local ~/src/AISI-responses --no-discover-local
"""

from __future__ import annotations

import argparse
import concurrent.futures
import json
import math
import os
import re
import stat
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Iterable
from urllib.parse import urlparse

DEFAULT_OWNERS = ("josephwecker", "v2-io")
DEFAULT_HALF_LIFE = 7.0
WINDOW_HALFLIVES = 12.0
CATALOG_TTL_SEC = 3600.0
BAR_WIDTH = 12
SKIP_WALK_NAMES = frozenset(
    {
        ".git",
        "node_modules",
        "target",
        ".venv",
        "venv",
        "__pycache__",
        "vendor",
        "deps",
        "build",
        ".build",
        "_ref",
        "MOVED",
        "ruby-community",
        "_exp",
        "_archive",
        ".archive",
        "INGEST",
        "tmp",
    }
)
PATH_PENALTY_SUBSTR = (
    "/MOVED/",
    "/_ref/",
    "/INGEST/",
    "/vendor/",
    "/deps/",
    "/_archive/",
    "/.archive/",
    "/ruby-community/",
    "/_exp/",
    "/tmp/",
)
NWO_RE = re.compile(
    r"(?:github\.com[:/])(?P<owner>[^/]+)/(?P<repo>[^/]+?)(?:\.git)?$",
    re.I,
)


def cache_dir() -> Path:
    xdg = os.environ.get("XDG_CACHE_HOME")
    base = Path(xdg) if xdg else Path.home() / ".cache"
    return base / "repo-heat"


def atomic_write_json(path: Path, obj: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".tmp-", suffix=".json")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(obj, f, indent=2)
            f.write("\n")
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def load_json(path: Path) -> Any | None:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def git(
    repo: Path, *args: str, timeout: int = 60
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(repo), *args],
        capture_output=True,
        text=True,
        timeout=timeout,
    )


def git_ok(repo: Path, *args: str, timeout: int = 60) -> str | None:
    try:
        r = git(repo, *args, timeout=timeout)
    except (subprocess.TimeoutExpired, OSError):
        return None
    if r.returncode != 0:
        return None
    return r.stdout


def nwo_from_url(url: str) -> str | None:
    url = url.strip().rstrip("/")
    if not url:
        return None
    url = re.sub(r"\.git$", "", url, flags=re.I)
    m = NWO_RE.search(url)
    if m:
        owner, repo = m.group("owner"), m.group("repo")
        repo = repo.removesuffix(".git")
        return f"{owner}/{repo}".lower()
    try:
        u = urlparse(url if "://" in url else "ssh://" + url.replace(":", "/", 1))
    except ValueError:
        return None
    if u.hostname and "github.com" in u.hostname.lower() and u.path:
        parts = [p for p in u.path.split("/") if p]
        if len(parts) >= 2:
            repo = parts[1].removesuffix(".git")
            return f"{parts[0]}/{repo}".lower()
    return None


def home_tilde(path: Path) -> str:
    try:
        return "~/" + str(path.expanduser().resolve().relative_to(Path.home()))
    except (ValueError, OSError):
        return str(path)


def path_penalty(path: Path) -> tuple[int, int]:
    s = str(path.resolve()) + "/"
    penalty = sum(10 for p in PATH_PENALTY_SUBSTR if p in s)
    return penalty, len(path.parts)


@dataclass
class GhRepo:
    nwo: str
    name: str
    private: bool
    fork: bool
    archived: bool
    pushed_at: str | None
    default_branch: str
    url: str


@dataclass
class Clone:
    path: Path
    common_dir: Path
    nwo: str | None
    head_ts: int = 0


@dataclass
class Scored:
    id: str
    score: float
    n_window: int
    n_7d: int
    last_ts: int | None
    last_kind: str  # commit | pushed | none
    local_paths: list[str]
    source: str  # local | github | none
    private: bool = False
    fork: bool = False
    archived: bool = False
    extra: dict[str, Any] = field(default_factory=dict)


def parse_gh_repos(raw: list[dict[str, Any]]) -> list[GhRepo]:
    out: list[GhRepo] = []
    for r in raw:
        nwo = r.get("nameWithOwner") or ""
        if not nwo:
            continue
        br = r.get("defaultBranchRef") or {}
        out.append(
            GhRepo(
                nwo=nwo.lower() if "/" in nwo else nwo,
                name=r.get("name") or nwo.split("/")[-1],
                private=bool(r.get("isPrivate")),
                fork=bool(r.get("isFork")),
                archived=bool(r.get("isArchived")),
                pushed_at=r.get("pushedAt"),
                default_branch=(br.get("name") or "") if isinstance(br, dict) else "",
                url=r.get("url") or f"https://github.com/{nwo}",
            )
        )
    return out


def fetch_catalog(owners: list[str], refresh: bool) -> tuple[list[GhRepo], str]:
    """Return (repos, source_note). Caches gh list for CATALOG_TTL_SEC."""
    cdir = cache_dir()
    path = cdir / "catalog.json"
    key = ",".join(owners)
    if not refresh:
        cached = load_json(path)
        if (
            isinstance(cached, dict)
            and cached.get("owners") == key
            and isinstance(cached.get("fetched_at"), (int, float))
            and time.time() - float(cached["fetched_at"]) < CATALOG_TTL_SEC
            and isinstance(cached.get("repos"), list)
        ):
            return parse_gh_repos(cached["repos"]), f"cache {path}"
    repos_raw: list[dict[str, Any]] = []
    for owner in owners:
        try:
            r = subprocess.run(
                [
                    "gh",
                    "repo",
                    "list",
                    owner,
                    "--limit",
                    "1000",
                    "--json",
                    "name,nameWithOwner,isPrivate,isFork,isArchived,pushedAt,url,defaultBranchRef",
                ],
                capture_output=True,
                text=True,
                timeout=120,
            )
        except (subprocess.TimeoutExpired, OSError) as e:
            # fall back to cache if we have any
            cached = load_json(path)
            if isinstance(cached, dict) and isinstance(cached.get("repos"), list):
                return parse_gh_repos(cached["repos"]), f"stale cache (gh failed: {e})"
            raise SystemExit(f"repo-heat: gh repo list {owner} failed: {e}") from e
        if r.returncode != 0:
            cached = load_json(path)
            err = (r.stderr or r.stdout or "gh failed").strip().splitlines()
            msg = err[-1] if err else "gh failed"
            if isinstance(cached, dict) and isinstance(cached.get("repos"), list):
                return parse_gh_repos(cached["repos"]), f"stale cache ({msg})"
            raise SystemExit(f"repo-heat: gh repo list {owner}: {msg}")
        try:
            batch = json.loads(r.stdout)
        except json.JSONDecodeError as e:
            raise SystemExit(f"repo-heat: gh repo list {owner}: bad json ({e})") from e
        if not isinstance(batch, list):
            raise SystemExit(f"repo-heat: gh repo list {owner}: expected a list")
        repos_raw.extend(batch)
    atomic_write_json(
        path,
        {"owners": key, "fetched_at": time.time(), "repos": repos_raw},
    )
    return parse_gh_repos(repos_raw), "gh"


def walk_git_repos(src: Path, deep: bool) -> list[Path]:
    skip = set(SKIP_WALK_NAMES)
    if deep:
        skip -= {"_ref", "MOVED", "ruby-community", "_exp", "_archive", ".archive", "INGEST"}
    found: list[Path] = []
    if not src.is_dir():
        return found
    for dirpath, dirnames, _files in os.walk(src, followlinks=False):
        base = os.path.basename(dirpath)
        if base in skip:
            dirnames[:] = []
            continue
        dirnames[:] = [d for d in dirnames if d not in skip]
        git_entry = os.path.join(dirpath, ".git")
        try:
            st = os.lstat(git_entry)
        except OSError:
            continue
        if stat.S_ISDIR(st.st_mode) or stat.S_ISREG(st.st_mode):
            found.append(Path(dirpath))
    return found


def inspect_clone(path: Path) -> Clone | None:
    common = git_ok(path, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if common is None:
        return None
    common_dir = Path(common.strip())
    remotes = git_ok(path, "remote", "-v") or ""
    nwo: str | None = None
    origin: str | None = None
    any_nwo: str | None = None
    for line in remotes.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue
        got = nwo_from_url(parts[1])
        if not got:
            continue
        any_nwo = any_nwo or got
        if parts[0] == "origin":
            origin = got
    nwo = origin or any_nwo
    head_ts = 0
    ts_s = git_ok(path, "log", "-1", "--format=%ct")
    if ts_s:
        try:
            head_ts = int(ts_s.strip().splitlines()[0])
        except ValueError:
            head_ts = 0
    return Clone(path=path, common_dir=common_dir, nwo=nwo, head_ts=head_ts)


def pick_clones(clones: list[Clone]) -> list[Clone]:
    """Prefer live checkouts; keep every distinct common-dir for SHA union."""
    by_common: dict[Path, list[Clone]] = {}
    for c in clones:
        by_common.setdefault(c.common_dir, []).append(c)
    picked: list[Clone] = []
    for group in by_common.values():
        group.sort(key=lambda c: (path_penalty(c.path), -c.head_ts, str(c.path)))
        picked.append(group[0])
    picked.sort(key=lambda c: (path_penalty(c.path), -c.head_ts, str(c.path)))
    return picked


def commit_times_local(clone: Clone, since_unix: int) -> dict[str, int]:
    """SHA → committer unix ts, local branches only, since since_unix."""
    since = datetime.fromtimestamp(since_unix, tz=timezone.utc).strftime(
        "%Y-%m-%dT%H:%M:%SZ"
    )
    out = git_ok(
        clone.path,
        "log",
        "--branches",
        f"--since={since}",
        "--pretty=format:%H%x09%ct",
        timeout=120,
    )
    if not out:
        return {}
    times: dict[str, int] = {}
    for line in out.splitlines():
        line = line.strip()
        if not line or "\t" not in line:
            continue
        sha, ts_s = line.split("\t", 1)
        if len(sha) < 40:
            continue
        try:
            ts = int(ts_s)
        except ValueError:
            continue
        prev = times.get(sha)
        if prev is None or ts > prev:
            times[sha] = ts
    return times


def parse_pushed_at(s: str | None) -> int | None:
    if not s:
        return None
    try:
        # 2026-08-25T05:10:33Z
        dt = datetime.fromisoformat(s.replace("Z", "+00:00"))
        return int(dt.timestamp())
    except ValueError:
        return None


def commit_times_github(nwo: str, since_unix: int, pushed_at: str | None) -> dict[str, int]:
    """Default-branch commits via gh. Cached per nwo+pushedAt+since."""
    cpath = cache_dir() / "github-commits" / (nwo.replace("/", "__") + ".json")
    cached = load_json(cpath)
    if (
        isinstance(cached, dict)
        and cached.get("nwo") == nwo
        and cached.get("pushed_at") == pushed_at
        and cached.get("since") == since_unix
        and isinstance(cached.get("times"), dict)
    ):
        return {str(k): int(v) for k, v in cached["times"].items()}
    since = datetime.fromtimestamp(since_unix, tz=timezone.utc).strftime(
        "%Y-%m-%dT%H:%M:%SZ"
    )
    try:
        r = subprocess.run(
            [
                "gh",
                "api",
                "--paginate",
                f"repos/{nwo}/commits?since={since}&per_page=100",
                "--jq",
                ".[] | [.sha, .commit.committer.date] | @tsv",
            ],
            capture_output=True,
            text=True,
            timeout=180,
        )
    except (subprocess.TimeoutExpired, OSError):
        return {}
    if r.returncode != 0:
        return {}
    times: dict[str, int] = {}
    for line in r.stdout.splitlines():
        line = line.strip()
        if not line or "\t" not in line:
            continue
        sha, date_s = line.split("\t", 1)
        ts = parse_pushed_at(date_s)
        if ts is None:
            continue
        times[sha] = ts
    atomic_write_json(
        cpath,
        {"nwo": nwo, "pushed_at": pushed_at, "since": since_unix, "times": times},
    )
    return times


def ema_score(timestamps: Iterable[int], now: float, half_life: float) -> float:
    """Continuous exponential filter of a point process; units commits/day."""
    if half_life <= 0:
        return 0.0
    kappa = math.log(2.0) / half_life
    acc = 0.0
    for ts in timestamps:
        age_days = (now - ts) / 86400.0
        if age_days < 0:
            age_days = 0.0
        acc += math.exp(-kappa * age_days)
    return kappa * acc


def count_since(timestamps: Iterable[int], now: float, days: float) -> int:
    cutoff = now - days * 86400.0
    return sum(1 for ts in timestamps if ts >= cutoff)


def bar(score: float, max_score: float, width: int = BAR_WIDTH) -> str:
    if max_score <= 0 or score <= 0:
        return " " * width
    frac = min(score / max_score, 1.0)
    n = int(round(frac * width))
    n = max(1, n) if score > 0 else 0
    return "█" * n + " " * (width - n)


def iso_local(ts: int | None) -> str:
    if not ts:
        return "—"
    return time.strftime("%Y-%m-%d", time.localtime(ts))


def discover_local_only(src: Path, clones: list[Clone], owners: set[str]) -> list[Clone]:
    """Top-level no-remote (or foreign-remote) git repos under src."""
    extra: list[Clone] = []
    try:
        kids = list(src.iterdir())
    except OSError:
        return extra
    owner_clones = {c.path.resolve() for c in clones if c.nwo and c.nwo.split("/")[0] in owners}
    for kid in kids:
        if not kid.is_dir():
            continue
        if kid.name in SKIP_WALK_NAMES or kid.name.startswith("."):
            continue
        git_entry = kid / ".git"
        if not git_entry.exists():
            continue
        if kid.resolve() in owner_clones:
            continue
        info = inspect_clone(kid)
        if info is None:
            continue
        # Only true local-only trees (no GitHub remote). A clone of someone
        # else's repo sitting under ~/src is not an extra in this catalog.
        if info.nwo is not None:
            continue
        extra.append(info)
    return extra


def self_test() -> int:
    now = float(int(time.time()))
    hl = 7.0
    kappa = math.log(2.0) / hl
    s0 = ema_score([int(now)], now, hl)
    s_hl = ema_score([int(now - hl * 86400.0)], now, hl)
    s2 = ema_score([int(now), int(now)], now, hl)
    # two identical timestamps: the dict-union case is unique SHAs, but the
    # scorer sums the iterable as given, so two entries → 2κ.
    ok = True
    checks = [
        ("t=0 → κ", abs(s0 - kappa) < 1e-9, s0, kappa),
        ("t=hl → κ/2", abs(s_hl - kappa / 2.0) < 1e-6, s_hl, kappa / 2.0),
        ("two at t=0 → 2κ", abs(s2 - 2 * kappa) < 1e-9, s2, 2 * kappa),
        ("empty → 0", ema_score([], now, hl) == 0.0, ema_score([], now, hl), 0.0),
    ]
    for name, passed, got, want in checks:
        mark = "ok" if passed else "FAIL"
        print(f"  {mark:4}  {name:22}  got={got:.8f}  want={want:.8f}")
        ok = ok and passed
    nwo_cases = [
        ("https://github.com/v2-io/arch.git", "v2-io/arch"),
        ("git@github.com:josephwecker/ops.git", "josephwecker/ops"),
        ("https://github.com/v2-io/v2.io.git", "v2-io/v2.io"),
        ("git@github.com:v2-io/.github.git", "v2-io/.github"),
        ("https://github.com/josephwecker/josephwecker.github.io", "josephwecker/josephwecker.github.io"),
    ]
    url_ok = True
    for raw, want in nwo_cases:
        got = nwo_from_url(raw)
        passed = got == want
        print(f"  {'ok' if passed else 'FAIL':4}  nwo {raw} → {got!r} (want {want!r})")
        url_ok = url_ok and passed
    ok = ok and url_ok
    return 0 if ok else 1


def score_repo(
    *,
    ident: str,
    clones: list[Clone],
    gh: GhRepo | None,
    now: float,
    since_unix: int,
    half_life: float,
    want_github: bool,
) -> Scored:
    times: dict[str, int] = {}
    source = "none"
    local_paths = [home_tilde(c.path) for c in clones]
    if clones:
        for c in clones:
            times.update(commit_times_local(c, since_unix))
        source = "local"
    elif (
        want_github
        and gh is not None
        and not gh.fork
        and parse_pushed_at(gh.pushed_at) is not None
        and parse_pushed_at(gh.pushed_at) >= since_unix
    ):
        times = commit_times_github(gh.nwo, since_unix, gh.pushed_at)
        source = "github" if times else "none"
    last_ts: int | None = max(times.values()) if times else None
    last_kind = "commit" if last_ts is not None else "none"
    if last_ts is None and clones:
        head = max((c.head_ts for c in clones), default=0)
        if head:
            last_ts = head
            last_kind = "commit"
    if last_ts is None and gh is not None:
        last_ts = parse_pushed_at(gh.pushed_at)
        if last_ts is not None:
            last_kind = "pushed"
    score = ema_score(times.values(), now, half_life)
    return Scored(
        id=ident,
        score=score,
        n_window=len(times),
        n_7d=count_since(times.values(), now, 7.0),
        last_ts=last_ts,
        last_kind=last_kind,
        local_paths=local_paths,
        source=source,
        private=bool(gh.private) if gh else True,
        fork=bool(gh.fork) if gh else False,
        archived=bool(gh.archived) if gh else False,
    )


def render_text(
    rows: list[Scored],
    *,
    half_life: float,
    now: float,
    catalog_note: str,
    n_gh: int,
    n_local_only: int,
    n_clones: int,
    window_days: float,
    top: int,
    min_heat: float,
    show_zeros: bool,
) -> str:
    kappa = math.log(2.0) / half_life
    shown = [r for r in rows if r.score >= min_heat]
    if not show_zeros:
        shown = [r for r in shown if r.score > 0.0]
    if top > 0:
        shown = shown[:top]
    max_score = max((r.score for r in shown), default=0.0)
    now_s = time.strftime("%Y-%m-%d %H:%M:%S %z", time.localtime(now))
    lines: list[str] = []
    lines.append(
        f"# repo-heat  half-life={half_life:g}d  κ={kappa:.5f}  "
        f"window={window_days:g}d  now={now_s}"
    )
    lines.append(
        f"# score = κ · Σ 2^(-age_days / {half_life:g})   [commits/day]; "
        f"1/day forever → 1.0"
    )
    lines.append(
        f"# catalog={catalog_note}  gh_repos={n_gh}  "
        f"local_only={n_local_only}  clone_common_dirs={n_clones}"
    )
    lines.append(
        f"# {'SCORE':>8}  {'HEAT':<{BAR_WIDTH}}  {'7d':>4}  "
        f"{'LAST':<10}  REPO"
    )
    n_hidden_zero = sum(1 for r in rows if r.score <= 0.0)
    for r in shown:
        flags = []
        if r.fork:
            flags.append("fork")
        if r.archived:
            flags.append("archived")
        if r.private:
            flags.append("private")
        if r.id.startswith("local/"):
            flags.append("local-only")
        if r.source == "github":
            flags.append("gh")
        if r.source == "none" and not r.local_paths:
            flags.append("no-local")
        flag_s = f"  [{', '.join(flags)}]" if flags else ""
        loc = r.local_paths[0] if r.local_paths else ""
        if len(r.local_paths) > 1:
            loc += f"  +{len(r.local_paths) - 1}"
        last = iso_local(r.last_ts)
        if r.last_kind == "pushed":
            last = "~" + last
        loc_s = f"  {loc}" if loc else ""
        lines.append(
            f"{r.score:8.3f}  {bar(r.score, max_score):<{BAR_WIDTH}}  "
            f"{r.n_7d:4d}  {last:<10}  {r.id}{flag_s}{loc_s}"
        )
    if not show_zeros and n_hidden_zero:
        lines.append(
            f"# {n_hidden_zero} repos at score 0 omitted "
            f"(pass --zeros to list; --deep to also search _ref/MOVED)"
        )
    return "\n".join(lines) + "\n"


def rows_json(rows: list[Scored], **meta: Any) -> dict[str, Any]:
    return {
        **meta,
        "repos": [
            {
                "id": r.id,
                "score": r.score,
                "commits_in_window": r.n_window,
                "commits_7d": r.n_7d,
                "last_ts": r.last_ts,
                "last_kind": r.last_kind,
                "local": r.local_paths,
                "source": r.source,
                "private": r.private,
                "fork": r.fork,
                "archived": r.archived,
            }
            for r in rows
        ],
    }


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="repo-heat",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=(
            "Heatmap of josephwecker + v2-io GitHub repos (and local-only extras)\n"
            "by exponentially-weighted commits/day."
        ),
        epilog=(
            "Heat model\n"
            "  Not git-heat: git-heat ages in *commits behind HEAD* inside one repo.\n"
            "  repo-heat ages in *days* across repos.\n"
            "  κ = ln(2)/half_life; score = κ Σ exp(-κ · age_days). Units: commits/day.\n"
            "  A commit one half-life ago weighs half of one right now.\n"
            "\n"
            "Clones under --src are mapped by origin URL. Multiple worktrees that\n"
            "share a git-common-dir are counted once (SHAs unioned across remaining\n"
            "distinct object stores). Local-only: --local PATH, plus top-level\n"
            "no-remote repos under --src unless --no-discover-local.\n"
            "\n"
            "LAST dates prefixed with ~ are GitHub pushedAt, not a commit timestamp.\n"
        ),
    )
    p.add_argument(
        "--owners",
        default=",".join(DEFAULT_OWNERS),
        help=f"comma-separated gh owners (default: {','.join(DEFAULT_OWNERS)})",
    )
    p.add_argument(
        "--src",
        default=str(Path.home() / "src"),
        help="root to scan for local clones (default: ~/src)",
    )
    p.add_argument(
        "--local",
        action="append",
        default=[],
        metavar="PATH",
        help="extra local-only repo (repeatable). top-level no-remote repos under --src are included automatically",
    )
    p.add_argument(
        "--no-discover-local",
        action="store_true",
        help="do not auto-include top-level no-remote git repos under --src",
    )
    p.add_argument(
        "--half-life",
        type=float,
        default=DEFAULT_HALF_LIFE,
        metavar="DAYS",
        help=f"EMA half-life in days (default: {DEFAULT_HALF_LIFE:g})",
    )
    p.add_argument(
        "--window",
        type=float,
        default=None,
        metavar="DAYS",
        help=f"only consider commits this recent (default: {WINDOW_HALFLIVES:g} × half-life)",
    )
    p.add_argument("--top", type=int, default=0, help="show only the hottest N (0 = all)")
    p.add_argument(
        "--min-heat",
        type=float,
        default=0.0,
        help="hide repos below this score (default: 0; zeros still hidden unless --zeros)",
    )
    p.add_argument(
        "--zeros",
        action="store_true",
        help="include repos with score 0 (cold catalog entries)",
    )
    p.add_argument(
        "--forks",
        action="store_true",
        help="include forks (default: omit; their history is mostly upstream)",
    )
    p.add_argument(
        "--archived",
        action="store_true",
        help="include archived repos (default: omit)",
    )
    p.add_argument(
        "--deep",
        action="store_true",
        help="also walk _ref, MOVED, and other archive-ish trees under --src",
    )
    p.add_argument(
        "--refresh",
        action="store_true",
        help="ignore catalog / github-commit caches",
    )
    p.add_argument(
        "--clear-cache",
        action="store_true",
        help="delete ~/.cache/repo-heat and exit",
    )
    p.add_argument(
        "--format",
        choices=("text", "json", "tsv"),
        default="text",
        help="output format (default: text)",
    )
    p.add_argument(
        "--self-test",
        action="store_true",
        help="run the EMA identity checks and exit",
    )
    p.add_argument("-V", "--version", action="version", version="repo-heat 0.1.0")
    args = p.parse_args(argv)

    if args.self_test:
        return self_test()
    if args.clear_cache:
        cdir = cache_dir()
        if cdir.exists():
            import shutil

            shutil.rmtree(cdir)
            print(f"cleared {cdir}", file=sys.stderr)
        else:
            print(f"no cache at {cdir}", file=sys.stderr)
        return 0

    if args.half_life <= 0:
        print("repo-heat: --half-life must be > 0", file=sys.stderr)
        return 2

    owners = [o.strip() for o in args.owners.split(",") if o.strip()]
    if not owners:
        print("repo-heat: --owners is empty", file=sys.stderr)
        return 2
    src = Path(args.src).expanduser()
    window_days = args.window if args.window is not None else WINDOW_HALFLIVES * args.half_life
    now = time.time()
    since_unix = int(now - window_days * 86400.0)

    gh_repos, catalog_note = fetch_catalog(owners, refresh=args.refresh)
    owner_set = {o.lower() for o in owners}

    walk_root = src
    found_paths = walk_git_repos(walk_root, deep=args.deep)
    clones_all: list[Clone] = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=16) as pool:
        futs = [pool.submit(inspect_clone, p) for p in found_paths]
        for fut in concurrent.futures.as_completed(futs):
            info = fut.result()
            if info is not None:
                clones_all.append(info)

    by_nwo: dict[str, list[Clone]] = {}
    for c in clones_all:
        if c.nwo and c.nwo.split("/")[0] in owner_set:
            by_nwo.setdefault(c.nwo, []).append(c)
    for nwo, group in list(by_nwo.items()):
        by_nwo[nwo] = pick_clones(group)

    local_only: list[Clone] = []
    for raw in args.local:
        pth = Path(raw).expanduser()
        info = inspect_clone(pth)
        if info is None:
            print(f"repo-heat: --local {pth} is not a git work tree; skipping", file=sys.stderr)
            continue
        local_only.append(info)
    if not args.no_discover_local:
        discovered = discover_local_only(src, clones_all, owner_set)
        seen = {c.path.resolve() for c in local_only}
        for d in discovered:
            if d.path.resolve() not in seen:
                local_only.append(d)
                seen.add(d.path.resolve())

    # Score in parallel: each repo's git log is independent.
    jobs: list[tuple[str, list[Clone], GhRepo | None]] = []
    seen_ids: set[str] = set()
    for g in gh_repos:
        if g.fork and not args.forks:
            continue
        if g.archived and not args.archived:
            continue
        jobs.append((g.nwo, by_nwo.get(g.nwo, []), g))
        seen_ids.add(g.nwo)
    for c in local_only:
        ident = f"local/{c.path.name}"
        if ident in seen_ids:
            ident = f"local/{c.path}"
        jobs.append((ident, pick_clones([c]), None))
        seen_ids.add(ident)

    rows: list[Scored] = []

    def _run(job: tuple[str, list[Clone], GhRepo | None]) -> Scored:
        ident, clones, gh = job
        return score_repo(
            ident=ident,
            clones=clones,
            gh=gh,
            now=now,
            since_unix=since_unix,
            half_life=args.half_life,
            want_github=True,
        )

    with concurrent.futures.ThreadPoolExecutor(max_workers=16) as pool:
        futs = [pool.submit(_run, j) for j in jobs]
        for fut in concurrent.futures.as_completed(futs):
            rows.append(fut.result())

    rows.sort(key=lambda r: (-r.score, r.id))

    n_clone_dirs = len({c.common_dir for cs in by_nwo.values() for c in cs})
    if args.format == "json":
        payload = rows_json(
            rows if args.zeros else [r for r in rows if r.score > 0],
            half_life_days=args.half_life,
            kappa=math.log(2.0) / args.half_life,
            window_days=window_days,
            now=now,
            catalog=catalog_note,
            gh_repos=len(gh_repos),
            local_only=len(local_only),
            clone_common_dirs=n_clone_dirs,
        )
        if args.top > 0:
            payload["repos"] = payload["repos"][: args.top]
        json.dump(payload, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0
    if args.format == "tsv":
        print("score\t7d\tlast\tlast_kind\tid\tsource\tlocal")
        shown = rows
        if not args.zeros:
            shown = [r for r in shown if r.score > 0]
        if args.top > 0:
            shown = shown[: args.top]
        for r in shown:
            print(
                f"{r.score:.6f}\t{r.n_7d}\t{iso_local(r.last_ts)}\t{r.last_kind}\t"
                f"{r.id}\t{r.source}\t{r.local_paths[0] if r.local_paths else ''}"
            )
        return 0

    sys.stdout.write(
        render_text(
            rows,
            half_life=args.half_life,
            now=now,
            catalog_note=catalog_note,
            n_gh=len(gh_repos),
            n_local_only=len(local_only),
            n_clones=n_clone_dirs,
            window_days=window_days,
            top=args.top,
            min_heat=args.min_heat,
            show_zeros=args.zeros,
        )
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\nrepo-heat: interrupted", file=sys.stderr)
        raise SystemExit(130)
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        raise SystemExit(0)
