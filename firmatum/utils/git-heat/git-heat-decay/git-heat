def _densify_palette(
    anchors: list[tuple[int, int, int]], steps_per_segment: int = 8
) -> list[tuple[int, int, int]]:
    if len(anchors) < 2:
        return list(anchors)
    out: list[tuple[int, int, int]] = []
    for i in range(len(anchors) - 1):
        c0, c1 = anchors[i], anchors[i + 1]
        for s in range(steps_per_segment):
            u = s / steps_per_segment
            out.append(
                (
                    int(round(c0[0] + (c1[0] - c0[0]) * u)),
                    int(round(c0[1] + (c1[1] - c0[1]) * u)),
                    int(round(c0[2] + (c1[2] - c0[2]) * u)),
                )
            )
    out.append(anchors[-1])
    return out


HEAT_PALETTE_RGB: list[tuple[int, int, int]] = _densify_palette(
    _HEAT_ANCHORS_RGB, steps_per_segment=8
)


def fmt_age(now: float, mtime: float) -> str:
    if mtime <= 0:
        return "never*"  # only initial commit (or unknown)
    days = (now - mtime) / 86400.0
    if days < 1:
        hours = days * 24
        if hours < 1:
            return f"{int(days * 86400 // 60)}m ago"
        return f"{hours:.0f}h ago"
    if days < 14:
        return f"{days:.1f}d ago"
    return f"{days / 7:.1f}w ago"


def tree_to_jsonable(node: dict[str, Any], now: float) -> dict[str, Any]:
    kids = children_sorted(node) if node.get("children") else []
    out: dict[str, Any] = {
        "name": node["name"],
        "path": node["path"],
        "is_dir": node["is_dir"],
        "heat": node["heat"],
        "mtime": node["mtime"],
        "age": fmt_age(now, node["mtime"]),
        "noise": bool(node.get("noise")),
        "children": [tree_to_jsonable(c, now) for c in kids] if kids else [],
    }
    if not node["is_dir"]:
        out["ages"] = list(node.get("ages") or [])
    return out


def render_html(
