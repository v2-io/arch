# Predictable churn that drowns signal — shown as heat-0 (#222) and excluded
# from parent directory max-heat rollup (and from color-scale heat_max).
# Mutable so --noise can extend for a single run without rebinding the name.
DEFAULT_NOISE_BASENAMES: frozenset[str] = frozenset({"Cargo.toml", "SOURCE_REV"})
NOISE_BASENAMES: set[str] = set(DEFAULT_NOISE_BASENAMES)


def is_noise_path(path: str) -> bool:
    return Path(path).name in NOISE_BASENAMES


def set_noise_basenames(names: set[str] | frozenset[str]) -> None:
    NOISE_BASENAMES.clear()
    NOISE_BASENAMES.update(names)


def git_commit_touch_log(repo: Path) -> list[tuple[str, float, list[str]]]:
    """Oldest→newest commits: (hash, unix_ts, paths). Paths via ACMR filter."""
    cmd = [
        "git",
        "-C",
        str(repo),
        "log",
        "--reverse",
        "--pretty=format:%H %ct",
        "--name-only",
        "--diff-filter=ACMR",
    ]
    out = subprocess.check_output(cmd, text=True, errors="replace")
    commits: list[tuple[str, float, list[str]]] = []
    cur_hash: str | None = None
    cur_ts: float | None = None
    cur_paths: list[str] = []

    def flush() -> None:
        nonlocal cur_hash, cur_ts, cur_paths
        if cur_hash is not None and cur_ts is not None:
            commits.append((cur_hash, cur_ts, cur_paths))
        cur_hash, cur_ts, cur_paths = None, None, []

    for line in out.splitlines():
        line = line.strip()
        if not line:
            continue
        # commit header: "<40hex> <unix_ts>"
        parts = line.split()
        if (
            len(parts) == 2
            and len(parts[0]) == 40
            and all(c in "0123456789abcdef" for c in parts[0])
            and parts[1].isdigit()
        ):
            flush()
            cur_hash = parts[0]
            cur_ts = float(parts[1])
            cur_paths = []
            continue
        if cur_hash is None:
            continue
        # path line (skip commit subject noise)
        if "/" not in line and "." not in line and " " in line:
            continue
        cur_paths.append(line)
    flush()
    return commits


def leaf_touch_data(
    commits: list[tuple[str, float, list[str]]],
) -> tuple[dict[str, list[int]], dict[str, float], int, int]:
    """Build per-path commit ages (excluding initial) and last-touch mtime.

    Returns (ages_by_path, mtime_by_path, n_commits, n_non_initial_touches).
    age = commits behind HEAD (0 = HEAD). Initial commit contributes no ages.
    Paths only in the initial commit still appear with ages=[] and mtime=0.
    """
    if not commits:
        return {}, {}, 0, 0

    n = len(commits)
    ages: dict[str, list[int]] = defaultdict(list)
    mtime: dict[str, float] = {}
    n_touches = 0

    for idx, (_h, ts, paths) in enumerate(commits):
        is_initial = idx == 0
        age = (n - 1) - idx  # HEAD → 0
        for path in paths:
            if is_initial:
                # inventory only — no heat contribution
                if path not in ages:
                    ages[path] = []
                mtime.setdefault(path, 0.0)
                continue
            ages[path].append(age)
            n_touches += 1
            prev = mtime.get(path, 0.0)
            if ts > prev:
                mtime[path] = ts

    return dict(ages), mtime, n, n_touches


def heat_from_ages(ages: list[int], tau: float) -> float:
    """Scale-invariant heat: every-commit forever → 2 at any τ.

    raw = Σ exp(-age/τ) grows like ~τ for frequent touches; multiply by
    2·(1 − e^{−1/τ}) so the infinite geometric sum normalizes to 2
    (the natural steady state when half_life=1, where e^{−1/τ}=1/2).
    """
    if not ages or tau <= 0:
        return 0.0
    raw = sum(math.exp(-a / tau) for a in ages)
    # per-step decay factor; avoid underflow/cancellation for tiny tau
    r = math.exp(-1.0 / tau)
    scale = 2.0 * (1.0 - r)  # → 2/S(τ); S = 1/(1-r)
    return scale * raw


def compute_leaf_heat(
    ages_by_path: dict[str, list[int]], half_life: float
) -> dict[str, float]:
    tau = half_life / math.log(2)
    out: dict[str, float] = {}
    for p, ages in ages_by_path.items():
        if is_noise_path(p):
            out[p] = 0.0
        else:
            out[p] = heat_from_ages(ages, tau)
    return out


def build_tree(
    ages_by_path: dict[str, list[int]],
    mtime_by_path: dict[str, float],
    heat_by_path: dict[str, float],
) -> dict[str, Any]:
    """Nested tree; leaves carry ages[] for client-side recompute."""
    root: dict[str, Any] = {
        "name": ".",
        "path": "",
        "is_dir": True,
        "heat": 0.0,
        "mtime": 0.0,
        "ages": None,
        "noise": False,
        "children": {},
    }

    for path, ages in ages_by_path.items():
        noise = is_noise_path(path)
        h = 0.0 if noise else heat_by_path.get(path, 0.0)
        mt = mtime_by_path.get(path, 0.0)
        parts = Path(path).parts
        node = root
        for i, part in enumerate(parts):
            is_last = i == len(parts) - 1
            kids = node["children"]
            if part not in kids:
                kids[part] = {
                    "name": part,
                    "path": "/".join(parts[: i + 1]),
                    "is_dir": not is_last,
                    "heat": 0.0,
                    "mtime": 0.0,
                    "ages": None,
                    "noise": False,
                    "children": {} if not is_last else None,
                }
            child = kids[part]
            if is_last:
                child["is_dir"] = False
                child["heat"] = h
                child["mtime"] = mt
                child["ages"] = list(ages)
                child["noise"] = noise
                child["children"] = None
            else:
                child["is_dir"] = True
                if child["children"] is None:
                    child["children"] = {}
            node = child

    def finalize(node: dict[str, Any]) -> tuple[float, float]:
        kids = node.get("children")
        if not kids:
            # leaves: heat already 0 for noise; return 0 contrib for parent max
            if node.get("noise"):
                return 0.0, node["mtime"]
            return node["heat"], node["mtime"]
        max_h = 0.0
        max_mt = 0.0
        for child in kids.values():
            ch, cmt = finalize(child)
            # ch is already 0 for noise leaves / subtrees that only contain noise
            if ch > max_h:
                max_h = ch
            if cmt > max_mt:
                max_mt = cmt
        node["heat"] = max_h
        node["mtime"] = max_mt
        return max_h, max_mt

    finalize(root)
    return root


def children_sorted(node: dict[str, Any]) -> list[dict[str, Any]]:
    kids = node.get("children") or {}
    items = list(kids.values())
    # folders first, then files; within each: mtime desc, name asc
    items.sort(key=lambda n: (0 if n["is_dir"] else 1, -n["mtime"], n["name"].lower()))
    return items


