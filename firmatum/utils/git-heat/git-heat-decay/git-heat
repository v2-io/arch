    border-bottom: 1px solid var(--grid-line);
    border-left: 1px solid var(--grid-line);
    padding: 0 0.65rem;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.45rem;
    overflow: hidden;
    cursor: default;
    user-select: none;
    font-family: var(--font-cell);
  }}
  .cell.file {{
    height: var(--row-h-file);
    min-height: var(--row-h-file);
    font-size: 1rem;
    font-weight: 600;
    border-right: 1px solid var(--grid-line);
    cursor: pointer;
  }}
  .cell.file.selected {{
    outline: 2px solid #f8fafc;
    outline-offset: -2px;
    z-index: 1;
    filter: brightness(1.12);
  }}
  .cell.dir {{
    height: var(--row-h-dir);
    min-height: var(--row-h-dir);
    font-size: 1.2rem;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.4s ease, filter 0.2s ease;
  }}
  .cell.dir.collapsed-dir {{ opacity: 0.5; }}
  .cell.dir.expanded-dir {{ opacity: 1; }}
  .cell:hover {{ filter: brightness(1.08); }}
  .cell .name {{
    font-size: inherit;
    font-weight: inherit;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    flex: 1 1 auto;
  }}
  .cell .meta-line {{
    font-size: 0.75em;
    font-weight: inherit;
    font-variant-numeric: tabular-nums;
    opacity: 0.9;
    white-space: nowrap;
    flex: 0 0 auto;
    margin-left: auto;
  }}
  /* Expand/collapse: animate grid-template-rows (works without measuring height) */
  .nest {{
    width: 100%;
    padding: 0;
    background: transparent;
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s ease;
  }}
  .cell-wrap.open > .nest {{
    grid-template-rows: 1fr;
  }}
  .nest > .grid {{
    width: 100%;
    border: none;
    min-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.35s ease;
  }}
  .cell-wrap.open > .nest > .grid {{
    opacity: 1;
  }}
  @media (prefers-reduced-motion: reduce) {{
    .nest,
    .nest > .grid,
    .cell.dir {{
      transition: none !important;
    }}
  }}
  .block-gap {{
    width: 100%;
    height: var(--block-gap);
    flex: 0 0 var(--block-gap);
    background: #000;
    border: none;
  }}
