<script>
(function () {{
  const PALETTE = {palette_js};
  const ZERO_BG = '{ZERO_HEAT_BG}';
  const MAX_VIEW_BYTES = 1.5 * 1024 * 1024;
  const payload = JSON.parse(document.getElementById('data').textContent);
  const meta = payload.meta;
  const tree = payload.tree;
  const choices = meta.half_life_choices;

  let halfLife = meta.half_life;
  let heatMax = 1;
  let selectedPath = null;
  let selectedCell = null;
  let loadSeq = 0;

  function tauFrom(hl) {{ return hl / Math.LN2; }}

  /** Scale-invariant heat: touched every commit forever -> 2 at any tau.
   *  raw = sum exp(-age/tau); scale by 2*(1 - exp(-1/tau)) so S(tau) cancels. */
  function heatFromAges(ages, tau) {{
    if (!ages || !ages.length || tau <= 0) return 0;
    let raw = 0;
    for (let i = 0; i < ages.length; i++) raw += Math.exp(-ages[i] / tau);
    const r = Math.exp(-1 / tau);
    return 2 * (1 - r) * raw;
  }}

  /** Recompute leaf heats from ages; roll max up dirs. Mutates tree.
   *  noise leaves (Cargo.toml, SOURCE_REV): always heat 0, excluded from parent max. */
  function recomputeTree(node, tau) {{
    if (!node.is_dir) {{
      if (node.noise) {{
        node.heat = 0;
        return 0; // do not contribute to parent directory heat
      }}
      node.heat = heatFromAges(node.ages || [], tau);
      return node.heat;
    }}
    let maxH = 0;
    const kids = node.children || [];
    for (let i = 0; i < kids.length; i++) {{
      const h = recomputeTree(kids[i], tau);
      if (h > maxH) maxH = h;
    }}
    node.heat = maxH;
    return maxH;
  }}

  function heatRGB(heat) {{
    if (heat <= 0 || heatMax <= 0) return null; // zero → special bg
    const t = Math.max(0, Math.min(1, heat / heatMax));
    const x = (1 - t) * (PALETTE.length - 1);
    if (x <= 0) return PALETTE[0].slice();
    if (x >= PALETTE.length - 1) return PALETTE[PALETTE.length - 1].slice();
    const i = Math.floor(x);
    const u = x - i;
    const c0 = PALETTE[i];
    const c1 = PALETTE[i + 1];
    return [
      Math.round(c0[0] + (c1[0] - c0[0]) * u),
      Math.round(c0[1] + (c1[1] - c0[1]) * u),
      Math.round(c0[2] + (c1[2] - c0[2]) * u),
    ];
  }}

  function textForBg(r, g, b) {{
    const lum = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
    if (lum > 0.45) return 'rgb(15, 23, 42)';
    const u = Math.max(0, Math.min(1, lum / 0.45));
    const alpha = 0.30 + (0.50 - 0.30) * u;
    return 'rgba(248, 250, 252, ' + alpha.toFixed(3) + ')';
  }}

  function applyHeatStyle(el, heat) {{
    const rgb = heatRGB(heat);
    if (!rgb) {{
      el.style.background = ZERO_BG;
      el.style.color = 'rgba(248, 250, 252, 0.35)';
      return;
    }}
    const [r, g, b] = rgb;
    el.style.background = 'rgb(' + r + ',' + g + ',' + b + ')';
    el.style.color = textForBg(r, g, b);
  }}

  function updateMeta() {{
    const tau = tauFrom(halfLife);
    const scopeBit = meta.scope ? (' · scope ' + meta.scope) : '';
    document.getElementById('meta').textContent =
      (meta.git_root || meta.repo) + scopeBit +
      ' · half-life ' + halfLife + ' commits (tau=' + tau.toFixed(2) +
      ') · ' + meta.n_commits + ' commits · ' + meta.n_files + ' paths · ' +
      meta.n_touches + ' non-initial touches (repo) · ' + meta.now;
    document.getElementById('hl-value').textContent =
      't1/2 = ' + halfLife + ' commit' + (halfLife === 1 ? '' : 's');
  }}

  const root = document.getElementById('root');
  const NEST_INDENT_REM = 3.5;
  const FILE_EXTRA_INDENT_REM = 0.55;
  const FILE_RIGHT_INSET = '8em';
  /** path → {{ cell, metaLine }} for in-place heat updates */
  const cellIndex = Object.create(null);

  function blockGap() {{
    const g = document.createElement('div');
    g.className = 'block-gap';
    g.setAttribute('aria-hidden', 'true');
    return g;
  }}

  function applyBarGeometry(cell, depth, isDir) {{
    const left = depth * NEST_INDENT_REM + (isDir ? 0 : FILE_EXTRA_INDENT_REM);
    cell.style.marginLeft = left + 'rem';
    if (isDir) {{
      cell.style.marginRight = '0';
      cell.style.width = 'calc(100% - ' + left + 'rem)';
    }} else {{
      cell.style.marginRight = FILE_RIGHT_INSET;
      cell.style.width = 'calc(100% - ' + left + 'rem - ' + FILE_RIGHT_INSET + ')';
    }}
  }}

  function setDirExpanded(cell, open) {{
    if (!cell || !cell.classList.contains('dir')) return;
    cell.classList.toggle('expanded-dir', open);
    cell.classList.toggle('collapsed-dir', !open);
  }}

  function appendChildren(grid, children, childDepth) {{
    let sawFile = false;
    for (const child of children) {{
      if (!child.is_dir && !sawFile) {{
        grid.appendChild(blockGap());
        sawFile = true;
      }}
      grid.appendChild(renderNode(child, childDepth));
    }}
    if (children.length) grid.appendChild(blockGap());
  }}

  const viewerPath = document.getElementById('viewer-path');
  const viewerMeta = document.getElementById('viewer-meta');
  const viewerEmpty = document.getElementById('viewer-empty');
  const viewerError = document.getElementById('viewer-error');
  const viewerCodeWrap = document.getElementById('viewer-code-wrap');
  const blameGutter = document.getElementById('blame-gutter');
  const viewerPre = document.getElementById('viewer-pre');
  const viewerCode = document.getElementById('viewer-code');

  const EXT_LANG = {{
    rs: 'rust', py: 'python', pyi: 'python', js: 'javascript', mjs: 'javascript',
    cjs: 'javascript', jsx: 'javascript', ts: 'typescript', tsx: 'typescript',
    json: 'json', jsonc: 'json', yaml: 'yaml', yml: 'yaml', toml: 'toml',
    md: 'markdown', markdown: 'markdown', sh: 'bash', bash: 'bash', zsh: 'bash',
    fish: 'bash', css: 'css', scss: 'css', html: 'xml', htm: 'xml', xml: 'xml',
    svg: 'xml', sql: 'sql', rb: 'ruby', go: 'go', java: 'java', c: 'c', h: 'c',
    cc: 'cpp', cpp: 'cpp', cxx: 'cpp', hpp: 'cpp', hh: 'cpp', dockerfile: 'dockerfile',
    mk: 'makefile', makefile: 'makefile', r: 'r', lua: 'lua', php: 'php',
    swift: 'swift', kt: 'kotlin', kts: 'kotlin', cs: 'csharp', fs: 'fsharp',
    ex: 'elixir', exs: 'elixir', erl: 'erlang', hs: 'haskell', ml: 'ocaml',
    vim: 'vim', diff: 'diff', patch: 'diff', proto: 'protobuf', graphql: 'graphql',
    conf: 'nginx', ini: 'ini', env: 'bash', txt: 'plaintext', log: 'plaintext',
  }};

  function langForPath(path) {{
    const base = path.split('/').pop() || path;
    const lower = base.toLowerCase();
    if (lower === 'dockerfile' || lower.startsWith('dockerfile.')) return 'dockerfile';
    if (lower === 'makefile' || lower === 'gnumakefile') return 'makefile';
    if (lower === 'cargo.lock') return 'toml';
    if (lower === 'cmakelists.txt') return 'cmake';
    const dot = lower.lastIndexOf('.');
    if (dot < 0) return null;
    return EXT_LANG[lower.slice(dot + 1)] || null;
  }}

  function looksBinary(bytes) {{
    const n = Math.min(bytes.length, 8000);
    let weird = 0;
    for (let i = 0; i < n; i++) {{
      const b = bytes[i];
      if (b === 0) return true;
      if (b < 7 || (b > 14 && b < 32 && b !== 9 && b !== 10 && b !== 13)) weird++;
    }}
    return weird / n > 0.3;
  }}

  function showViewerState(kind) {{
    viewerEmpty.hidden = kind !== 'empty';
    viewerError.hidden = kind !== 'error';
    viewerCodeWrap.hidden = kind !== 'code';
  }}

  function selectCell(cell) {{
    if (selectedCell) selectedCell.classList.remove('selected');
    selectedCell = cell;
    if (cell) cell.classList.add('selected');
  }}

  function textColorForRgb(r, g, b) {{
    // Same contrast rule as the tree heatmap: dark on yellow/green, light on blue/purple
    const lum = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
    if (lum > 0.45) return 'rgb(15, 23, 42)';
    const u = Math.max(0, Math.min(1, lum / 0.45));
    const alpha = 0.30 + (0.50 - 0.30) * u; // 70% → 50% transparent white
    return 'rgba(248, 250, 252, ' + alpha.toFixed(3) + ')';
  }}

  function renderLineGutter(nLines, blameLines) {{
    blameGutter.innerHTML = '';
    blameGutter.style.display = 'block';
    const digits = String(Math.max(nLines, 1)).length;
    blameGutter.style.setProperty('--blame-digits', String(digits));

    // Scale only over non-initial lines so root-commit blanks don't pin the cold end
    let ageMax = 1;
    if (blameLines && blameLines.length) {{
      ageMax = 0;
      for (let i = 0; i < blameLines.length; i++) {{
        if (blameLines[i].initial) continue;
        if (blameLines[i].age > ageMax) ageMax = blameLines[i].age;
      }}
      if (ageMax < 1) ageMax = 1;
    }}

    // Same blank as outline heat-0 cells (initial-only / never)
    const ZERO = ZERO_BG || '#222222';
    const frag = document.createDocumentFragment();
    for (let i = 0; i < nLines; i++) {{
      const L = (blameLines && blameLines[i]) || null;
      const el = document.createElement('div');
      el.className = 'bl';
      let r = 42, g = 47, b = 56; // soft viewer bg when no blame data
      let useZero = false;
      if (L) {{
        // Earliest (root) commit → blank, like heat 0 on the tree
        if (L.initial) {{
          useZero = true;
        }} else {{
          // Color scale among non-initial lines only (young = hot)
          const tHot = 1 - Math.max(0, Math.min(1, L.age / ageMax));
          const x = (1 - tHot) * (PALETTE.length - 1);
          if (x <= 0) {{ r = PALETTE[0][0]; g = PALETTE[0][1]; b = PALETTE[0][2]; }}
          else if (x >= PALETTE.length - 1) {{
            const c = PALETTE[PALETTE.length - 1];
            r = c[0]; g = c[1]; b = c[2];
          }} else {{
            const ii = Math.floor(x);
            const u = x - ii;
            const c0 = PALETTE[ii], c1 = PALETTE[ii + 1];
            r = Math.round(c0[0] + (c1[0] - c0[0]) * u);
            g = Math.round(c0[1] + (c1[1] - c0[1]) * u);
            b = Math.round(c0[2] + (c1[2] - c0[2]) * u);
          }}
        }}
        const short = (L.sha || '').slice(0, 8);
        const when = L.initial
          ? 'initial commit'
          : (L.age === 0 ? 'HEAD' : (L.age + ' commit' + (L.age === 1 ? '' : 's') + ' ago'));
        el.title =
          'L' + (i + 1) + ' · ' + short + ' · ' + when +
          (L.author ? ' · ' + L.author : '') +
          (L.summary ? ' · ' + L.summary : '') +
          (L.sha ? '\\n' + L.sha : '');
      }} else {{
        el.title = 'L' + (i + 1);
      }}
      if (useZero) {{
        el.style.background = ZERO;
        // parse #rrggbb for contrast
        const hx = ZERO.replace('#', '');
        r = parseInt(hx.slice(0, 2), 16);
        g = parseInt(hx.slice(2, 4), 16);
        b = parseInt(hx.slice(4, 6), 16);
      }} else {{
        el.style.background = 'rgb(' + r + ',' + g + ',' + b + ')';
      }}
      el.style.color = textColorForRgb(r, g, b);
      el.textContent = String(i + 1);
      frag.appendChild(el);
    }}
    blameGutter.appendChild(frag);
  }}

  async function fetchBlame(path) {{
    try {{
      const url = '/__git-heat__/blame?path=' + encodeURIComponent(path);
      const res = await fetch(url, {{ cache: 'no-cache' }});
      if (!res.ok) return null;
      return await res.json();
    }} catch (e) {{
      return null;
    }}
  }}

  async function openFile(path, node, cell) {{
    selectedPath = path;
    selectCell(cell);
    const heat = node ? node.heat : 0;
    const age = (node && node.age) || '—';
    viewerPath.textContent = path;
    viewerMeta.textContent = 'heat ' + heat.toFixed(3) + ' · ' + age + ' · loading…';
    showViewerState('empty');
    viewerEmpty.textContent = 'Loading ' + path + '…';
    blameGutter.innerHTML = '';
    viewerCodeWrap.scrollTop = 0;
    viewerCodeWrap.scrollLeft = 0;

    const seq = ++loadSeq;
    try {{
      if (location.protocol === 'file:') {{
        throw new Error(
          'Opened via file:// — browsers block reading repo files. ' +
          'Use: git-heat --serve'
        );
      }}
      const url = path.split('/').map(encodeURIComponent).join('/');
      const res = await fetch(url, {{ cache: 'no-cache' }});
      if (seq !== loadSeq) return;
      if (!res.ok) throw new Error('HTTP ' + res.status + ' for ' + path);
      const buf = await res.arrayBuffer();
      if (seq !== loadSeq) return;
      if (buf.byteLength > MAX_VIEW_BYTES) {{
        throw new Error(
          'File is ' + (buf.byteLength / 1024 / 1024).toFixed(1) +
          ' MiB (limit ' + (MAX_VIEW_BYTES / 1024 / 1024).toFixed(1) + ' MiB).'
        );
      }}
      const bytes = new Uint8Array(buf);
      if (looksBinary(bytes)) {{
        throw new Error('Binary file (not shown).');
      }}
      let text = new TextDecoder('utf-8', {{ fatal: false }}).decode(bytes);
      if (text.charCodeAt(0) === 0xFEFF) text = text.slice(1);

      const lang = langForPath(path);
      viewerCode.textContent = text;
      viewerCode.className = 'hljs' + (lang ? ' language-' + lang : '');
      if (window.hljs) {{
        try {{
          if (lang && hljs.getLanguage(lang)) {{
            viewerCode.innerHTML = hljs.highlight(text, {{ language: lang, ignoreIllegals: true }}).value;
          }} else {{
            viewerCode.innerHTML = hljs.highlightAuto(text).value;
          }}
        }} catch (err) {{
          viewerCode.textContent = text;
        }}
      }}
      showViewerState('code');
      viewerCodeWrap.scrollTop = 0;
      viewerCodeWrap.scrollLeft = 0;

      const nLines = text.length ? text.split('\\n').length : 0;
      let blameNote = '';
      const blame = await fetchBlame(path);
      if (seq !== loadSeq) return;
      let lines = null;
      if (blame && blame.lines && blame.lines.length) {{
        lines = blame.lines;
        if (lines.length < nLines) {{
          const last = lines[lines.length - 1] || {{ sha: '', age: 0, author: '', summary: '' }};
          while (lines.length < nLines) lines = lines.concat([Object.assign({{}}, last)]);
        }} else if (lines.length > nLines) {{
          lines = lines.slice(0, nLines);
        }}
        blameNote = ' · blame';
      }} else {{
        blameNote = ' · no blame (restart with git-heat --serve)';
      }}
      renderLineGutter(nLines, lines);
      viewerCodeWrap.scrollTop = 0;

      viewerMeta.textContent =
        'heat ' + heat.toFixed(3) + ' · ' + age +
        ' · ' + nLines + ' lines · ' +
        (lang || 'plain') +
        ' · ' + (buf.byteLength < 1024
          ? buf.byteLength + ' B'
          : (buf.byteLength / 1024).toFixed(1) + ' KiB') +
        blameNote;
    }} catch (err) {{
      if (seq !== loadSeq) return;
      showViewerState('error');
      viewerError.textContent = String(err && err.message ? err.message : err);
      viewerMeta.textContent = 'heat ' + heat.toFixed(3) + ' · ' + age + ' · failed';
    }}
  }}

  function renderNode(node, depth) {{
    depth = depth || 0;
    const wrap = document.createElement('div');
    wrap.className = 'cell-wrap';

    const cell = document.createElement('div');
    const isDir = !!node.is_dir;
    cell.className = 'cell ' + (isDir ? 'dir' : 'file');
    applyHeatStyle(cell, node.heat);
    applyBarGeometry(cell, depth, isDir);
    const pathKey = node.path || '.';
    cell.dataset.path = pathKey;
    cell.title = pathKey + ' · heat ' + node.heat.toFixed(3) + ' · ' + (node.age || '—');

    const hasKids = isDir && node.children && node.children.length;

    const name = document.createElement('span');
    name.className = 'name';
    name.textContent = isDir
      ? (node.path ? node.name + '/' : './')
      : node.name;

    const metaLine = document.createElement('span');
    metaLine.className = 'meta-line';
    metaLine.textContent = node.heat.toFixed(2) + ' · ' + (node.age || '—');

    cell.appendChild(name);
    cell.appendChild(metaLine);
    wrap.appendChild(cell);
    cellIndex[pathKey] = {{ cell: cell, metaLine: metaLine, node: node }};

    if (hasKids) {{
      setDirExpanded(cell, false);
      const nest = document.createElement('div');
      nest.className = 'nest';
      const grid = document.createElement('div');
      grid.className = 'grid';
      appendChildren(grid, node.children, depth + 1);
      nest.appendChild(grid);
      wrap.appendChild(nest);

      cell.addEventListener('click', function (e) {{
        e.stopPropagation();
        const willOpen = !wrap.classList.contains('open');
        wrap.classList.toggle('open', willOpen);
        setDirExpanded(cell, willOpen);
      }});
    }} else if (isDir) {{
      setDirExpanded(cell, false);
    }} else {{
      cell.addEventListener('click', function (e) {{
        e.stopPropagation();
        openFile(pathKey, node, cell);
      }});
    }}
    return wrap;
  }}

  function refreshHeats() {{
    const tau = tauFrom(halfLife);
    heatMax = Math.max(recomputeTree(tree, tau), 0);
    // walk all indexed cells
    for (const key of Object.keys(cellIndex)) {{
      const entry = cellIndex[key];
      const h = entry.node.heat;
      applyHeatStyle(entry.cell, h);
      const age = entry.node.age || '—';
      entry.metaLine.textContent = h.toFixed(2) + ' · ' + age;
      entry.cell.title = key + ' · heat ' + h.toFixed(3) + ' · ' + age;
    }}
    // keep viewer heat in sync if a file is open
    if (selectedPath && cellIndex[selectedPath]) {{
      const n = cellIndex[selectedPath].node;
      const cur = viewerMeta.textContent || '';
      const rest = cur.includes(' · ') ? cur.split(' · ').slice(2).join(' · ') : '';
      viewerMeta.textContent =
        'heat ' + n.heat.toFixed(3) + ' · ' + (n.age || '—') +
        (rest ? ' · ' + rest : '');
    }}
    updateMeta();
  }}

  // initial compute + paint
  recomputeTree(tree, tauFrom(halfLife));
  heatMax = Math.max(tree.heat, 0);
  if (tree.children && tree.children.length) {{
    appendChildren(root, tree.children, 0);
  }} else {{
    root.appendChild(renderNode(tree, 0));
  }}
  updateMeta();

  const slider = document.getElementById('hl-slider');
  slider.addEventListener('input', function () {{
    halfLife = choices[parseInt(slider.value, 10)];
    refreshHeats();
  }});

  function setOpen(wrap, open) {{
    const nest = wrap.querySelector(':scope > .nest');
    const cell = wrap.querySelector(':scope > .cell.dir');
    if (!nest) return;
    wrap.classList.toggle('open', open);
    setDirExpanded(cell, open);
  }}

  document.getElementById('collapse-all').addEventListener('click', function () {{
    document.querySelectorAll('.cell-wrap').forEach(function (w) {{ setOpen(w, false); }});
  }});
  document.getElementById('expand-1').addEventListener('click', function () {{
    document.querySelectorAll('#root > .cell-wrap').forEach(function (w) {{ setOpen(w, true); }});
  }});
  document.getElementById('expand-all').addEventListener('click', function () {{
    document.querySelectorAll('.cell-wrap').forEach(function (w) {{ setOpen(w, true); }});
  }});
}})();
</script>
</body>
</html>
"""


def find_git_root(path: Path) -> Path | None:
    """Nearest git toplevel for path (file or directory)."""
    probe = path if path.is_dir() else path.parent
    try:
        out = subprocess.check_output(
            ["git", "-C", str(probe), "rev-parse", "--show-toplevel"],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
        return Path(out).resolve()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None


def resolve_target(path: Path) -> tuple[Path, Path, str]:
    """Map a user path to (git_root, scope_dir, scope_prefix).

    scope_prefix is '' at repo root, or 'crates/foo/' for a subdirectory.
    Paths in the heat map are relative to scope_dir so the HTML file viewer
    can fetch them when served from that directory.
    """
    path = path.expanduser().resolve()
    if not path.exists():
        raise FileNotFoundError(f"path does not exist: {path}")
    scope_dir = path if path.is_dir() else path.parent
    root = find_git_root(scope_dir)
    if root is None:
        raise RuntimeError(f"not inside a git repository: {path}")
    try:
        rel = scope_dir.relative_to(root)
    except ValueError as e:
        raise RuntimeError(f"{scope_dir} is not under git root {root}") from e
    if rel == Path("."):
        return root, scope_dir, ""
    prefix = str(rel).replace("\\", "/") + "/"
    return root, scope_dir, prefix


def filter_scope(
    ages_by_path: dict[str, list[int]],
    mtime_by_path: dict[str, float],
    scope_prefix: str,
) -> tuple[dict[str, list[int]], dict[str, float]]:
    """Keep paths under scope_prefix; rewrite keys relative to that prefix."""
    if not scope_prefix:
        return ages_by_path, mtime_by_path
    ages: dict[str, list[int]] = {}
    mtime: dict[str, float] = {}
    for path, a in ages_by_path.items():
        if not path.startswith(scope_prefix):
            continue
        rel = path[len(scope_prefix) :]
        if not rel or rel.endswith("/"):
            continue
        ages[rel] = a
        mtime[rel] = mtime_by_path.get(path, 0.0)
    return ages, mtime


def commit_age_map(git_root: Path) -> dict[str, int]:
    """sha -> commits behind HEAD (0 = HEAD)."""
    out = subprocess.check_output(
        ["git", "-C", str(git_root), "rev-list", "HEAD"],
        text=True,
        errors="replace",
    )
    return {h: i for i, h in enumerate(out.splitlines()) if h}


def git_blame_lines(
    git_root: Path, repo_rel_path: str, ages: dict[str, int] | None = None
) -> list[dict[str, Any]]:
    """Per-line blame metadata for repo_rel_path (path relative to git root).

    Lines last touched only by the repository's earliest (root) commit are
    flagged initial=True — same treatment as heat-0 in the outline heatmap.
    """
    if ages is None:
        ages = commit_age_map(git_root)
    # Root commit = oldest = largest age (or sole commit at age 0 if only one)
    root_age = max(ages.values()) if ages else 0
    root_shas = {h for h, a in ages.items() if a == root_age}
    cmd = [
        "git",
        "-C",
        str(git_root),
        "blame",
        "--line-porcelain",
        "-w",
        "HEAD",
        "--",
        repo_rel_path,
    ]
    try:
        raw = subprocess.check_output(cmd, text=True, errors="replace", stderr=subprocess.DEVNULL)
    except subprocess.CalledProcessError:
        return []

    lines: list[dict[str, Any]] = []
    cur_sha = ""
    cur_author = ""
    cur_summary = ""
    cur_time = 0
    for line in raw.splitlines():
        if not line:
            continue
        if line.startswith("\t"):
            sha = cur_sha
            age = ages.get(sha, ages.get(sha[:40], 10**9))
            is_initial = sha in root_shas or age == root_age
            lines.append(
                {
                    "sha": sha,
                    "age": age,
                    "initial": is_initial,
                    "author": cur_author,
                    "summary": cur_summary,
                    "time": cur_time,
                }
            )
            continue
        if len(line) >= 40 and all(c in "0123456789abcdef" for c in line[:40]):
            # header: sha orig final [num]
            parts = line.split()
            cur_sha = parts[0]
            continue
        if line.startswith("author "):
            cur_author = line[7:]
        elif line.startswith("author-time "):
            try:
                cur_time = int(line[12:])
            except ValueError:
                cur_time = 0
        elif line.startswith("summary "):
            cur_summary = line[8:]
    return lines


def make_git_heat_handler(
    serve_dir: Path,
    git_root: Path,
    scope_prefix: str,
    *,
    html_doc: str | None = None,
    html_route: str = "git-heat.html",
) -> type:
    """HTTP handler: static files from serve_dir, in-memory heatmap, blame API.

    If html_doc is set, GET / and GET /html_route serve that document from
    memory (no write required). Source files still come from serve_dir so the
    viewer can fetch them; blame is at /__git-heat__/blame.
    """
    import http.server
    import urllib.parse

    ages_cache: dict[str, int] | None = None
    html_bytes = html_doc.encode("utf-8") if html_doc is not None else None
    html_names = {"", "/", "/index.html", "/" + html_route.lstrip("/")}

    class GitHeatHandler(http.server.SimpleHTTPRequestHandler):
        def __init__(self, *args, **kwargs):
            super().__init__(*args, directory=str(serve_dir), **kwargs)

        def log_message(self, fmt: str, *args: Any) -> None:
            sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))

        def _send_bytes(self, body: bytes, content_type: str, code: int = 200) -> None:
            self.send_response(code)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-cache")
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self) -> None:  # noqa: N802
            nonlocal ages_cache
            parsed = urllib.parse.urlparse(self.path)
            path = parsed.path

            if html_bytes is not None and path in html_names:
                self._send_bytes(html_bytes, "text/html; charset=utf-8")
                return

            if path.rstrip("/") == "/__git-heat__/blame":
                qs = urllib.parse.parse_qs(parsed.query)
                rel = (qs.get("path") or [""])[0]
                rel = rel.lstrip("/")
                if not rel or ".." in rel.split("/"):
                    self.send_error(400, "bad path")
                    return
                repo_path = (scope_prefix + rel).replace("\\", "/")
                try:
                    if ages_cache is None:
                        ages_cache = commit_age_map(git_root)
                    blame = git_blame_lines(git_root, repo_path, ages_cache)
                except Exception as e:
                    self._send_bytes(
                        json.dumps({"error": str(e), "lines": []}).encode(),
                        "application/json",
                        code=500,
                    )
                    return
                self._send_bytes(
                    json.dumps(
                        {"path": rel, "repo_path": repo_path, "lines": blame}
                    ).encode(),
                    "application/json; charset=utf-8",
                )
                return

            return super().do_GET()

    return GitHeatHandler


def main() -> int:
    epilog = """\
examples:
  git-heat                              CLI ranking (cwd)
  git-heat --serve                      serve heatmap from memory (no file write)
  git-heat --html                       write git-heat.html only
  git-heat --html --serve               write file AND serve (same page)
  git-heat ~/src/arch/asf --serve       whole repository
  git-heat crates/codegen --serve       one subdirectory
  git-heat --half-life 3 --top 25 .     short memory, top paths
  git-heat --noise Cargo.toml,Cargo.lock  extra noise basenames

heat is scale-invariant: a path touched every commit forever → ~2 at any
half-life. Focus slider (HTML) moves half-life from long/historical (left)
to short/recent (right). --serve holds HTML in memory; use --html only when
you want a file on disk.

home: ~/src/arch/firmatum/utils/git-heat/git-heat-decay/
"""
    p = argparse.ArgumentParser(
        prog="git-heat",
        description=(
            "Commit-decay heatmap for a git repo or subdirectory — CLI ranking "
            "or interactive HTML tree with syntax-highlighted file viewer."
        ),
        epilog=epilog,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument(
        "path",
        nargs="?",
        default=".",
        help="git repo root or any subdirectory (default: cwd)",
    )
    p.add_argument(
        "--half-life",
        type=float,
        default=float(DEFAULT_HALF_LIFE),
        metavar="COMMITS",
        help=(
            f"default half-life in commits for CLI / initial HTML slider "
            f"(default: {DEFAULT_HALF_LIFE}; choices "
            f"{','.join(str(c) for c in reversed(HALF_LIFE_CHOICES))})"
        ),
    )
    p.add_argument(
        "--top",
        type=int,
        default=40,
        metavar="N",
        help="CLI: show top N paths (0 = all; default: 40)",
    )
    p.add_argument(
        "--min-heat",
        type=float,
        default=0.0,
        metavar="H",
        help="CLI: omit paths with heat below H (default: 0)",
    )
    p.add_argument(
        "--dirs",
        action="store_true",
        help="CLI: also list directories (max leaf heat)",
    )
    p.add_argument(
        "--noise",
        metavar="NAMES",
        default="",
        help=(
            "comma-separated extra basenames treated as noise (heat 0, "
            f"ignored for dir max). defaults already include: "
            f"{', '.join(sorted(DEFAULT_NOISE_BASENAMES))}"
        ),
    )
    p.add_argument(
        "--html",
        nargs="?",
        const="git-heat.html",
        default=None,
        metavar="FILE",
        help=(
            "write interactive HTML heatmap to disk (default name: git-heat.html "
            "in the target directory). not required for --serve"
        ),
    )
    p.add_argument(
        "--serve",
        type=int,
        nargs="?",
        const=8765,
        default=None,
        metavar="PORT",
        help=(
            "serve heatmap from memory over HTTP (default port: 8765); opens a "
            "browser. does not write a file unless --html is also given. "
            "source files are still read from the target directory"
        ),
    )
    p.add_argument(
        "--open",
        action="store_true",
        help="with --html (and not --serve): open the written HTML file in the browser",
    )
    p.add_argument(
        "-V",
        "--version",
        action="version",
        version="git-heat 1.0.0",
    )
    args = p.parse_args()

    # optional extra noise basenames for this run
    noise = set(DEFAULT_NOISE_BASENAMES)
    if args.noise.strip():
        noise |= {n.strip() for n in args.noise.split(",") if n.strip()}
    set_noise_basenames(noise)

    try:
        git_root, scope_dir, scope_prefix = resolve_target(Path(args.path))
    except (FileNotFoundError, RuntimeError) as e:
        print(f"git-heat: {e}", file=sys.stderr)
        return 2

    now = time.time()
    commits = git_commit_touch_log(git_root)
    if not commits:
        print("git-heat: no commits with file touches found", file=sys.stderr)
        return 1

    ages_by_path, mtime_by_path, n_commits, n_touches = leaf_touch_data(commits)
    ages_by_path, mtime_by_path = filter_scope(
        ages_by_path, mtime_by_path, scope_prefix
    )
    if not ages_by_path:
        where = scope_prefix or "(repo root)"
        print(
            f"git-heat: no paths under scope {where} in {git_root}",
            file=sys.stderr,
        )
        return 1

    heat_by_path = compute_leaf_heat(ages_by_path, args.half_life)
    n_files = len(ages_by_path)
    # display label: root name + optional scope
    label = git_root.name if not scope_prefix else f"{git_root.name}/{scope_prefix.rstrip('/')}"

    want_html = args.html is not None or args.serve is not None
    if want_html:
        tree = build_tree(ages_by_path, mtime_by_path, heat_by_path)
        html_doc = render_html(
            tree,
            repo=scope_dir,
            half_life=args.half_life,
            now=now,
            n_touches=n_touches,
            n_files=n_files,
            n_commits=n_commits,
            label=label,
            git_root=git_root,
            scope_prefix=scope_prefix,
        )

        out: Path | None = None
        if args.html is not None:
            out = Path(args.html)
            if not out.is_absolute():
                out = scope_dir / out
            out.write_text(html_doc, encoding="utf-8")
            print(f"wrote {out}", file=sys.stderr)

        if args.serve is not None:
            import socketserver
            import webbrowser

            serve_dir = scope_dir.resolve()
            port = int(args.serve)
            # Prefer a clean URL; in-memory page is always available at / and
            # /git-heat.html regardless of whether --html also wrote a file.
            handler_cls = make_git_heat_handler(
                serve_dir,
                git_root,
                scope_prefix,
                html_doc=html_doc,
                html_route="git-heat.html",
            )
            socketserver.TCPServer.allow_reuse_address = True
            with socketserver.TCPServer(("127.0.0.1", port), handler_cls) as httpd:
                url = f"http://127.0.0.1:{port}/"
                print(
                    f"serving heatmap from memory · sources from {serve_dir}\n"
                    f"  git root {git_root}"
                    f"{', scope ' + scope_prefix.rstrip('/') if scope_prefix else ''}\n"
                    f"  blame API /__git-heat__/blame"
                    + (f"\n  also wrote {out}" if out is not None else "\n  (no HTML file written)"),
                    file=sys.stderr,
                )
                print(url)
                try:
                    webbrowser.open(url)
                except Exception:
                    pass
                try:
                    httpd.serve_forever()
                except KeyboardInterrupt:
                    print("\nstopped", file=sys.stderr)
            return 0

        if args.open and out is not None:
            import webbrowser
            webbrowser.open(out.as_uri())

        if out is not None:
            print(
                f"# wrote HTML only — for interactive viewer without a file:\n"
                f"#   git-heat {args.path} --serve\n"
                f"# or serve the written file from its directory",
                file=sys.stderr,
            )
            print(out)
        return 0

    heat = dict(heat_by_path)
    mtime = dict(mtime_by_path)
    if args.dirs:
        dir_heat: dict[str, float] = defaultdict(float)
        dir_mt: dict[str, float] = defaultdict(float)
        for path, h in heat_by_path.items():
            if is_noise_path(path):
                continue
            mt = mtime_by_path.get(path, 0.0)
            parts = Path(path).parts
            for i in range(1, len(parts)):
                d = "/".join(parts[:i]) + "/"
                if h > dir_heat[d]:
                    dir_heat[d] = h
                if mt > dir_mt[d]:
                    dir_mt[d] = mt
        for d, h in dir_heat.items():
            heat[d] = h
            mtime[d] = dir_mt[d]

    ranked = sorted(
        ((path, h) for path, h in heat.items() if h >= args.min_heat),
        key=lambda x: (-x[1], x[0]),
    )
    if args.top > 0:
        ranked = ranked[: args.top]

    tau = args.half_life / math.log(2)
    print(
        f"# git-heat  {label}\n"
        f"# git_root={git_root}"
        f"{'  scope=' + scope_prefix.rstrip('/') if scope_prefix else ''}\n"
        f"# half-life={args.half_life:g} commits  tau={tau:.3f}  "
        f"now={time.strftime('%Y-%m-%d %H:%M:%S %z', time.localtime(now))}\n"
        f"# commits={n_commits}  paths={n_files}  "
        f"non-initial touches (whole repo)={n_touches}\n"
        f"# heat = 2*(1-e^(-1/tau))*sum exp(-age/tau); dir=max non-noise leaf\n"
        f"# {'HEAT':>10}  PATH"
    )
    for path, h in ranked:
        print(f"{h:10.4f}  {path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
