    half_life: float,
    now: float,
    n_touches: int,
    n_files: int,
    n_commits: int,
    label: str | None = None,
    git_root: Path | None = None,
    scope_prefix: str = "",
) -> str:
    data = tree_to_jsonable(tree, now)
    heat_max = max(float(data["heat"]), 0.0)
    # pick nearest slider position for default
    choices = list(HALF_LIFE_CHOICES)
    default_hl = min(choices, key=lambda c: abs(c - half_life))
    display = label or repo.name
    meta = {
        "repo": str(repo),
        "git_root": str(git_root or repo),
        "scope": scope_prefix.rstrip("/"),
        "label": display,
        "half_life": default_hl,
        "half_life_choices": choices,
        "unit": "commits",
        "now": time.strftime("%Y-%m-%d %H:%M:%S %z", time.localtime(now)),
        "n_touches": n_touches,
        "n_files": n_files,
        "n_commits": n_commits,
        "heat_max": heat_max,
        "zero_bg": ZERO_HEAT_BG,
        "note": "initial commit excluded; heat 0 → #222; noise basenames ignored for dir max",
    }
    palette_js = json.dumps(HEAT_PALETTE_RGB)
    payload = json.dumps({"meta": meta, "tree": data}, ensure_ascii=False)
    payload = payload.replace("<", "\\u003c")

    legend_stops = ",".join(
        f"rgb({r},{g},{b})" for r, g, b in reversed(HEAT_PALETTE_RGB)
    )
    default_idx = choices.index(default_hl)

    return f"""<!DOCTYPE html>
