          <span class="hl-value" id="hl-value"></span>
        </div>
        <div class="hl-track">
          <input type="range" id="hl-slider" min="0" max="{len(choices) - 1}"
                 step="1" value="{default_idx}"
                 aria-label="history left, recent right (half-life in commits)"/>
          <div id="hl-ends">
            <span>← history (smoother)</span>
