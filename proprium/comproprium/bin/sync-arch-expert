#!/bin/sh
# Rebuild ~/.grok/agents/arch-expert.md from stopgap-system-prompt.md.
# Frontmatter is local to the Grok agent file; the body is the stopgap, verbatim.
set -e

SRC="${GROK_ARCH_EXPERT_SRC:-$HOME/src/arch/proprium/comproprium/stopgap-system-prompt.md}"
DEST="${GROK_ARCH_EXPERT_DEST:-$HOME/.grok/agents/arch-expert.md}"

if [ ! -f "$SRC" ]; then
  echo "sync-arch-expert: missing source: $SRC" >&2
  exit 1
fi

mkdir -p "$(dirname "$DEST")"
tmp=$(mktemp "${DEST}.XXXXXX")
trap 'rm -f "$tmp"' EXIT

{
  printf '%s\n' \
    '---' \
    'name: arch-expert' \
    'description: Specialized collaboration agent' \
    'promptMode: extend' \
    '---' \
    ''
  cat "$SRC"
} >"$tmp"

if [ -f "$DEST" ] && cmp -s "$tmp" "$DEST"; then
  exit 0
fi

mv -f "$tmp" "$DEST"
trap - EXIT
